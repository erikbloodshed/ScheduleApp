<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The Windows target ScheduleApp.Desktop builds for, so the ViewModels it compiles
         (and the WPF and ReactiveUI types they use) can be referenced here. -->
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ScheduleApp.Desktop.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScheduleApp.Desktop\ScheduleApp.Desktop.csproj" />
  </ItemGroup>

</Project>
