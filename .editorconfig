root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space

[*.cs]
indent_size = 4

# File-scoped namespaces, not block-scoped - already the convention everywhere in this repo.
csharp_style_namespace_declarations = file_scoped:suggestion

# Primary constructors for simple field-assignment constructors - already the convention
# for most services/repositories in this repo (see ScheduleApp.Data/Repositories,
# ScheduleApp.Desktop/Services).
csharp_style_prefer_primary_constructors = true:suggestion

# Collection expressions ([]/[a, b]) over new[]/new List<T> { ... } - already the
# convention in most of this repo.
csharp_style_prefer_collection_expression = when_types_loosely_match:suggestion

# `using var x = ...;` over `using (var x = ...) { }` where the block runs to the end
# of its enclosing scope.
csharp_prefer_simple_using_statement = true:suggestion

# Pattern matching / null-check idioms already used throughout this repo
# (`is not null`, `is { } x`, property patterns) over old-style `== null`/`as` + check.
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion

[*.{xaml,xml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ---------------------------------------------------------------------------
# Analyzer suppressions (EnableNETAnalyzers / AnalysisLevel=latest-recommended,
# see Directory.Build.props). Everything below is a rule that is wrong for this
# codebase rather than a warning worth fixing -- see each note.
# ---------------------------------------------------------------------------

[*.cs]
# CA1716: "rename parameter 'date'/'end', it conflicts with a reserved language
# keyword" -- the keyword in question is Visual Basic's. This solution is C#
# only and ships no public API surface, so the rule protects nobody while
# `date`/`end` are the clearest names for what those parameters are.
dotnet_diagnostic.CA1716.severity = none
# CA1822 only for non-public members. Every public hit is a method on a
# DI-registered singleton (DatabaseBackupService, RememberedSignInStore,
# SharedConfigWriter, ViewStateStore, ...) that happens to hold no state today, or
# a XAML-bound property (EmployeeNodeViewModel.HasPin). Making those static would
# be a source-breaking change that dissolves a deliberate injection seam, or break
# a binding outright. Private/internal helpers have no such excuse, so keep the
# rule on for them.
dotnet_code_quality.CA1822.api_surface = private, internal

# Test method names follow the xUnit Method_Scenario_Expectation convention,
# which CA1707 (no underscores in member names) flags on every single test.
[ScheduleApp.{Attendance,Payroll}.Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none

# EF Core scaffolds these; they are never hand-edited, so CA1861's advice to
# hoist constant array arguments into static readonly fields is unactionable.
[ScheduleApp.Data/Migrations/**.cs]
dotnet_diagnostic.CA1861.severity = none
