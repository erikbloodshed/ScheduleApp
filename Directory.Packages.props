<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Every Syncfusion package must be on the same version: upgrade them together.
         Syncfusion doesn't support mixing versions across its assemblies, and the theme
         package rejects a mismatched SfSkinManager/Licensing as a downgrade (NU1605). -->
    <SyncfusionVersion>35.1.39</SyncfusionVersion>
  </PropertyGroup>
  <ItemGroup Label="Syncfusion">
    <!-- ScheduleApp.Desktop -->
    <PackageVersion Include="Syncfusion.DataGridExcelExport.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Licensing" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfGrid.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfInput.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfNavigationDrawer.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfSkinManager.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfTextInputLayout.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.SfTreeView.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Themes.Windows11Light.WPF" Version="$(SyncfusionVersion)" />
    <PackageVersion Include="Syncfusion.Tools.WPF" Version="$(SyncfusionVersion)" />
  </ItemGroup>
  <ItemGroup>
    <!-- ScheduleApp.Desktop: ReactiveUI MVVM (replacing CommunityToolkit.Mvvm screen by screen) -->
    <PackageVersion Include="DynamicData" Version="9.4.33" />
    <PackageVersion Include="ReactiveUI.WPF" Version="26.0.1" />
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <!-- ScheduleApp.Data: reads through Dapper, writes through EF Core -->
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <!-- ScheduleApp.Data.Tests: resets the SQL Server test database before each test -->
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <!-- EF Core - ScheduleApp.Data, ScheduleApp.Desktop, ScheduleApp.PushListener -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <!-- ScheduleApp.Data -->
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <!-- ScheduleApp.Desktop -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <!-- ScheduleApp.Excel -->
    <PackageVersion Include="EPPlus" Version="8.7.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    <!-- ScheduleApp.Payroll.Pdf -->
    <PackageVersion Include="QuestPDF" Version="2026.8.0" />
    <PackageVersion Include="SkiaSharp" Version="4.152.0" />
    <!-- ScheduleApp.PushListener -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.EventLog" Version="4.0.0" />
    <!-- ScheduleApp.Attendance.Tests, ScheduleApp.Payroll.Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>