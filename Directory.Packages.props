<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- EF Core - ScheduleApp.Data, ScheduleApp.Desktop, ScheduleApp.PushListener -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <!-- ScheduleApp.Data -->
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <!-- ScheduleApp.Desktop -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
    <!-- ScheduleApp.Excel -->
    <PackageVersion Include="EPPlus" Version="8.7.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    <!-- ScheduleApp.Payroll.Pdf -->
    <PackageVersion Include="QuestPDF" Version="2026.8.0" />
    <PackageVersion Include="SkiaSharp" Version="4.152.0" />
    <!-- ScheduleApp.PushListener -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.EventLog" Version="4.0.0" />
    <!-- ScheduleApp.Attendance.Tests, ScheduleApp.Payroll.Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>