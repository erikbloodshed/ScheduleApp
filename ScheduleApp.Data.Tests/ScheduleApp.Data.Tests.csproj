<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ScheduleApp.Data.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Test project, not something anyone else references, same shape as
         ScheduleApp.Attendance.Tests/ScheduleApp.Payroll.Tests. Exercises the repositories
         against a real SQL Server Express database of its own (ScheduleAppDb_Test_Data, see
         Fixtures/DatabaseFixture.cs), migrated once per run and reset between tests with
         Respawn, so the unique indexes, the Employee.Pin alternate-key FK and the
         case-insensitive collation the repositories rely on are all the real thing. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Bump these if they don't resolve against your local NuGet feed,
         same caveat ScheduleApp.Payroll.Tests' own .csproj gives. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScheduleApp.Data\ScheduleApp.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The server the test database lives on; DatabaseFixture swaps in its own database name. -->
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
