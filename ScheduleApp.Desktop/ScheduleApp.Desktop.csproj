<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ScheduleApp.Desktop</RootNamespace>
    <AssemblyName>ScheduleApp</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <!-- Needed for configuration.GetSection("Attendance").Get&lt;AttendanceSettings&gt;() in App.xaml.cs -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="ReactiveUI.WPF" />
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Syncfusion.DataGridExcelExport.WPF" />
    <PackageReference Include="Syncfusion.Licensing" />
    <PackageReference Include="Syncfusion.SfGrid.WPF" />
    <PackageReference Include="Syncfusion.SfInput.WPF" />
    <PackageReference Include="Syncfusion.SfNavigationDrawer.WPF" />
    <PackageReference Include="Syncfusion.SfSkinManager.WPF" />
    <PackageReference Include="Syncfusion.SfTextInputLayout.WPF" />
    <PackageReference Include="Syncfusion.SfTreeView.WPF" />
    <PackageReference Include="Syncfusion.Themes.Windows11Light.WPF" />
    <PackageReference Include="Syncfusion.Tools.WPF" />
    <!-- DPAPI (ProtectedData.Protect/Unprotect) for RememberedSignInStore's encrypted
         password on disk - not part of the shared framework, needs this package even
         on a Windows-only TFM like net10.0-windows. Bump the version if it doesn't
         resolve against your local NuGet feed. -->
  </ItemGroup>

<ItemGroup>
    <ProjectReference Include="..\ScheduleApp.Core\ScheduleApp.Core.csproj" />
    <ProjectReference Include="..\ScheduleApp.Data\ScheduleApp.Data.csproj" />
    <ProjectReference Include="..\ScheduleApp.Excel\ScheduleApp.Excel.csproj" />
<ProjectReference Include="..\ScheduleApp.Attendance\ScheduleApp.Attendance.csproj" />
    <ProjectReference Include="..\ScheduleApp.Payroll\ScheduleApp.Payroll.csproj" />
    <ProjectReference Include="..\ScheduleApp.Payroll.Pdf\ScheduleApp.Payroll.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Build action "Resource" (not "Content"/CopyToOutputDirectory) embeds this
       straight into the assembly, so it's always available via the "/Assets/..."
       pack URI in SignInPanel.xaml/SetupAdminPanel.xaml regardless of working
       directory - no separate file to remember to ship alongside the .exe. -->
  <ItemGroup>
    <Resource Include="Assets\Tinapayan_Logo.png" />
  </ItemGroup>

</Project>
