<controls:ReactiveAppWindow x:Class="ScheduleApp.Desktop.MainWindow"
        x:TypeArguments="vm:ShellViewModel"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:skinManager="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        xmlns:sfTheme="clr-namespace:Syncfusion.Themes.Windows11Light.WPF;assembly=Syncfusion.Themes.Windows11Light.WPF"
        xmlns:collections="clr-namespace:System.Collections;assembly=System.Runtime"
        xmlns:views="clr-namespace:ScheduleApp.Desktop.Views"
        xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
        xmlns:utilities="clr-namespace:ScheduleApp.Desktop.Utilities"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TitleBarHeight="32"
        TitleBarBackground="{StaticResource CardBackgroundBrush}"
        TitleBarForeground="{StaticResource HeadingForegroundBrush}"
        utilities:WindowSizing.ConstrainToWorkArea="True">
    <Window.Resources>
        <!-- A drawer item's glyph -->
        <Style x:Key="NavIconStyle" TargetType="TextBlock" BasedOn="{StaticResource IconGlyphStyle}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!--
        The pin for the navigation drawer, on the title bar's left, just above the drawer's own
        toggle. Unpinned (the default), the drawer is Compact: an icon rail that the toggle expands
        over the page, and that folds back once a page is picked. Pinned, it's Expanded: the full,
        labelled menu, always open beside the page. MainWindow.xaml.cs switches DisplayMode;
        ShellViewModel remembers the choice.

        Styled like the title bar's own Minimize and Maximize: the theme's WPFGlyphButtonStyle,
        fetched by ThemeKey as a DynamicResource (the theme only reaches this window when it loads).
        Unlike TinapayanRMS, without their square WPFGlyphWindowButtonTemplate: that template is only
        a plain key in the theme's window dictionary, which SfSkinManager doesn't merge into a window
        when it themes the whole application (App.xaml.cs), so the lookup finds nothing and the
        button draws nothing at all. IsHitTestVisibleInChrome, as the caption buttons set: without it
        the caption area takes the mouse.
    -->
    <controls:AppWindow.LeftHeaderItemsSource>
        <collections:ArrayList>
            <Button x:Name="PinPaneButton"
                    Width="40"
                    Height="32"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    Style="{DynamicResource {skinManager:ThemeKey Key=WPFGlyphButtonStyle, Theme={x:Type sfTheme:Windows11LightSkinHelper}}}"
                    ToolTip="Pin the navigation pane open"
                    AutomationProperties.Name="Pin navigation pane">
                <TextBlock x:Name="PinPaneGlyph" Style="{StaticResource IconGlyphStyle}" />
            </Button>
        </collections:ArrayList>
    </controls:AppWindow.LeftHeaderItemsSource>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            A page item's Tag is the page it opens, resolved from DI by MainWindow.NavigateTo
            (the same Scoped instances App.xaml.cs registers, so a page keeps what it loaded).
            Attendance has no page of its own: its three pages are its sub-items, which the drawer
            shows inline when expanded and as a popup off the rail when compact - what the old
            hand-rolled AttendanceFlyout did under WPF-UI.

            Every item names itself for UI Automation: its icon is a glyph TextBlock, so without
            AutomationProperties.Name a sub-item (which has no icon) can't be found at all.

            The footer items open dialogs rather than pages, so they're ItemType="Button": they
            never take the selection away from the page on screen. Their Tag names the dialog
            (ShellViewModel's Open... commands). Settings stays last, at the bottom of the drawer.
        -->
        <syncfusion:SfNavigationDrawer x:Name="NavigationDrawer"
                                       DisplayMode="Compact"
                                       CompactModeWidth="44"
                                       ExpandedModeWidth="170"
                                       DrawerBackground="{StaticResource CardBackgroundBrush}"
                                       ItemClicked="NavigationDrawer_ItemClicked">
            <syncfusion:NavigationItem x:Name="EmployeesNavItem" Header="Employees" AutomationProperties.Name="Employees" Tag="{x:Type views:EmployeesPage}">
                <syncfusion:NavigationItem.Icon>
                    <TextBlock Text="&#xE716;" Style="{StaticResource NavIconStyle}" />
                </syncfusion:NavigationItem.Icon>
            </syncfusion:NavigationItem>
            <syncfusion:NavigationItem x:Name="ScheduleNavItem" Header="Schedule" AutomationProperties.Name="Schedule" Tag="{x:Type views:SchedulePage}">
                <syncfusion:NavigationItem.Icon>
                    <TextBlock Text="&#xE787;" Style="{StaticResource NavIconStyle}" />
                </syncfusion:NavigationItem.Icon>
            </syncfusion:NavigationItem>
            <syncfusion:NavigationItem x:Name="AttendanceNavItem" Header="Attendance" AutomationProperties.Name="Attendance">
                <syncfusion:NavigationItem.Icon>
                    <TextBlock Text="&#xE9D5;" Style="{StaticResource NavIconStyle}" />
                </syncfusion:NavigationItem.Icon>
                <syncfusion:NavigationItem Header="Summary" AutomationProperties.Name="Summary" Tag="{x:Type views:AttendanceSummaryPage}" />
                <syncfusion:NavigationItem Header="Punch Records" AutomationProperties.Name="Punch Records" Tag="{x:Type views:PunchRecordsPage}" />
                <syncfusion:NavigationItem Header="Manual Entries" AutomationProperties.Name="Manual Entries" Tag="{x:Type views:ManualEntriesPage}" />
            </syncfusion:NavigationItem>
            <syncfusion:NavigationItem x:Name="PayrollNavItem" Header="Payroll" AutomationProperties.Name="Payroll" Tag="{x:Type views:PayrollPage}">
                <syncfusion:NavigationItem.Icon>
                    <TextBlock Text="&#xE8C7;" Style="{StaticResource NavIconStyle}" />
                </syncfusion:NavigationItem.Icon>
            </syncfusion:NavigationItem>
            <syncfusion:NavigationItem x:Name="PushListenerNavItem" Header="Push Listener" AutomationProperties.Name="Push Listener" Tag="{x:Type views:PushListenerPage}">
                <syncfusion:NavigationItem.Icon>
                    <TextBlock Text="&#xE753;" Style="{StaticResource NavIconStyle}" />
                </syncfusion:NavigationItem.Icon>
            </syncfusion:NavigationItem>

            <syncfusion:SfNavigationDrawer.FooterItems>
                <!-- ManageHolidaysDialog: the company holiday list Premium Pay (see the Payroll page) computes against -->
                <syncfusion:NavigationItem Header="Manage Holidays" AutomationProperties.Name="Manage Holidays" ItemType="Button" Tag="Holidays" ToolTip="Manage Holidays">
                    <syncfusion:NavigationItem.Icon>
                        <TextBlock Text="&#xE8BF;" Style="{StaticResource NavIconStyle}" />
                    </syncfusion:NavigationItem.Icon>
                </syncfusion:NavigationItem>
                <!-- ManageUsersDialog: the only place sign-in accounts are added after the very first one -->
                <syncfusion:NavigationItem Header="Manage Users" AutomationProperties.Name="Manage Users" ItemType="Button" Tag="Users" ToolTip="Manage Users">
                    <syncfusion:NavigationItem.Icon>
                        <TextBlock Text="&#xE779;" Style="{StaticResource NavIconStyle}" />
                    </syncfusion:NavigationItem.Icon>
                </syncfusion:NavigationItem>
                <syncfusion:NavigationItem Header="Backup / Restore" AutomationProperties.Name="Backup / Restore" ItemType="Button" Tag="Backup" ToolTip="Backup / Restore Database">
                    <syncfusion:NavigationItem.Icon>
                        <TextBlock Text="&#xE7B8;" Style="{StaticResource NavIconStyle}" />
                    </syncfusion:NavigationItem.Icon>
                </syncfusion:NavigationItem>
                <syncfusion:NavigationItem Header="Settings" AutomationProperties.Name="Settings" ItemType="Button" Tag="Settings"
                                           ToolTip="Settings - shared connection string and attendance device defaults">
                    <syncfusion:NavigationItem.Icon>
                        <TextBlock Text="&#xE713;" Style="{StaticResource NavIconStyle}" />
                    </syncfusion:NavigationItem.Icon>
                </syncfusion:NavigationItem>
            </syncfusion:SfNavigationDrawer.FooterItems>

            <syncfusion:SfNavigationDrawer.ContentView>
                <!-- A Frame because a Page can only be hosted by a Window or a Frame. No
                     back/forward: the app never had page history, so ContentFrame_Navigated
                     clears the journal after each navigation. -->
                <Frame x:Name="ContentFrame"
                       NavigationUIVisibility="Hidden"
                       JournalOwnership="OwnsJournal"
                       Focusable="False"
                       Navigated="ContentFrame_Navigated" />
            </syncfusion:SfNavigationDrawer.ContentView>
        </syncfusion:SfNavigationDrawer>

        <!-- Status bar along the bottom of the window, notification text
             right-aligned within it - set from MainWindow's constructor via
             IStatusBarService.SetStatusBarPresenter. Its own row (below the
             drawer) rather than overlaid, so it never covers content. -->
        <controls:StatusBarPresenter x:Name="RootStatusBarPresenter" Grid.Row="1" />

        <!-- Sign-in gate, drawn last so it's on top of everything above: the window shows
             straight away, with the sign-in (or first account's) card over it until someone
             signs in. Grid.RowSpan="2" covers the status bar too, so it's a full-window page
             rather than a card over a dimmed scrim - its solid Background keeps everything
             behind it hidden and unclickable. The pin is hidden with it. -->
        <Grid x:Name="AuthOverlay" Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource PageBackgroundBrush}">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <views:SignInPanel x:Name="SignInPanelControl" />
                <views:SetupAdminPanel x:Name="SetupAdminPanelControl" />
            </Grid>
        </Grid>
    </Grid>
</controls:ReactiveAppWindow>
