<controls:AppWindow x:Class="ScheduleApp.Desktop.Views.PayrollWizardDialog" ShowMinimizeButton="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
        xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels"
        xmlns:converters="clr-namespace:ScheduleApp.Desktop.Converters"
        xmlns:utilities="clr-namespace:ScheduleApp.Desktop.Utilities"
        Title="New Payroll Run"
        Width="700" Height="600"
        MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        utilities:WindowSizing.ConstrainToWorkArea="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <converters:NumberConverter x:Key="Number" />

        <!-- Step 1's Period dates: the full "MMMM d, yyyy" month name (e.g. "September 16,
             2026"), matching AttendanceSummaryView/PayrollPage's own Period fields. -->
        <Style x:Key="PeriodDate" TargetType="syncfusion:DateTimeEdit">
            <Setter Property="Pattern" Value="CustomPattern" />
            <Setter Property="CustomPattern" Value="MMMM d, yyyy" />
            <Setter Property="IsEmptyDateEnabled" Value="True" />
            <Setter Property="NullValue" Value="{x:Null}" />
            <Setter Property="ShowMaskOnNullValue" Value="False" />
            <Setter Property="Width" Value="190" />
        </Style>

        <!-- Right-aligned numeric grid header, same shape as AttendanceStatusDetailDialog/
             EmployeeAttendancePanel/AttendanceSummaryView's own copies - see those files for
             why it's duplicated per-file rather than shared. Used by Step 3's review grid
             below, whose cells right-align through each column's TextAlignment. -->
        <Style x:Key="RightAlignedHeader"
               TargetType="syncfusion:GridHeaderCellControl"
               BasedOn="{StaticResource GridHeaderCellStyle}">
            <Setter Property="HorizontalContentAlignment"
                    Value="Right" />
        </Style>

        <!-- Step-indicator label styling: gray/normal by default, dark/bold while its own
             step is current (see PayrollWizardViewModel.IsStep1Active/IsStep2Active/
             IsStep3Active). Three near-identical styles rather than one parameterized one -
             each needs a DataTrigger bound to a different property, and a WPF Style can't
             take a binding path as a parameter. Each is BasedOn StepLabelStyle, not on
             Step1LabelStyle: a BasedOn style inherits its base's triggers, so steps 2 and 3
             would also turn bold whenever step 1 was current. -->
        <Style x:Key="StepLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource MutedForegroundBrush}" />
        </Style>
        <Style x:Key="Step1LabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource StepLabelStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStep1Active}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextForegroundBrush}" />
                    <Setter Property="FontWeight"
                            Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Step2LabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource StepLabelStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStep2Active}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextForegroundBrush}" />
                    <Setter Property="FontWeight"
                            Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Step3LabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource StepLabelStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStep3Active}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextForegroundBrush}" />
                    <Setter Property="FontWeight"
                            Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

    <Grid Grid.Row="1" Margin="16"
          RowDefinitions="Auto,Auto,*,Auto">

        <!-- Step indicator -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12">
            <TextBlock Text="1. Period &amp; Label"
                       Style="{StaticResource Step1LabelStyle}" />
            <TextBlock Text="  —  "
                       Foreground="{DynamicResource CardBorderBrush}" />
            <TextBlock Text="2. Employees"
                       Style="{StaticResource Step2LabelStyle}" />
            <TextBlock Text="  —  "
                       Foreground="{DynamicResource CardBorderBrush}" />
            <TextBlock Text="3. Calculate &amp; Review"
                       Style="{StaticResource Step3LabelStyle}" />
        </StackPanel>

        <Separator Grid.Row="1"
                   Margin="0,0,0,16" />

        <!-- Step content - three panels layered in the same cell, only the current step's
             own Visibility is Visible (see IsStep1Visible/IsStep2Visible/IsStep3Visible).
             Chosen over a TabControl so there's no tab strip of its own to keep in sync
             with the step-indicator row above. -->
        <Grid Grid.Row="2">
            <!-- Step 1: Period + Label (build-order step 6) -->
            <StackPanel Visibility="{Binding IsStep1Visible, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Period"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,16">
                    <syncfusion:DateTimeEdit Style="{StaticResource PeriodDate}"
                                             DateTime="{Binding PeriodStart, Mode=TwoWay}"
                                             Margin="0,0,8,0" />
                    <TextBlock Text="to"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <syncfusion:DateTimeEdit Style="{StaticResource PeriodDate}"
                                             DateTime="{Binding PeriodEnd, Mode=TwoWay}" />
                </StackPanel>

                <TextBlock Text="Label"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <syncfusion:SfTextBoxExt Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Shown later in &quot;Load Payroll Group…&quot; -- auto-filled, but editable." />

                <TextBlock Text="{Binding PeriodValidationMessage}"
                           Visibility="{Binding PeriodValidationMessage, Converter={StaticResource NotNullToVisibility}}"
                           Foreground="#B91C1C"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
            </StackPanel>

            <!-- Step 2: Employees (build-order step 7) - same department/employee
                 checkbox tree PayslipScopeDialog.xaml uses, reusing the same
                 DepartmentGroupViewModel/EmployeeNodeViewModel shapes (see
                 PayrollWizardViewModel.Departments' own doc comment). SfTreeView can't hide
                 a row, so it binds to the search's VisibleDepartments and each department's
                 VisibleEmployees rather than to Departments/Employees. -->
            <Grid Visibility="{Binding IsStep2Visible, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,8">
                    <TextBlock Text="Search"
                               FontSize="11"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="0,0,0,4" />
                    <syncfusion:SfTextBoxExt Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="ID, name or department"
                                             ToolTip="Comma-separated ID, name, or department terms (e.g. &quot;342, Cruz, Kitchen&quot;) -- narrows what's shown, not what's checked." />
                </StackPanel>

                <Border Grid.Row="1"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardBorderBrush}">
                    <syncfusion:SfTreeView ItemsSource="{Binding VisibleDepartments}"
                                           SelectionMode="None"
                                           ExpandActionTrigger="Node"
                                           FocusVisualStyle="{x:Null}">
                        <syncfusion:SfTreeView.Resources>
                            <DataTemplate DataType="{x:Type vm:DepartmentGroupViewModel}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              IsThreeState="False"
                                              VerticalAlignment="Center"
                                              ToolTip="Include/exclude every employee in this department"
                                              Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:EmployeeNodeViewModel}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding Employee.DisplayName}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPin}"
                                                                 Value="False">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource TertiaryForegroundBrush}" />
                                                        <Setter Property="ToolTip"
                                                                Value="No Employee ID (Pin) set for this person -- payroll can't be computed until one is. Set it in the Add/Edit Employee dialog on the Schedule tab." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Optional per the Phase 4 plan (row 9) - same Monthly
                                         badge as AddToPayrollGroupDialog's tree, same reasoning. -->
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="4,1"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsMonthly, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Monthly"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </syncfusion:SfTreeView.Resources>
                        <syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                            <syncfusion:HierarchyPropertyDescriptor TargetType="{x:Type vm:DepartmentGroupViewModel}"
                                                                    ChildPropertyName="VisibleEmployees"
                                                                    IsExpandedPropertyName="IsExpanded" />
                        </syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                        <syncfusion:SfTreeView.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}" Focusable="False" VerticalAlignment="Center" />
                            </DataTemplate>
                        </syncfusion:SfTreeView.ItemTemplate>
                    </syncfusion:SfTreeView>
                </Border>

                <StackPanel Grid.Row="2"
                            Margin="0,8,0,0">
                    <TextBlock Text="{Binding SelectionScopeText}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <syncfusion:ButtonAdv Label="Select All"
                                              IconTemplate="{StaticResource SelectAllIconTemplate}"
                                              SizeMode="Normal"
                                              Command="{Binding SelectAllTreeCommand}"
                                              Margin="0,0,6,0" />
                        <syncfusion:ButtonAdv Label="Clear"
                                              IconTemplate="{StaticResource ClearSelectionIconTemplate}"
                                              SizeMode="Normal"
                                              Command="{Binding ClearTreeSelectionCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Step 3: Calculate & Review (build-order step 8) - CalculateReviewAsync
                 (fired from PayrollWizardViewModel.NextAsync the moment this step is
                 reached) fills ReviewResults straight off IPayrollComputationService,
                 looped once per Step 2 employee, same as PayrollPrintExportViewModel.
                 PrintPayslipsAsync/ExportPayrollReportAsync already loop it. "Save Payroll
                 Group" below still writes straight off Step 2's own checked employees
                 rather than off this grid - see SavePayrollGroupAsync's own doc comment
                 for why the two stay independent. -->
            <Grid Visibility="{Binding IsStep3Visible, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Calculate &amp; Review"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Margin="0,0,0,8" />

                <!-- Calculating pulse / error / grid+totals - mutually exclusive, see
                     PayrollWizardViewModel.IsReviewReady's own doc comment. -->
                <Grid Grid.Row="1">
                    <TextBlock Text="Calculating payroll for the checked employees…"
                               Visibility="{Binding IsCalculating, Converter={StaticResource BoolToVisibility}}"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <TextBlock Text="{Binding CalculationErrorMessage}"
                               Visibility="{Binding CalculationErrorMessage, Converter={StaticResource NotNullToVisibility}}"
                               Foreground="#B91C1C"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="380"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <DockPanel Visibility="{Binding IsReviewReady, Converter={StaticResource BoolToVisibility}}">
                        <!-- Totals strip - same four columns as the grid below, right-aligned
                             under the matching Gross Pay/Deductions/Net Pay cells so the
                             column totals line up under what they're summing. -->
                        <Border DockPanel.Dock="Bottom"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1,0,1,1"
                                Padding="8,6">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="Total"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding TotalNetPay, Converter={StaticResource Number}}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Right"
                                           Width="110"
                                           VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding TotalDeductions, Converter={StaticResource Number}}"
                                           TextAlignment="Right"
                                           Width="110"
                                           VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding TotalGrossPay, Converter={StaticResource Number}}"
                                           TextAlignment="Right"
                                           Width="110"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <syncfusion:SfDataGrid ItemsSource="{Binding ReviewResults}"
                                               AutoGenerateColumns="False"
                                               AllowEditing="False"
                                               AllowDraggingColumns="False"
                                               AllowResizingColumns="False"
                                               SelectionMode="Single"
                                               NavigationMode="Row"
                                               GridLinesVisibility="Horizontal"
                                               BorderThickness="1"
                                               BorderBrush="{DynamicResource CardBorderBrush}">
                            <syncfusion:SfDataGrid.Columns>
                                <syncfusion:GridTextColumn MappingName="EmployeeName" HeaderText="Employee" ColumnSizer="Star" />
                                <syncfusion:GridTextColumn MappingName="TotalGrossPay" HeaderText="Gross Pay" Width="110"
                                                           DisplayBinding="{Binding TotalGrossPay, Converter={StaticResource Number}}"
                                                           TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                                <syncfusion:GridTextColumn MappingName="TotalDeductions" HeaderText="Deductions" Width="110"
                                                           DisplayBinding="{Binding TotalDeductions, Converter={StaticResource Number}}"
                                                           TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                                <syncfusion:GridTextColumn MappingName="NetPay" HeaderText="Net Pay" Width="110"
                                                           DisplayBinding="{Binding NetPay, Converter={StaticResource Number}}"
                                                           TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                            </syncfusion:SfDataGrid.Columns>
                        </syncfusion:SfDataGrid>
                    </DockPanel>
                </Grid>

                <!-- Save Payroll Group + status (build-order step 8.3) -->
                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0">
                    <syncfusion:ButtonAdv Label="Save Payroll Group"
                                          IconTemplate="{StaticResource SaveIconTemplate}"
                                          SizeMode="Normal"
                                          Command="{Binding SavePayrollGroupCommand}"
                                          HorizontalAlignment="Center" />

                    <TextBlock Text="Saving…"
                               Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibility}}"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0" />

                    <TextBlock Text="{Binding SaveErrorMessage}"
                               Visibility="{Binding SaveErrorMessage, Converter={StaticResource NotNullToVisibility}}"
                               Foreground="#B91C1C"
                               TextWrapping="Wrap"
                               MaxWidth="380"
                               TextAlignment="Center"
                               Margin="0,10,0,0" />

                    <TextBlock Text="{Binding SavedRunSummary}"
                               Visibility="{Binding SavedRunSummary, Converter={StaticResource NotNullToVisibility}}"
                               Foreground="#15803D"
                               TextWrapping="Wrap"
                               MaxWidth="380"
                               TextAlignment="Center"
                               Margin="0,10,0,0" />

                    <TextBlock Text="Changes to the employee list on Step 2 from here on won't be included in this saved run -- click Finish to close, or Cancel and start a new run to save a different selection."
                               Visibility="{Binding SavedRunSummary, Converter={StaticResource NotNullToVisibility}}"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               MaxWidth="380"
                               TextAlignment="Center"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Back / Next (Finish on the last step) / Cancel. Cancel is IsCancel alone, with
             no CancelCommand: AppWindow closes the window for a cancel ButtonAdv before the
             button's command would run, and CancelCommand only asks for that same close. -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <syncfusion:ButtonAdv Label="Back"
                                  Tag="&#xE72B;"
                                  IconTemplate="{StaticResource TagGlyphIconTemplate}"
                                  SizeMode="Normal"
                                  Command="{Binding BackCommand}"
                                  MinWidth="80"
                                  Margin="0,0,8,0" />
            <syncfusion:ButtonAdv Label="{Binding NextButtonText}"
                                  Tag="&#xE72A;"
                                  IconTemplate="{StaticResource TagGlyphIconTemplate}"
                                  SizeMode="Normal"
                                  Command="{Binding NextCommand}"
                                  MinWidth="90"
                                  Margin="0,0,8,0"
                                  IsDefault="True" />
            <syncfusion:ButtonAdv Label="Cancel"
                                  IconTemplate="{StaticResource CancelIconTemplate}"
                                  SizeMode="Normal"
                                  MinWidth="80"
                                  IsCancel="True" />
        </StackPanel>
    </Grid>
</Grid>
</controls:AppWindow>
