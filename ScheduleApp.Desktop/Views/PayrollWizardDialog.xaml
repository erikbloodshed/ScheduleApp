<ui:FluentWindow x:Class="ScheduleApp.Desktop.Views.PayrollWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels"
        xmlns:converters="clr-namespace:ScheduleApp.Desktop.Converters"
        xmlns:utilities="clr-namespace:ScheduleApp.Desktop.Utilities"
        Title="New Payroll Run"
        Width="700" Height="600"
        MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        utilities:WindowSizing.ConstrainToWorkArea="True"
        ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <converters:NumberConverter x:Key="Number" />

        <!-- Applies to both Step 1 Period pickers below via implicit TargetType match
             (no x:Key needed - this dialog has no other DatePicker to accidentally
             catch). Full "MMMM d, yyyy" month name (e.g. "September 16, 2026") rather
             than the short default date, matching AttendanceView.xaml/PayrollPage.xaml's
             own Period pickers - see those files' own copy of this style. Each
             DatePicker's own Width below is widened to fit the longer text. -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <TextBox Text="{Binding Path=SelectedDate,
                            RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, StringFormat='{}{0:MMMM d, yyyy}'}"
                                 TextAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Right-aligned numeric grid cell/header pair, same shape as EmployeesPage's own
             copy of this style (and AttendanceStatusDetailDialog/EmployeeAttendancePanel/
             AttendanceView's) - see those files' own copies for why it's duplicated
             per-file rather than shared. Used by Step 3's review grid below. -->
        <Style x:Key="RightAlignedCell"
               TargetType="TextBlock">
            <Setter Property="TextAlignment"
                    Value="Right" />
            <Setter Property="Margin"
                    Value="0,0,8,0" />
        </Style>
        <Style x:Key="RightAlignedHeader"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment"
                    Value="Right" />
        </Style>

        <!-- Step-indicator label styling: gray/normal by default, dark/bold while its own
             step is current (see PayrollWizardViewModel.IsStep1Active/IsStep2Active/
             IsStep3Active). Three near-identical styles rather than one parameterized one -
             each needs a DataTrigger bound to a different property, and a WPF Style can't
             take a binding path as a parameter. -->
        <Style x:Key="Step1LabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStep1Active}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="FontWeight"
                            Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Step2LabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource Step1LabelStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStep2Active}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="FontWeight"
                            Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Step3LabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource Step1LabelStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStep3Active}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="FontWeight"
                            Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Same two-style department/employee TreeView split PayslipScopeDialog.xaml
             uses for its own tree - see that file's own comment for why department-level
             visibility needs its own ItemContainerStyle while the nested employee level
             gets one through the HierarchicalDataTemplate instead. -->
        <Style x:Key="WizardEmployeeDepartmentItemStyle"
               TargetType="TreeViewItem">
            <Setter Property="Visibility"
                    Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
            <Setter Property="IsExpanded"
                    Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
        <Style x:Key="WizardEmployeeItemStyle"
               TargetType="TreeViewItem">
            <Setter Property="Visibility"
                    Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- See MainWindow.xaml's own TitleBar comment for why every FluentWindow needs
             one of these - WPF-UI removes the native title bar entirely otherwise. -->
        <ui:TitleBar Grid.Row="0"
                Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                ShowMinimize="False"
                ShowMaximize="True"
                CanMaximize="True" />

    <Grid Grid.Row="1" Margin="16"
          RowDefinitions="Auto,Auto,*,Auto">

        <!-- Step indicator -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12">
            <TextBlock Text="1. Period &amp; Label"
                       Style="{StaticResource Step1LabelStyle}" />
            <TextBlock Text="  —  "
                       Foreground="{DynamicResource CardStrokeColorDefaultBrush}" />
            <TextBlock Text="2. Employees"
                       Style="{StaticResource Step2LabelStyle}" />
            <TextBlock Text="  —  "
                       Foreground="{DynamicResource CardStrokeColorDefaultBrush}" />
            <TextBlock Text="3. Calculate &amp; Review"
                       Style="{StaticResource Step3LabelStyle}" />
        </StackPanel>

        <Separator Grid.Row="1"
                   Margin="0,0,0,16" />

        <!-- Step content - three panels layered in the same cell, only the current step's
             own Visibility is Visible (see IsStep1Visible/IsStep2Visible/IsStep3Visible).
             Chosen over a TabControl so there's no tab strip of its own to keep in sync
             with the step-indicator row above. -->
        <Grid Grid.Row="2">
            <!-- Step 1: Period + Label (build-order step 6) -->
            <StackPanel Visibility="{Binding IsStep1Visible, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Period"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,16">
                    <DatePicker SelectedDate="{Binding PeriodStart}"
                                IsTodayHighlighted="True"
                                Width="190"
                                Margin="0,0,8,0" />
                    <TextBlock Text="to"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <DatePicker SelectedDate="{Binding PeriodEnd}"
                                IsTodayHighlighted="True"
                                Width="190" />
                </StackPanel>

                <TextBlock Text="Label"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Shown later in &quot;Load Payroll Group…&quot; -- auto-filled from the period above, but freely editable." />

                <TextBlock Text="{Binding PeriodValidationMessage}"
                           Visibility="{Binding PeriodValidationMessage, Converter={StaticResource NotNullToVisibility}}"
                           Foreground="#B91C1C"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
            </StackPanel>

            <!-- Step 2: Employees (build-order step 7) - same department/employee
                 checkbox tree PayslipScopeDialog.xaml uses, reusing the same
                 DepartmentGroupViewModel/EmployeeNodeViewModel shapes (see
                 PayrollWizardViewModel.Departments' own doc comment). -->
            <Grid Visibility="{Binding IsStep2Visible, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,8">
                    <TextBlock Text="Search"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Comma-separated Employee ID, last name, first name, or department terms to narrow the tree to (e.g. &quot;342, Cruz, Kitchen&quot;). Leave blank to show everyone -- this only changes what's shown, not what's checked." />
                </StackPanel>

                <TreeView Grid.Row="1"
                          ItemsSource="{Binding Departments}"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                          ItemContainerStyle="{StaticResource WizardEmployeeDepartmentItemStyle}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:DepartmentGroupViewModel}"
                                                  ItemsSource="{Binding Employees}"
                                                  ItemContainerStyle="{StaticResource WizardEmployeeItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          IsThreeState="False"
                                          VerticalAlignment="Center"
                                          ToolTip="Include/exclude every employee in this department"
                                          Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="Bold" />
                            </StackPanel>
                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EmployeeNodeViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Employee.DisplayName}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPin}"
                                                                     Value="False">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            <Setter Property="ToolTip"
                                                                    Value="No Employee ID (Pin) set for this person -- payroll can't be computed until one is. Set it in the Add/Edit Employee dialog on the Schedule tab." />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Optional per the Phase 4 plan (row 9) - same Monthly
                                             badge as AddToPayrollGroupDialog's tree, same reasoning. -->
                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="4,1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsMonthly, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Monthly"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <StackPanel Grid.Row="2"
                            Margin="0,8,0,0">
                    <TextBlock Text="{Binding SelectionScopeText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Select All"
                                Command="{Binding SelectAllTreeCommand}"
                                Padding="8,3"
                                Margin="0,0,6,0" />
                        <Button Content="Clear"
                                Command="{Binding ClearTreeSelectionCommand}"
                                Padding="8,3" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Step 3: Calculate & Review (build-order step 8) - CalculateReviewAsync
                 (fired from PayrollWizardViewModel.NextAsync the moment this step is
                 reached) fills ReviewResults straight off IPayrollComputationService,
                 looped once per Step 2 employee, same as PayrollPrintExportViewModel.
                 PrintPayslipsAsync/ExportPayrollReportAsync already loop it. "Save Payroll
                 Group" below still writes straight off Step 2's own checked employees
                 rather than off this grid - see SavePayrollGroupAsync's own doc comment
                 for why the two stay independent. -->
            <Grid Visibility="{Binding IsStep3Visible, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Calculate &amp; Review"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Margin="0,0,0,8" />

                <!-- Calculating pulse / error / grid+totals - mutually exclusive, see
                     PayrollWizardViewModel.IsReviewReady's own doc comment. -->
                <Grid Grid.Row="1">
                    <TextBlock Text="Calculating payroll for the checked employees…"
                               Visibility="{Binding IsCalculating, Converter={StaticResource BoolToVisibility}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <TextBlock Text="{Binding CalculationErrorMessage}"
                               Visibility="{Binding CalculationErrorMessage, Converter={StaticResource NotNullToVisibility}}"
                               Foreground="#B91C1C"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="380"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <DockPanel Visibility="{Binding IsReviewReady, Converter={StaticResource BoolToVisibility}}">
                        <!-- Totals strip - same four columns as the grid below, right-aligned
                             under the matching Gross Pay/Deductions/Net Pay cells so the
                             column totals line up under what they're summing. -->
                        <Border DockPanel.Dock="Bottom"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1,0,1,1"
                                Padding="8,6">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="Total"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding TotalNetPay, Converter={StaticResource Number}}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Right"
                                           Width="110"
                                           VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding TotalDeductions, Converter={StaticResource Number}}"
                                           TextAlignment="Right"
                                           Width="110"
                                           VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding TotalGrossPay, Converter={StaticResource Number}}"
                                           TextAlignment="Right"
                                           Width="110"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <DataGrid ItemsSource="{Binding ReviewResults}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Employee"
                                                    Binding="{Binding EmployeeName}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Gross Pay"
                                                    Binding="{Binding TotalGrossPay, Converter={StaticResource Number}}"
                                                    ElementStyle="{StaticResource RightAlignedCell}"
                                                    HeaderStyle="{StaticResource RightAlignedHeader}"
                                                    Width="110" />
                                <DataGridTextColumn Header="Deductions"
                                                    Binding="{Binding TotalDeductions, Converter={StaticResource Number}}"
                                                    ElementStyle="{StaticResource RightAlignedCell}"
                                                    HeaderStyle="{StaticResource RightAlignedHeader}"
                                                    Width="110" />
                                <DataGridTextColumn Header="Net Pay"
                                                    Binding="{Binding NetPay, Converter={StaticResource Number}}"
                                                    ElementStyle="{StaticResource RightAlignedCell}"
                                                    HeaderStyle="{StaticResource RightAlignedHeader}"
                                                    Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>

                <!-- Save Payroll Group + status (build-order step 8.3) -->
                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0">
                    <Button Content="Save Payroll Group"
                            Command="{Binding SavePayrollGroupCommand}"
                            HorizontalAlignment="Center"
                            Padding="14,6" />

                    <TextBlock Text="Saving…"
                               Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibility}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0" />

                    <TextBlock Text="{Binding SaveErrorMessage}"
                               Visibility="{Binding SaveErrorMessage, Converter={StaticResource NotNullToVisibility}}"
                               Foreground="#B91C1C"
                               TextWrapping="Wrap"
                               MaxWidth="380"
                               TextAlignment="Center"
                               Margin="0,10,0,0" />

                    <TextBlock Text="{Binding SavedRunSummary}"
                               Visibility="{Binding SavedRunSummary, Converter={StaticResource NotNullToVisibility}}"
                               Foreground="#15803D"
                               TextWrapping="Wrap"
                               MaxWidth="380"
                               TextAlignment="Center"
                               Margin="0,10,0,0" />

                    <TextBlock Text="Changes to the employee list on Step 2 from here on won't be included in this saved run -- click Finish to close, or Cancel and start a new run to save a different selection."
                               Visibility="{Binding SavedRunSummary, Converter={StaticResource NotNullToVisibility}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               MaxWidth="380"
                               TextAlignment="Center"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Back / Next (Finish on the last step) / Cancel -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Back"
                    Command="{Binding BackCommand}"
                    Width="80"
                    Margin="0,0,8,0" />
            <Button Content="{Binding NextButtonText}"
                    Command="{Binding NextCommand}"
                    Width="90"
                    Margin="0,0,8,0"
                    IsDefault="True" />
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Width="80"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Grid>
</ui:FluentWindow>
