<ui:FluentWindow x:Class="ScheduleApp.Desktop.Views.HolidayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Add Holiday" Width="340" Height="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
>
    <!-- Same DatePickerTextBox restyle ManualLogEntryDialog/PayslipScopeDialog/etc.
         already use, so DateBox renders "Month d, yyyy" instead of the bare-WPF
         default short date format. No x:Key needed - this dialog has no other
         DatePicker to accidentally catch. -->
    <Window.Resources>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <TextBox Text="{Binding Path=SelectedDate,
                            RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, StringFormat='{}{0:MMMM d, yyyy}'}"
                                 TextAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- See MainWindow.xaml's own TitleBar comment for why every FluentWindow needs
             one of these - WPF-UI removes the native title bar entirely otherwise. -->
        <ui:TitleBar Grid.Row="0"
                Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                ShowMaximize="False"
                CanMaximize="False" />

    <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Date" Margin="0,0,0,4" />
        <DatePicker x:Name="DateBox" Grid.Row="1" MinWidth="230" HorizontalAlignment="Left" Margin="0,0,0,12" />

        <TextBlock Grid.Row="2" Text="Name" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Grid.Row="3" Margin="0,0,0,4" />

        <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,8,0,0" VerticalAlignment="Top" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Content="Add" Width="80" Margin="0,0,8,0" IsDefault="True" Click="SaveButton_Click" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Grid>
</ui:FluentWindow>
