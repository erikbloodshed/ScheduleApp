<ui:FluentWindow x:Class="ScheduleApp.Desktop.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:utilities="clr-namespace:ScheduleApp.Desktop.Utilities"
        xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
        Title="Settings" Width="560" Height="660"
        MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        utilities:WindowSizing.ConstrainToWorkArea="True"
        ExtendsContentIntoTitleBar="True">
    <!-- Layout-only styles, kept local rather than pushed into Themes/AppStyles.xaml
         since nothing outside this dialog lays fields out this way (the same
         style-per-file precedent EmployeesPage/PayrollPage/PushListenerView set with
         their own GroupLabel). The two text styles the markup below references -
         SectionHeaderTextStyle / SectionCaptionTextStyle - do live in AppStyles, because
         a bold group header and a wrapped caption under it are repeated across most of
         this app's XAML rather than being anything specific to Settings. -->
    <ui:FluentWindow.Resources>
        <!-- One label:value field. DockPanel rather than a two-column Grid on purpose:
             a *shared* Grid brings back the Grid.Row="N" bookkeeping this dialog was
             rewritten to get rid of, and a per-row Grid needs its own four-line
             ColumnDefinitions block (which can't be hoisted into a Style - the
             collection is read-only). A DockPanel needs neither, so adding, removing or
             reordering a field is a self-contained four-line edit that touches nothing
             else in the file. -->
        <Style x:Key="FieldRowStyle" TargetType="DockPanel">
            <Setter Property="LastChildFill" Value="True" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- The label half of such a row. Declared *second* inside the DockPanel even
             though it appears first on screen: DockPanel fills with its last child, so
             the label is what absorbs the leftover width (and wraps) while the value box
             keeps the fixed width that lines every row's values up with each other. -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <!-- The value half. Fixed width because every field using it holds a short
             number or time; the two genuinely long free-text fields (connection string,
             company name) deliberately don't use this row shape at all.

             BasedOn is load-bearing, not decoration. Setting Style on a control REPLACES
             the implicit theme style for its type rather than extending it, so without
             this every box here silently dropped WPF-UI's Fluent TextBox template and
             fell back to stock WPF chrome - a flat 1px rectangle sitting next to the
             properly-themed company name box, TimeInputs and checkboxes on the same
             screen. Same reason EmployeeDialog spells out Style="{StaticResource
             {x:Type TextBox}}" on its NumericTextBoxes. Any style added here for a
             themed control needs the same treatment. -->
        <Style x:Key="FieldValueBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Width" Value="120" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- See MainWindow.xaml's own TitleBar comment for why every FluentWindow needs
             one of these - WPF-UI removes the native title bar entirely otherwise.
             ShowMaximize stays off even though this window is now resizable (it wasn't
             before): edge-dragging is what the Attendance tab needs to stop scrolling on
             a tall monitor, a maximize button on a settings dialog isn't. -->
        <ui:TitleBar Grid.Row="0"
                Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                ShowMinimize="False"
                ShowMaximize="False"
                CanMaximize="False" />

        <Grid Grid.Row="1" Margin="16" RowDefinitions="Auto,*,Auto">

            <!-- Above the tabs rather than on one of them: this describes the file every
                 tab writes to, so it would be equally out of place inside any single one.
                 The one-liner carries the full explanation as its tooltip instead of
                 spending four wrapped lines of every tab's height on it. -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource SectionCaptionTextStyle}"
                           Margin="0,0,0,2"
                           Text="Shared, machine-wide settings -- applied the next time each app starts."
                           ToolTip="Saved to the shared, machine-wide config file both Schedule Manager and the Push Listener service read -- set once per machine instead of once per app. Takes effect the next time each one starts. Only the Database tab affects Push Listener; every other tab here is Schedule Manager's alone, but they all live in the same file for one place to manage all of it." />

                <TextBlock x:Name="FilePathText" Style="{StaticResource SectionCaptionTextStyle}" Margin="0" />
            </StackPanel>

            <!-- Plain TabControl/TabItem, unstyled - WPF-UI's ControlsDictionary (merged
                 in App.xaml) supplies the Fluent chrome, exactly as PushListenerView.xaml
                 already relies on. Deliberately not ui:TabView: that's the browser/
                 document metaphor, with close buttons and drag-to-reorder, and nobody
                 should be able to close the Database tab.

                 Worth saying explicitly, since several comments elsewhere in this app
                 (AttendanceSummaryPage.xaml.cs, MainWindow.xaml) document a TabControl
                 being *removed*: neither reason applies here. That one went because those
                 three tabs wanted to be real navigable pages, and because - per
                 AttendanceSharedState's own comment - a TabControl selects its first
                 TabItem the moment its visual tree is built, which fired an async
                 database load before the page was ready. This dialog loads nothing; every
                 field is filled synchronously from constructor arguments before it's ever
                 shown, so first-tab selection has nothing to race.

                 Fields are grouped by *change group*, not just by subject matter, because
                 SharedConfigWriter.Save writes whole sections at a time - keeping one
                 config group on one tab keeps "what I touched" and "what gets written"
                 the same thing. See the class doc comment for the mapping. -->
            <TabControl x:Name="SettingsTabs" Grid.Row="1">

                <TabItem Header="Database">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,12,16,12">
                            <TextBlock Style="{StaticResource SectionCaptionTextStyle}"
                                       Text="Where both apps look for the ScheduleDb / AttendanceLogs database. This is the only tab here that Push Listener reads." />

                            <TextBlock Text="Connection string" Margin="0,0,0,4" />

                            <!-- The one field that doesn't use the shared label:value row
                                 shape - a connection string wants every pixel of width it
                                 can get, so its label goes above it, and the wizard button
                                 goes beside the box it fills in rather than under it. See
                                 DatabaseSetupDialog / CreateDatabaseButton_Click. -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="ConnectionStringBox" Grid.Column="0" Margin="0,0,8,0"
                                         FontFamily="Consolas"
                                         ToolTip="The SQL Server connection string both apps use to reach the ScheduleDb / AttendanceLogs database." />
                                <Button Grid.Column="1" Content="Create New Database / Login…" Padding="8,4"
                                        Click="CreateDatabaseButton_Click"
                                        ToolTip="Opens a wizard to create a database and SQL Server login, then fills the connection string above with the result -- still needs Save below to apply it." />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Device">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,12,16,12">
                            <TextBlock Style="{StaticResource SectionCaptionTextStyle}"
                                       Text="Used every time Fetch from Device runs on the Attendance page -- this app talks to a single terminal, so there's no per-fetch override. Leave blank and Fetch from Device will just remind you to set it here." />

                            <DockPanel Style="{StaticResource FieldRowStyle}">
                                <TextBox x:Name="DeviceIpBox" Style="{StaticResource FieldValueBoxStyle}" Width="180"
                                         ToolTip="The terminal's IP address -- check Menu → Comm → Ethernet on the device itself." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Device IP" />
                            </DockPanel>

                            <DockPanel Style="{StaticResource FieldRowStyle}">
                                <TextBox x:Name="PortBox" Style="{StaticResource FieldValueBoxStyle}"
                                         ToolTip="4370 is the standard ZKTeco port -- almost never needs to change." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Port" />
                            </DockPanel>

                            <DockPanel Style="{StaticResource FieldRowStyle}">
                                <TextBox x:Name="CommKeyBox" Style="{StaticResource FieldValueBoxStyle}"
                                         ToolTip="The device's communication password (Menu → Comm → Ethernet/Comm Key). 0 = no password, the out-of-the-box default on most units." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Comm key" />
                            </DockPanel>

                            <CheckBox x:Name="UseUdpCheckBox" Content="Use UDP" Margin="0,4,0,0"
                                      ToolTip="Most deployments use TCP (unchecked). Check this only if the device is configured for UDP-only communication." />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Attendance">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,12,16,12">
                            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Scheduling defaults" />
                            <TextBlock Style="{StaticResource SectionCaptionTextStyle}"
                                       Text="Pre-filled into the work time field whenever you set a schedule for days that don't already have one -- you can still change it per entry, this is just the starting point." />

                            <DockPanel Style="{StaticResource FieldRowStyle}" Margin="0,0,0,16">
                                <TextBox x:Name="DefaultWorkTimeHoursBox" Style="{StaticResource FieldValueBoxStyle}"
                                         ToolTip="Starting value for a new Normal/Official Business/Flexible schedule entry's work-time-hours field. Default 10." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Default work time (hours)" />
                            </DockPanel>

                            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Attendance policy" />
                            <TextBlock Style="{StaticResource SectionCaptionTextStyle}"
                                       Text="Tunable rules for matching punches to a scheduled shift and computing hours. Values are in hours unless noted otherwise; the out-of-the-box defaults work for most deployments." />

                            <DockPanel Style="{StaticResource FieldRowStyle}">
                                <TextBox x:Name="ClockInBufferBeforeBox" Style="{StaticResource FieldValueBoxStyle}"
                                         ToolTip="How far before a shift's scheduled start a punch still counts as that shift's clock-in. Default 2." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Clock-in buffer, before scheduled time" />
                            </DockPanel>

                            <DockPanel Style="{StaticResource FieldRowStyle}">
                                <TextBox x:Name="ClockInBufferAfterBox" Style="{StaticResource FieldValueBoxStyle}"
                                         ToolTip="How far after a shift's scheduled start a punch still counts as that shift's clock-in. Default 2." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Clock-in buffer, after scheduled time" />
                            </DockPanel>

                            <DockPanel Style="{StaticResource FieldRowStyle}">
                                <TextBox x:Name="ClockOutBufferBeforeBox" Style="{StaticResource FieldValueBoxStyle}"
                                         ToolTip="How far before a shift's scheduled end a punch still counts as that shift's clock-out. Default 6." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Clock-out buffer, before scheduled time" />
                            </DockPanel>

                            <DockPanel Style="{StaticResource FieldRowStyle}">
                                <TextBox x:Name="ClockOutBufferAfterBox" Style="{StaticResource FieldValueBoxStyle}"
                                         ToolTip="How far after a shift's scheduled end a punch still counts as that shift's clock-out. Default 6." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Clock-out buffer, after scheduled time" />
                            </DockPanel>

                            <DockPanel Style="{StaticResource FieldRowStyle}">
                                <TextBox x:Name="FlexInBufferBox" Style="{StaticResource FieldValueBoxStyle}"
                                         ToolTip="Same idea as the clock-in buffers above, but for one segment of a split shift -- tighter by default since a segment is usually much shorter than a full shift. Default 1." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Split shift segment clock-in buffer" />
                            </DockPanel>

                            <DockPanel Style="{StaticResource FieldRowStyle}">
                                <TextBox x:Name="FlexOutBufferBox" Style="{StaticResource FieldValueBoxStyle}"
                                         ToolTip="Same as above, for a split shift segment's clock-out. Default 1." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Split shift segment clock-out buffer" />
                            </DockPanel>

                            <DockPanel Style="{StaticResource FieldRowStyle}">
                                <TextBox x:Name="FlexMinBreakGapBox" Style="{StaticResource FieldValueBoxStyle}"
                                         ToolTip="Affects every Flexible day: every punch that day counts, paired off in order. Two consecutive punch-pairs count as separate work stretches only if at least this many hours separate them -- a shorter gap is treated as a duplicate/stray punch and folded into one continuous stretch instead. Default 1." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Flexible minimum break gap" />
                            </DockPanel>

                            <DockPanel Style="{StaticResource FieldRowStyle}">
                                <TextBox x:Name="GracePeriodBox" Style="{StaticResource FieldValueBoxStyle}"
                                         ToolTip="Extra time after a shift's scheduled end that's still treated as on-time rather than overtime. Default 0.5." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Clock-out grace period" />
                            </DockPanel>

                            <DockPanel Style="{StaticResource FieldRowStyle}">
                                <TextBox x:Name="LateEarlyGraceMinutesBox" Style="{StaticResource FieldValueBoxStyle}"
                                         ToolTip="How many minutes late clocking in, or early clocking out, still count as exactly on time -- so a couple minutes' slack doesn't get flagged as Late In/Early Out or dock pay. Past this many minutes, the full difference counts, not just the amount beyond it. Default 5." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Late in / early out grace period (minutes)" />
                            </DockPanel>

                            <!-- TimeInput rather than FieldValueBoxStyle's plain TextBox (it isn't a
                                 TextBox, so that style's TargetType wouldn't match it anyway) - its
                                 own DockPanel.Dock="Right" stands in for the style's, and its Compact
                                 density's fixed footprint stands in for the style's fixed Width. -->
                            <DockPanel Style="{StaticResource FieldRowStyle}">
                                <controls:TimeInput x:Name="NightDiffStartBox" Density="Compact" DockPanel.Dock="Right"
                                         ToolTip="Start of the night-differential window, based on actual clocked-in/out time (not the scheduled shift). Default 10:00 PM. Official Business never earns night diff, regardless of this setting." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Night differential start" />
                            </DockPanel>

                            <DockPanel Style="{StaticResource FieldRowStyle}" Margin="0,0,0,12">
                                <controls:TimeInput x:Name="NightDiffEndBox" Density="Compact" DockPanel.Dock="Right"
                                         ToolTip="End of the night-differential window. Default 6:00 AM -- earlier than the start, which is how this (and every other time field here) marks a window that crosses midnight." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Night differential end" />
                            </DockPanel>

                            <CheckBox x:Name="CapEarlyClockInCheckBox" Content="Cap early clock-in at the scheduled start time" Margin="0,0,0,8"
                                      ToolTip="If checked, clocking in early doesn't count extra time before the shift was due to start." />
                            <CheckBox x:Name="StrictOvertimeCheckBox" Content="Count overtime strictly from the shift's scheduled end" Margin="0,0,0,8"
                                      ToolTip="If checked, overtime is measured from the scheduled shift end rather than from the grace period's cutoff." />

                            <!-- Reads like a reporting option, and it is one - but it's
                                 AttendancePolicy.UseExcelFormula, so it belongs to the
                                 same write as everything else on this tab. Putting it over
                                 on Payroll would mean ticking one checkbox there rewrites
                                 the whole Attendance:Policy section from a tab that never
                                 showed those values. -->
                            <CheckBox x:Name="UseExcelFormulaCheckBox" Content="Use live formulas in exported Excel summaries"
                                      ToolTip="If checked, Generate Reports writes recalculating Excel formulas instead of literal computed values, so the workbook stays correct if these numbers are tweaked by hand afterward." />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Payroll">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,12,16,12">
                            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Payslip" />
                            <TextBlock Style="{StaticResource SectionCaptionTextStyle}"
                                       Text="The company name printed at the top of every generated payslip, both the Print Current Payslip / Print Payslips… preview and the saved PDF." />

                            <TextBlock Text="Company name" Margin="0,0,0,4" />
                            <TextBox x:Name="CompanyNameBox" Margin="0,0,0,16"
                                     ToolTip="Printed centered at the top of every payslip, above the PAYSLIP heading. Required." />

                            <!-- Premium rates were appsettings.json-only until the rest-day
                                 tier work added two more of them and made that hard to
                                 justify - a rate nobody can see is a rate nobody checks.
                                 Every PayrollPolicy value now has a field here. Each field
                                 below is a PercentTextBox, not a plain TextBox - it shows
                                 and edits the premium as a whole percent (30%), while the
                                 PayrollPolicy property it's bound to still holds the same
                                 decimal fraction (0.30) it always did; see that control's
                                 own doc comment for the x100/div-100 scaling this involves. -->
                            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Premium rates" />
                            <TextBlock Style="{StaticResource SectionCaptionTextStyle}"
                                       Text="Company-wide, applied to every employee -- 30% means a rest day pays 130%. Individual days and employees can override some of these; see PAYROLL-POLICY.md for which, and for what each one is worth under Philippine labor law." />

                            <DockPanel Style="{StaticResource FieldRowStyle}">
                                <TextBox x:Name="StandardHoursPerDayBox" Style="{StaticResource FieldValueBoxStyle}"
                                         ToolTip="The length of a standard workday, in hours. Divides into the daily rate to produce the hourly rate that every premium below is computed from, and is also the boundary where rest day work crosses from the first tier to the overtime tier. Must be greater than 0. Default 8." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Standard hours per day" />
                            </DockPanel>

                            <DockPanel Style="{StaticResource FieldRowStyle}">
                                <controls:PercentTextBox x:Name="OvertimeRatePercentageBox" DockPanel.Dock="Right" Width="120" Maximum="5"
                                         ToolTip="Added on top of straight time for overtime hours on an ordinary workday -- 25% means overtime pays 125%. Overridable per day from the Set/Edit Schedule dialog, and skipped entirely for a day whose apply-rate-% toggle is off. Default 25%." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Overtime premium" />
                            </DockPanel>

                            <DockPanel Style="{StaticResource FieldRowStyle}">
                                <controls:PercentTextBox x:Name="NightDiffRatePercentageBox" DockPanel.Dock="Right" Width="120" Maximum="5"
                                         ToolTip="Paid for each hour falling inside the night differential window set on the Attendance tab -- 10% means those hours earn an extra 10%. Taken against whatever rate is in force that day, so night hours on a rest day earn 10% of the rest day rate, not of straight time. Overridable per day. Default 10%." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Night differential premium" />
                            </DockPanel>

                            <DockPanel Style="{StaticResource FieldRowStyle}">
                                <controls:PercentTextBox x:Name="RestDayPremiumPercentageBox" DockPanel.Dock="Right" Width="120" Maximum="5"
                                         ToolTip="Added on top of straight time for the first 8 hours of a rest day that is actually worked -- 30% means those hours pay 130%, the Philippine statutory rate. Overridable per employee from the Add/Edit Employee dialog, where leaving the box blank inherits this value. Default 30%." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Rest day premium" />
                            </DockPanel>

                            <DockPanel Style="{StaticResource FieldRowStyle}">
                                <controls:PercentTextBox x:Name="RestDayOvertimeRatePercentageBox" DockPanel.Dock="Right" Width="120" Maximum="5"
                                         ToolTip="Added on top of the REST DAY rate for hours beyond the standard workday -- it compounds rather than adding to the rest day premium, so 30% on top of a 30% rest day premium pays 130% x 130% = 169%, not 160%. No per-employee or per-day override: a rest day never produces ordinary overtime hours for one to attach to. Default 30%." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Rest day overtime premium" />
                            </DockPanel>

                            <!-- Last row before the next section header, so it carries the
                                 0,0,0,16 separator the Attendance tab uses in the same spot. -->
                            <DockPanel Style="{StaticResource FieldRowStyle}" Margin="0,0,0,16">
                                <controls:PercentTextBox x:Name="HolidayPremiumPercentageBox" DockPanel.Dock="Right" Width="120" Maximum="5"
                                         ToolTip="Added on top of Basic Pay's own 100% for a worked holiday's day component -- 100% means one full extra day, 200% total, the Philippine statutory rate for a worked regular holiday. Also what a Monthly-rated employee earns for a listed holiday they didn't work at all. Overridable per employee from the Add/Edit Employee dialog, where leaving the box blank inherits this value. Default 100%." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Holiday premium" />
                            </DockPanel>

                            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Net pay" />

                            <DockPanel Style="{StaticResource FieldRowStyle}">
                                <TextBox x:Name="NetPayRoundingMultipleBox" Style="{StaticResource FieldValueBoxStyle}"
                                         ToolTip="Rounds each employee's Net Pay to the nearest multiple of this amount, the same way Excel's MROUND(number, multiple) function works -- e.g. 1 rounds to the nearest whole unit, 5 to the nearest 5, 0.25 to the nearest quarter. 0.01 (the default) keeps Net Pay at its normal 2-decimal precision -- effectively no extra rounding. Must be greater than 0." />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Net pay rounding (nearest multiple)" />
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Sign-in">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,12,16,12">
                            <TextBlock Style="{StaticResource SectionCaptionTextStyle}"
                                       Text="The logo shown above the sign-in form and the first-run setup screen. Choose an image to replace the default; Reset to Default goes back to the built-in logo." />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Width="120" Height="80">
                                    <Image x:Name="LogoPreviewImage" Source="/Assets/Tinapayan_Logo.png" Stretch="Uniform" Margin="4" />
                                </Border>
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button x:Name="ChooseLogoButton" Content="Choose Image..." Width="140" Margin="0,0,0,6"
                                            Click="ChooseLogoButton_Click" />
                                    <Button x:Name="ResetLogoButton" Content="Reset to Default" Width="140"
                                            Click="ResetLogoButton_Click" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock x:Name="LogoStatusText" Style="{StaticResource SectionCaptionTextStyle}" Margin="0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Save" Width="80" Margin="0,0,8,0" IsDefault="True" Click="SaveButton_Click" />
                <Button Content="Cancel" Width="80" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
