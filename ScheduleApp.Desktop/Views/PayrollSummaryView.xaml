<rxui:ReactiveUserControl x:Class="ScheduleApp.Desktop.Views.PayrollSummaryView"
             x:TypeArguments="payrollVm:PayrollSummaryViewModel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rxui="http://reactiveui.net"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels"
             xmlns:payrollVm="clr-namespace:ScheduleApp.Desktop.ViewModels.Payroll"
             xmlns:views="clr-namespace:ScheduleApp.Desktop.Views"
             xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
             xmlns:converters="clr-namespace:ScheduleApp.Desktop.Converters"
             xmlns:payroll="clr-namespace:ScheduleApp.Payroll;assembly=ScheduleApp.Payroll"
             xmlns:corePayroll="clr-namespace:ScheduleApp.Core.Payroll;assembly=ScheduleApp.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:PayrollAdjustmentTypeToLabelConverter x:Key="AdjustmentTypeLabelConverter" />
        <converters:WaivedToExcludeIncludeLabelConverter x:Key="WaivedToExcludeIncludeLabel" />

        <!-- Deductions' text colour. The Deductions card sets it as TextElement.Foreground,
             and everything inside inherits it: TextBlocks on their own, the boxes through
             ValueTextBox/EditableDescriptionTextBox's Foreground binding. So one set of line
             templates serves both columns. -->
        <SolidColorBrush x:Key="DeductionForegroundBrush" Color="#DC2626" />

        <!-- Right-aligned figure, used for the two section totals (Total Gross Pay/Total
             Deductions in the DockPanel below) - the one roll-up level above even a category
             subtotal, so it stays plain text rather than boxed like ValueTextBox below. Every
             genuinely itemized category's subtotal (Incentive/Other Charges) uses the
             boxed ValueTextBox look instead - see that style's own doc comment. Net Pay itself
             (bottom of the page) uses a bigger, unstyled TextBlock instead, since it isn't one
             line among many the way everything else here is. -->
        <Style x:Key="AmountText"
               TargetType="TextBlock">
            <Setter Property="TextAlignment"
                    Value="Right" />
            <Setter Property="MinWidth"
                    Value="92" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>

        <!-- White bordered card, shared by every category section (Basic Pay/Overtime/Night
             Diff/Undertime same as Allowance/Incentive/SSS/etc.) so all of them read as the
             same kind of thing rather than the computed lines floating outside a card the way
             they used to. Factored out of what used to be AdjustmentGroupTemplate's own inline
             Border properties. -->
        <Style x:Key="LineCardBorder"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="4" />
            <Setter Property="Padding"
                    Value="8,6" />
            <Setter Property="Margin"
                    Value="0,0,0,6" />
        </Style>

        <!-- A single line's own value (Basic Pay's amount, an Allowance/SSS/etc. row's
             amount) shown inside a boxed, textbox-styled control rather than a plain
             TextBlock - same look every single-value line, every itemized row, AND
             Incentive/Other Charges' own Subtotal all share, per the Payroll Feature's
             "consistent with Allowance/Incentive/SSS" ask. Only the two section totals (Total
             Gross Pay/Total Deductions) sit a level above that and keep using the plain
             AmountText style above instead. Always IsReadOnly - editing still goes through the
             row's own Delete button (or isn't offered at all for the computed lines) or, for a
             single-value category, EditableAmountTextBox below instead of this style
             entirely - this is about the boxed look, not turning this into a live inline
             editor. -->
        <Style x:Key="ValueTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <!-- The theme sets a box's text colour itself, so it would otherwise ignore
                 the red the Deductions card passes down -->
            <Setter Property="Foreground"
                    Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Panel}}" />
            <Setter Property="IsReadOnly"
                    Value="True" />
            <Setter Property="IsReadOnlyCaretVisible"
                    Value="False" />
            <Setter Property="TextAlignment"
                    Value="Right" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Padding"
                    Value="6,0" />
            <Setter Property="MinWidth"
                    Value="92" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>

        <!-- A computed line's amount box: ValueTextBox, grayed out once the line is Waived
             (excluded). The figure itself stays the real computed value, un-struck-through
             (see PayrollLineItem.Waived) - this is only a "disregarded" cue beside the toggle's
             Exclude/Include text. -->
        <Style x:Key="LineAmountTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource ValueTextBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Waived}"
                             Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource CardBackgroundBrush}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource MutedForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Same boxed look as ValueTextBox, but actually editable - used only for a
             single-value category's (Allowance/SSS/PhilHealth/Pag-IBIG/Cash Advance) own
             inline amount box, the one place on this page where typing directly into the box
             IS the edit action rather than opening a dialog first. Committed on Enter or lost
             focus via NumericTextBox's own ValueCommitted event (see
             PayrollSummaryView.xaml.cs's SingleValueAmountBox_ValueCommitted), which calls
             PayrollSummaryViewModel.SetSingleValueAsync - see that method's own doc comment. -->
        <Style x:Key="EditableAmountTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource ValueTextBox}">
            <Setter Property="IsReadOnly"
                    Value="False" />
            <Setter Property="IsReadOnlyCaretVisible"
                    Value="True" />
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBackgroundBrush}" />
        </Style>

        <!-- Same boxed, directly-editable look as EditableAmountTextBox, but left-aligned and
             not fixed-width - used only for an inline-itemized row's own Description box (see
             InlineAdjustmentRowTemplate below), the itemized counterpart to
             EditableAmountTextBox's single-value amount box: typing into it IS the edit
             action, committed on LostFocus/Enter via PayrollSummaryView.xaml.cs's
             InlineDescriptionBox_LostFocus/KeyDown, which call
             PayrollSummaryViewModel.UpdateInlineDescriptionAsync. -->
        <Style x:Key="EditableDescriptionTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <!-- See ValueTextBox -->
            <Setter Property="Foreground"
                    Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Panel}}" />
            <Setter Property="TextAlignment"
                    Value="Left" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
            <!-- One line tall like every field, but free to grow as a long description wraps -->
            <Setter Property="Height"
                    Value="NaN" />
            <Setter Property="MinHeight"
                    Value="{StaticResource ControlHeight}" />
            <Setter Property="AcceptsReturn"
                    Value="False" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Padding"
                    Value="6,0" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBackgroundBrush}" />
        </Style>

        <!-- The small Delete button at the right of an itemized row - same "compact,
             row-scoped action" role as the Edit/Delete buttons in the Manual Entries grid,
             just not grid-column-hosted here since these rows live in plain ItemsControls. -->
        <Style x:Key="RowActionButton"
               TargetType="syncfusion:ButtonAdv" BasedOn="{StaticResource {x:Type syncfusion:ButtonAdv}}">
            <Setter Property="IconTemplate"
                    Value="{StaticResource DeleteIconTemplate}" />
            <Setter Property="Margin"
                    Value="6,0,0,0" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>

        <!-- Transparent, borderless header-action look - originally just Undertime's own
             Exclude/Include toggle in LineItemTemplate below, now shared by every
             category header's own action button (single-value's "Edit", inline-itemized's
             "+ Add Row", dialog-itemized's "+ Add") so all of them read as an inline label
             sitting beside the category's own Label rather than a bordered button off on the
             far right the way RowActionButton above still looks for the per-row Delete
             buttons. A framework Button (a ButtonAdv's template mustn't be replaced) so it
             keeps Click's built-in mouse+Space/Enter activation and correct button automation
             semantics, but templated down to bare text. Default WPF focus-visual (dotted rectangle on Tab) is deliberately left
             in place rather than suppressed, since that's the one piece of keyboard-accessible
             affordance this control gets "for free" by being a real Button. IsMouseOver/
             IsEnabled just dim the whole thing rather than adding an underline or color swap,
             to keep the template itself trivial. -->
        <Style x:Key="TransparentHeaderActionButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FontSize"
                    Value="11" />
            <Setter Property="Foreground"
                    Value="#2563EB" />
            <Setter Property="Padding"
                    Value="4,3" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Opacity"
                                        Value="0.7"
                                        TargetName="Bg" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.4"
                                        TargetName="Bg" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One computed PayrollLineItem (Basic Pay, Overtime, Night Diff, Undertime): never
             editable, but carded with its value boxed like an Allowance/SSS row so it reads as
             the same kind of line.

             A line that SupportsWaiver (today just Undertime; see PayrollCalculator.Calculate)
             also gets an Exclude/Include toggle. Toggling leaves Amount alone - it only stops
             the line counting into Total Deductions/Net Pay. The Click goes through
             UndertimeWaivedToggle_Click, which reaches past this template to the
             PayrollSummaryViewModel (see SetUndertimeWaivedAsync); IsEnabled follows
             CanEditAdjustmentsNow, as the editable boxes do. -->
        <DataTemplate x:Key="LineItemTemplate"
                      DataType="{x:Type payroll:PayrollLineItem}">
            <Border Style="{StaticResource LineCardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Label}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="{Binding Waived, Converter={StaticResource WaivedToExcludeIncludeLabel}}"
                            Style="{StaticResource TransparentHeaderActionButton}"
                            Visibility="{Binding SupportsWaiver, Converter={StaticResource BoolToVisibility}}"
                            IsEnabled="{Binding ViewModel.CanEditAdjustmentsNow, RelativeSource={RelativeSource AncestorType=views:PayrollSummaryView}}"
                            Click="UndertimeWaivedToggle_Click"
                            Margin="0,0,4,0"
                            ToolTip="Excludes Undertime from Total Deductions/Net Pay -- the figure stays visible, just disregarded." />
                    <TextBox Grid.Column="2"
                             Text="{Binding Amount, Converter={StaticResource Number}, Mode=OneWay}"
                             Style="{StaticResource LineAmountTextBox}"
                             Margin="8,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One inline-itemized PayrollAdjustment row (Incentive/Other Charges) -
             Description and Amount are both directly editable TextBoxes right in the row
             itself, per the Payroll Feature's "no popup, type description and amount
             directly" follow-up ask, committed on Enter or lost focus the
             same way the single-value amount box commits (see PayrollSummaryView.xaml.cs's
             InlineDescriptionBox_LostFocus/KeyDown for the Description box and
             InlineAmountBox_ValueCommitted for the Amount one, and
             PayrollSummaryViewModel.UpdateInlineDescriptionAsync/UpdateInlineAmountAsync). No Edit
             button or dialog round trip - Delete is the only action button, same
             DeleteAdjustmentCommand every other row uses. -->
        <DataTemplate x:Key="InlineAdjustmentRowTemplate"
                      DataType="{x:Type corePayroll:PayrollAdjustment}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding Description, Mode=OneWay}"
                         Style="{StaticResource EditableDescriptionTextBox}"
                         LostFocus="InlineDescriptionBox_LostFocus"
                         KeyDown="InlineDescriptionBox_KeyDown"
                         IsEnabled="{Binding ViewModel.CanEditAdjustmentsNow, RelativeSource={RelativeSource AncestorType=views:PayrollSummaryView}}" />
                <controls:NumericTextBox Grid.Column="1"
                                         Value="{Binding Amount, Mode=OneWay}"
                                         Style="{StaticResource EditableAmountTextBox}"
                                         Margin="8,0,0,0"
                                         ClearFocusOnEnter="True"
                                         ValueCommitted="InlineAmountBox_ValueCommitted"
                                         IsEnabled="{Binding ViewModel.CanEditAdjustmentsNow, RelativeSource={RelativeSource AncestorType=views:PayrollSummaryView}}" />
                <syncfusion:ButtonAdv Grid.Column="2"
                                      Label="Delete"
                                      Style="{StaticResource RowActionButton}"
                                      Command="{Binding ViewModel.DeleteAdjustmentCommand, RelativeSource={RelativeSource AncestorType=views:PayrollSummaryView}}"
                                      CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>

        <!-- One PayrollAdjustmentGroup - a category's own mini card. Two entirely different
             bodies depending on PayrollAdjustmentGroup.IsSingleValue/IsInlineItemized,
             toggled by the mutually-exclusive Visibility bindings below rather than one shared
             layout with conditional pieces, since the two kinds of category don't actually
             share a shape:
             
             - Single-value (Allowance/Premium Pay/SSS/PhilHealth/Pag-IBIG/Cash Advance): label
               + a transparent "Edit" button beside it (only shows once a value exists) + one
               inline, directly-editable amount box (bound to SingleValueAdjustment). The Edit
               button is plain UI, not a bound command (see PayrollSummaryView.xaml.cs's
               EditSingleValueButton_Click) - clicking it just focuses the amount box and
               selects its text so a new figure can be typed straight over the old one; the
               box was always directly editable on its own, the button just saves a manual
               Ctrl+A first. No subtotal (the box's own value already is the subtotal), no
               separate Add step (typing into the box does both create and update), no
               dialog. See SingleValueAdjustment's and EditableAmountTextBox's own doc
               comments. Premium Pay
               used to be its own third, dialog-based shape (an itemized "+ Add" opening a
               PayrollAdjustmentDialog) until that dialog was dropped - it only ever collected
               a single amount per line anyway, same as this group, so it moved here instead.
             
             - Inline-itemized (Incentive/OtherCharge): label + a transparent "+ Add Row"
               button beside it that creates a blank row in place (AddInlineRowCommand) + the
               subtotal, over a row list where each row's own Description/Amount are typed
               directly into it - no dialog. See InlineAdjustmentRowTemplate above and
               PayrollSummaryViewModel.AddInlineRowAsync's own doc comments.
             
             Both headers put their own action button in the same slot (right after the
             Label, styled via TransparentHeaderActionButton) that Undertime's Exclude/Include
             toggle uses in LineItemTemplate above, so every category on this page reads
             the button as sitting beside its Label rather than off past the amount - see that
             style's own doc comment.
             
             The inline-itemized row list is always rendered even when Adjustments is empty, so
             the category keeps its add action available before anything's been entered - an
             empty ItemsControl below the header just shows nothing.

             Both columns use it; in Deductions it's red through DeductionForegroundBrush. -->
        <DataTemplate x:Key="AdjustmentGroupTemplate"
                      DataType="{x:Type vm:PayrollAdjustmentGroupRow}">
            <Border Style="{StaticResource LineCardBorder}">
                <StackPanel>
                    <!-- Single-value body -->
                    <Grid Visibility="{Binding IsSingleValue, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Type, Converter={StaticResource AdjustmentTypeLabelConverter}}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="Edit"
                                Style="{StaticResource TransparentHeaderActionButton}"
                                Click="EditSingleValueButton_Click"
                                Visibility="{Binding SingleValueAdjustment, Converter={StaticResource NotNullToVisibility}}"
                                Margin="0,0,4,0" />
                        <!-- TargetNullValue: a category with no PayrollAdjustment row at all for
                             this employee/period reads 0.00 rather than as an empty box. That is
                             SSS/PhilHealth/Pag-IBIG for an employee who does not contribute:
                             their Employee default is 0.00, and PayrollComputationService's own
                             DetermineContributionChanges deliberately seeds no row in that case
                             ("EmployeeDefault <= 0 and not BlankAmountMeansZero" skips outright),
                             which left the box blank while every other category showed a figure.
                             Display only. Null still means "no row" everywhere it actually
                             matters: the Edit button's own Visibility above still keys off
                             SingleValueAdjustment, nothing here writes a 0.00 row that the
                             payslip and Excel export would then start printing, and tabbing
                             through an untouched box commits nothing (NumericTextBox raises
                             ValueCommitted only on an actual change, so the displayed 0.00 is
                             the baseline it compares against). -->
                        <controls:NumericTextBox Grid.Column="2"
                                                 Value="{Binding SingleValueAmount, Mode=OneWay, TargetNullValue=0}"
                                                 Style="{StaticResource EditableAmountTextBox}"
                                                 Margin="8,0,0,0"
                                                 ClearFocusOnEnter="True"
                                                 ValueCommitted="SingleValueAmountBox_ValueCommitted"
                                                 IsEnabled="{Binding ViewModel.CanEditAdjustmentsNow, RelativeSource={RelativeSource AncestorType=views:PayrollSummaryView}}" />
                    </Grid>

                    <!-- Inline-itemized body -->
                    <StackPanel Visibility="{Binding IsInlineItemized, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Type, Converter={StaticResource AdjustmentTypeLabelConverter}}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="+ Add Row"
                                    Style="{StaticResource TransparentHeaderActionButton}"
                                    Command="{Binding ViewModel.AddInlineRowCommand, RelativeSource={RelativeSource AncestorType=views:PayrollSummaryView}}"
                                    CommandParameter="{Binding Type}"
                                    Margin="0,0,4,0" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding Subtotal, Converter={StaticResource Number}, Mode=OneWay}"
                                     Style="{StaticResource ValueTextBox}"
                                     Margin="8,0,0,0" />
                        </Grid>
                        <!-- Focusable="False": ItemsControl is a Control (unlike Border/Grid/
                             StackPanel/TextBlock, none of which are Controls and so are never
                             focusable regardless), so IsTabStop defaults to true even though
                             this is a pure row-generation container with no interaction of its
                             own - left at the default, every one of these on this page eats a
                             stray Tab stop between the real TextBox/Button controls in the rows
                             it generates. ScrollViewer is a Control too but already defaults
                             IsTabStop to false, so it needed no such override; ItemsControl is
                             the one exception among the element types this page actually uses.
                             Every ItemsControl below sets this for the same reason. -->
                        <ItemsControl ItemsSource="{Binding Adjustments}"
                                      ItemTemplate="{StaticResource InlineAdjustmentRowTemplate}"
                                      Focusable="False" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="0,0,0,8">
        <!-- Employee name - same header role AttendanceView's summary tab and Schedule's
             calendar give the currently selected employee. Period pickers, Print Current
             Payslip/Print Payslips, and the busy indicator all moved up to PayrollPage.xaml's
             own page-level CardBorder (see that file) - same "command row sits right below
             the tab, above the tree+content split" pattern SchedulePage/EmployeesPage/
             AttendanceView already use, which this tab wasn't following (those buttons used
             to live down here instead, confined to just this UserControl's own column).
             A DockPanel rather than the plain horizontal StackPanel this used to be - the
             Refresh button below needs to dock against the row's own right edge regardless
             of how wide HeaderText/the Pay Type badge happen to be, which a StackPanel has
             no way to express (its children just line up left to right, one after another).
             LastChildFill="False" so nothing here stretches to fill the gap in between -
             HeaderText/the badge dock Left in the order they're declared, Refresh docks
             Right, and the space between the two sides just stays empty, the same "label on
             one side, action on the other" shape PayrollPage's own Included/Not-in-group
             card headers already use elsewhere on this tab. -->
        <DockPanel DockPanel.Dock="Top"
                   Margin="0,0,0,8"
                   LastChildFill="False">
            <TextBlock x:Name="HeaderText"
                       DockPanel.Dock="Left"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />

            <!-- Pay Type badge - SelectedEmployee.EmployeeType, already display-ready
                 (Daily/Monthly). Hidden with no employee selected, rather than showing next
                 to the "Select an employee" placeholder HeaderText falls back to. -->
            <Border x:Name="PayTypeBadge"
                    DockPanel.Dock="Left"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6,2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center">
                <TextBlock x:Name="PayTypeText"
                           Style="{StaticResource CaptionTextStyle}"
                           FontSize="11"
                           FontWeight="SemiBold" />
            </Border>

            <!-- Recalculate/refresh this employee's payslip on demand - the per-employee
                 replacement for the payroll group panel's own manual "Reload" button (see
                 PayrollGroupViewModel's doc comments for why that one was removed), living
                 right next to the payslip it actually recalculates instead of off in the
                 group grid's own header. Icon-only (the "Refresh" glyph, U+E72C) rather
                 than a text button, since this is a single, self-explanatory action sitting
                 in a header row that's already tight on space. Same NotNullToVisibility toggle as the Pay Type badge above
                 - there's nothing to recalculate with no employee selected, so this
                 disappears right alongside it.

                 Doubles as a Cancel button while anything's running (see
                 RefreshOrCancelPayslipCommand/RefreshOrCancelGlyph/RefreshOrCancelToolTip
                 on PayrollSummaryViewModel) - same in-place Refresh<->Cancel toggle as
                 AttendanceSummaryView's own Period-row button, rather than just sitting
                 disabled with no way to stop a recalculation once started. -->
            <syncfusion:ButtonAdv x:Name="RefreshOrCancelButton"
                                  DockPanel.Dock="Right"
                                  SizeMode="Small"
                                  IconTemplate="{StaticResource TagGlyphIconTemplate}" />
        </DockPanel>

        <!-- Empty-state placeholder and the itemized breakdown occupy the same Grid cell,
             toggled by mutually-exclusive Visibility bindings (Result is null exactly when
             EmptyStateMessage isn't - see PayrollSummaryViewModel's doc comments on each), rather
             than being separate DockPanel children - a DockPanel's LastChildFill only fills
             for whichever element is *literally* last in this collection, regardless of which
             one is actually Visible at a given moment, so keeping both inside one Grid (the
             genuine last DockPanel child) is what lets whichever one is showing actually fill
             the remaining space the original placeholder Border relied on. -->
        <Grid>
            <Border x:Name="EmptyStatePanel"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="0">
                <TextBlock x:Name="EmptyStateText"
                           Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <ScrollViewer x:Name="BreakdownPanel"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Gross Pay (left) / Deductions (right), side by side rather than
                         stacked - each column sized independently (VerticalAlignment="Top"
                         on both cards) since Gross Pay and Deductions rarely have the same
                         number of rows, so forcing equal heights would just leave one card
                         padded with empty space. Net Pay stays its own full-width strip
                         below both, same reasoning as before (see its own comment) - it's
                         the page's bottom line, not a third column. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Gross Pay -->
                        <Border Grid.Column="0"
                                Style="{StaticResource CardBorderStyle}"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Gross Pay"
                                               FontSize="15"
                                               FontWeight="Bold" />
                                    <TextBlock x:Name="TotalGrossPayText"
                                               Grid.Column="1"
                                               Style="{StaticResource AmountText}"
                                               FontSize="15"
                                               Padding="0,0,2,0"
                                               FontWeight="Bold" />
                                </Grid>
                                <ItemsControl x:Name="ComputedGrossPayList"
                                              ItemTemplate="{StaticResource LineItemTemplate}"
                                              Margin="0,0,0,4"
                                              Focusable="False" />
                                <ItemsControl x:Name="GrossPayGroupList"
                                              ItemTemplate="{StaticResource AdjustmentGroupTemplate}"
                                              Focusable="False" />
                            </StackPanel>
                        </Border>

                        <!-- Deductions, all in DeductionForegroundBrush -->
                        <Border Grid.Column="2"
                                Style="{StaticResource CardBorderStyle}"
                                TextElement.Foreground="{StaticResource DeductionForegroundBrush}"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Deductions"
                                               FontSize="15"
                                               FontWeight="Bold" />
                                    <TextBlock x:Name="TotalDeductionsText"
                                               Grid.Column="1"
                                               Style="{StaticResource AmountText}"
                                               FontSize="15"
                                               FontWeight="Bold" />
                                </Grid>
                                <!-- Same shape as the Gross Pay column's ComputedGrossPay ItemsControl
                                     above - LineItemTemplate's own SupportsWaiver check is what
                                     keeps the Exclude/Include toggle scoped to just Undertime, not this
                                     binding. -->
                                <ItemsControl x:Name="ComputedDeductionsList"
                                              ItemTemplate="{StaticResource LineItemTemplate}"
                                              Margin="0,0,0,4"
                                              Focusable="False" />
                                <ItemsControl x:Name="DeductionGroupList"
                                              ItemTemplate="{StaticResource AdjustmentGroupTemplate}"
                                              Focusable="False" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Net Pay - the one total that isn't inside a CardBorder-styled card,
                         since it's the page's own bottom line rather than one section among
                         several; dark background makes it read as a summary strip rather than
                         another itemized card. Can legitimately show a negative figure (see
                         PayrollResult.NetPay's own doc comment, e.g. a Cash Advance bigger
                         than what was earned) - NumberConverter's plain "-1,234.56" already
                         says as much on its own, so this doesn't otherwise call it out further
                         (no red highlight). -->
                    <Border Background="#1E293B"
                            CornerRadius="4"
                            Padding="10,10"
                            Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Net Pay"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="NetPayText"
                                       Grid.Column="1"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</rxui:ReactiveUserControl>
