<controls:ReactiveAppWindow x:Class="ScheduleApp.Desktop.Views.AddToPayrollGroupDialog" ShowMinimizeButton="False"
        x:TypeArguments="vm:AddToPayrollGroupViewModel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
        xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels"
        Title="Add Employees to Group"
        Width="460" Height="560"
        MinWidth="380" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

    <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Check the employees to add to the current payroll group. Already-checked employees are those already in the group."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   Margin="0,0,0,10" />

        <!-- Search box - same comma-separated filter the wizard Step 2 uses. -->
        <syncfusion:SfTextBoxExt Grid.Row="1"
                                 x:Name="SearchBox"
                                 Watermark="ID, name or department"
                                 ToolTip="Comma-separated ID, name, or department terms."
                                 Margin="0,0,0,8" />

        <!-- Department/employee checkbox tree - same shape as wizard Step 2. Its items are
             the search's visible departments (AddToPayrollGroupViewModel.VisibleDepartments). -->
        <Border BorderThickness="1"
                BorderBrush="{DynamicResource CardBorderBrush}"
                Grid.Row="2">
            <syncfusion:SfTreeView x:Name="EmployeeTree"
                                   SelectionMode="None"
                                   ExpandActionTrigger="Node"
                                   FocusVisualStyle="{x:Null}">
                <syncfusion:SfTreeView.Resources>
                    <DataTemplate DataType="{x:Type vm:DepartmentGroupViewModel}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      IsThreeState="False"
                                      VerticalAlignment="Center"
                                      ToolTip="Include/exclude every employee in this department"
                                      Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:EmployeeNodeViewModel}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Employee.DisplayName}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPin}"
                                                         Value="False">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TertiaryForegroundBrush}" />
                                                <Setter Property="ToolTip"
                                                        Value="No Employee ID (Pin) set - payroll can't be computed until one is." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Optional per the Phase 4 plan (row 9) - badges Monthly-rated
                                 employees so they're visible while picking who to add to the
                                 group. Daily (the majority/default) gets no badge, same
                                 "flag the exception" reasoning as HasPin above. -->
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4,1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsMonthly, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Monthly"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedForegroundBrush}" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </syncfusion:SfTreeView.Resources>
                <syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                    <syncfusion:HierarchyPropertyDescriptor TargetType="{x:Type vm:DepartmentGroupViewModel}"
                                                            ChildPropertyName="VisibleEmployees"
                                                            IsExpandedPropertyName="IsExpanded" />
                </syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                <syncfusion:SfTreeView.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" Focusable="False" VerticalAlignment="Center" />
                    </DataTemplate>
                </syncfusion:SfTreeView.ItemTemplate>
            </syncfusion:SfTreeView>
        </Border>

        <!-- Selection count strip. -->
        <TextBlock Grid.Row="3"
                   x:Name="ScopeText"
                   FontSize="11"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,8" />

        <!-- Action buttons. -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <syncfusion:ButtonAdv Label="Cancel"
                                  IconTemplate="{StaticResource CancelIconTemplate}"
                                  IsCancel="True"
                                  Margin="0,0,8,0" />
            <syncfusion:ButtonAdv x:Name="AddButton"
                                  Label="Add Selected"
                                  IconTemplate="{StaticResource AddIconTemplate}"
                                  IsDefault="True" />
        </StackPanel>
    </Grid>
</Grid>
</controls:ReactiveAppWindow>
