<ui:FluentWindow x:Class="ScheduleApp.Desktop.Views.AddToPayrollGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels"
        Title="Add Employees to Group"
        Width="460" Height="560"
        MinWidth="380" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Department-level item: drives visibility (search) and expand state. -->
        <Style x:Key="DeptItemStyle" TargetType="TreeViewItem">
            <Setter Property="Visibility"
                    Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
            <Setter Property="IsExpanded"
                    Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>

        <!-- Employee-level item: visibility only (no expand). -->
        <Style x:Key="EmpItemStyle" TargetType="TreeViewItem">
            <Setter Property="Visibility"
                    Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- See MainWindow.xaml's own TitleBar comment for why every FluentWindow needs
             one of these - WPF-UI removes the native title bar entirely otherwise. -->
        <ui:TitleBar Grid.Row="0"
                Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                ShowMinimize="False"
                ShowMaximize="True"
                CanMaximize="True" />

    <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Check the employees to add to the current payroll group. Already-checked employees are those already in the group."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,10" />

        <!-- Search box - same comma-separated filter the wizard Step 2 uses. -->
        <TextBox Grid.Row="1"
                 x:Name="SearchBox"
                 TextChanged="SearchBox_OnTextChanged"
                 ToolTip="Comma-separated Employee ID, last name, first name, or department terms. Leave blank to show everyone."
                 Margin="0,0,0,8" />

        <!-- Department/employee checkbox tree - same shape as wizard Step 2. -->
        <TreeView Grid.Row="2"
                  x:Name="EmployeeTree"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  ItemContainerStyle="{StaticResource DeptItemStyle}">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type vm:DepartmentGroupViewModel}"
                                          ItemsSource="{Binding Employees}"
                                          ItemContainerStyle="{StaticResource EmpItemStyle}">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsSelected}"
                                  IsThreeState="False"
                                  VerticalAlignment="Center"
                                  ToolTip="Include/exclude every employee in this department"
                                  Margin="0,0,4,0" />
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                    </StackPanel>
                    <HierarchicalDataTemplate.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EmployeeNodeViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Employee.DisplayName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPin}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <Setter Property="ToolTip"
                                                            Value="No Employee ID (Pin) set - payroll can't be computed until one is." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Optional per the Phase 4 plan (row 9) - badges Monthly-rated
                                     employees so they're visible while picking who to add to the
                                     group. Daily (the majority/default) gets no badge, same
                                     "flag the exception" reasoning as HasPin above. -->
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsMonthly, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Monthly"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </HierarchicalDataTemplate.ItemTemplate>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- Selection count strip. -->
        <TextBlock Grid.Row="3"
                   x:Name="ScopeText"
                   FontSize="11"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,8" />

        <!-- Action buttons. -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    IsCancel="True"
                    Padding="8,3"
                    Margin="0,0,8,0" />
            <Button x:Name="AddButton"
                    Content="Add Selected"
                    IsDefault="True"
                    Padding="8,3"
                    Click="AddButton_Click" />
        </StackPanel>
    </Grid>
</Grid>
</ui:FluentWindow>
