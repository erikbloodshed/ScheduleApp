<ui:FluentWindow x:Class="ScheduleApp.Desktop.Views.PayslipScopeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels"
        Width="500" Height="600"
        MinWidth="440" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Applies to both Period pickers below via implicit TargetType match (no
             x:Key needed - this dialog has no other DatePicker to accidentally catch).
             Full "MMMM d, yyyy" month name (e.g. "September 16, 2026") rather than the
             short default date, matching AttendanceView.xaml/PayrollPage.xaml's own
             Period pickers - see those files' own copy of this style. Each DatePicker's
             own Width below is widened to fit the longer text. -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <TextBox Text="{Binding Path=SelectedDate,
                            RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, StringFormat='{}{0:MMMM d, yyyy}'}"
                                 TextAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same two-style split as AttendanceView.xaml's own report-scope tree -
             TreeView.ItemContainerStyle only reaches the root (department) level;
             the nested employee level is styled via the HierarchicalDataTemplate's
             own ItemContainerStyle instead. -->
        <Style x:Key="PayslipScopeDepartmentItemStyle"
               TargetType="TreeViewItem">
            <Setter Property="Visibility"
                    Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
            <Setter Property="IsExpanded"
                    Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>

        <Style x:Key="PayslipScopeEmployeeItemStyle"
               TargetType="TreeViewItem">
            <Setter Property="Visibility"
                    Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- See MainWindow.xaml's own TitleBar comment for why every FluentWindow needs
             one of these - WPF-UI removes the native title bar entirely otherwise. -->
        <ui:TitleBar Grid.Row="0"
                Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                ShowMinimize="False"
                ShowMaximize="True"
                CanMaximize="True" />

    <Grid Grid.Row="1" Margin="16"
          RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <TextBlock x:Name="DescriptionText"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,12" />

        <!-- Period pickers - plain named controls, not bound to
             PayslipScopeViewModel (which has no period of its own), read
             directly in code-behind on Print click, same pattern
             ManualLogEntryDialog uses for its own fields. Defaults to the
             Payroll tab's current period - see this dialog's own constructor. -->
        <Grid Grid.Row="1"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Period"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />
            <DatePicker x:Name="PeriodStartPicker"
                        Grid.Column="1"
                        IsTodayHighlighted="True"
                        Width="190"
                        Margin="0,0,6,0" />
            <TextBlock Grid.Column="2"
                       Text="to"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />
            <DatePicker x:Name="PeriodEndPicker"
                        Grid.Column="3"
                        IsTodayHighlighted="True"
                        Width="190" />
        </Grid>

        <!-- Live filter for the tree below - same comma-separated Employee
             ID/last name/first name/department matching as
             ReportScopeViewModel.SearchText (see EmployeeTreeSearchFilter,
             shared between both). -->
        <StackPanel Grid.Row="2"
                    Margin="0,0,0,8">
            <TextBlock Text="Search"
                       FontSize="11"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,4" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Comma-separated Employee ID, last name, first name, or department terms to narrow the tree to (e.g. &quot;342, Cruz, Kitchen&quot;). Leave blank to show everyone -- this only changes what's shown, not what's checked." />
        </StackPanel>

        <!-- Department/Employee checkbox tree - adapted from
             ReportScopeViewModel/AttendanceView.xaml's own report-scope tree
             (see PayslipScopeViewModel's own doc comment). Every employee
             starts checked (whole company); checking a department checks
             everyone in it; unchecking individuals narrows further. -->
        <TreeView Grid.Row="3"
                  ItemsSource="{Binding Departments}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  ItemContainerStyle="{StaticResource PayslipScopeDepartmentItemStyle}">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type vm:DepartmentGroupViewModel}"
                                          ItemsSource="{Binding Employees}"
                                          ItemContainerStyle="{StaticResource PayslipScopeEmployeeItemStyle}">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsSelected}"
                                  IsThreeState="False"
                                  VerticalAlignment="Center"
                                  ToolTip="Include/exclude every employee in this department"
                                  Margin="0,0,4,0" />
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="Bold" />
                    </StackPanel>
                    <HierarchicalDataTemplate.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EmployeeNodeViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Employee.DisplayName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPin}"
                                                             Value="False">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <Setter Property="ToolTip"
                                                            Value="No Employee ID (Pin) set for this person -- payroll can't be computed until one is. Set it in the Add/Edit Employee dialog on the Schedule tab." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Optional per the Phase 4 plan (row 9) - same Monthly badge
                                     as AddToPayrollGroupDialog's tree, same reasoning. -->
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsMonthly, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Monthly"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </HierarchicalDataTemplate.ItemTemplate>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <StackPanel Grid.Row="4"
                    Margin="0,8,0,0">
            <TextBlock Text="{Binding SelectionScopeText}"
                       FontSize="11"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Select All"
                        Command="{Binding SelectAllTreeCommand}"
                        Padding="8,3"
                        Margin="0,0,6,0" />
                <Button Content="Clear"
                        Command="{Binding ClearTreeSelectionCommand}"
                        Padding="8,3" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="ConfirmButton"
                    Width="90"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="ConfirmButton_Click" />
            <Button Content="Cancel"
                    Width="80"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Grid>
</ui:FluentWindow>
