<controls:ReactiveAppWindow x:Class="ScheduleApp.Desktop.Views.PayslipScopeDialog" ShowMinimizeButton="False"
        x:TypeArguments="vm:PayslipScopeViewModel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
        xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels"
        Width="500" Height="600"
        MinWidth="440" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

    <Grid Grid.Row="1" Margin="16"
          RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <TextBlock x:Name="DescriptionText"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   Margin="0,0,0,12" />

        <!-- Period pickers - bound to PayslipScopeViewModel.PeriodStart/PeriodEnd,
             which start at the Payroll tab's current period (see this dialog's own
             constructor) and are checked by its AcceptCommand. -->
        <Grid Grid.Row="1"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Period"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />
            <syncfusion:DateTimeEdit x:Name="PeriodStartPicker"
                                     Grid.Column="1"
                                     Width="190"
                                     Margin="0,0,6,0" />
            <TextBlock Grid.Column="2"
                       Text="to"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />
            <syncfusion:DateTimeEdit x:Name="PeriodEndPicker"
                                     Grid.Column="3"
                                     Width="190" />
        </Grid>

        <!-- Live filter for the tree below - same comma-separated Employee
             ID/last name/first name/department matching as
             ReportScopeViewModel.SearchText (see EmployeeTreeSearchFilter,
             shared between both). -->
        <StackPanel Grid.Row="2"
                    Margin="0,0,0,8">
            <TextBlock Text="Search"
                       FontSize="11"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       Margin="0,0,0,4" />
            <syncfusion:SfTextBoxExt x:Name="SearchBox"
                                     Watermark="ID, name or department"
                                     ToolTip="Comma-separated ID, name, or department terms (e.g. &quot;342, Cruz, Kitchen&quot;) -- narrows what's shown, not what's checked." />
        </StackPanel>

        <!-- Department/Employee checkbox tree - adapted from
             ReportScopeViewModel/AttendanceView.xaml's own report-scope tree
             (see PayslipScopeViewModel's own doc comment). Every employee
             starts checked (whole company); checking a department checks
             everyone in it; unchecking individuals narrows further. SfTreeView
             can't hide a row, so it binds to the search's VisibleDepartments and
             each department's VisibleEmployees. -->
        <Border BorderThickness="1"
                BorderBrush="{DynamicResource CardBorderBrush}"
                Grid.Row="3">
            <syncfusion:SfTreeView x:Name="EmployeeTree"
                                   SelectionMode="None"
                                   ExpandActionTrigger="Node"
                                   FocusVisualStyle="{x:Null}">
                <syncfusion:SfTreeView.Resources>
                    <DataTemplate DataType="{x:Type vm:DepartmentGroupViewModel}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      IsThreeState="False"
                                      VerticalAlignment="Center"
                                      ToolTip="Include/exclude every employee in this department"
                                      Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:EmployeeNodeViewModel}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Employee.DisplayName}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPin}"
                                                         Value="False">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TertiaryForegroundBrush}" />
                                                <Setter Property="ToolTip"
                                                        Value="No Employee ID (Pin) set for this person -- payroll can't be computed until one is. Set it in the Add/Edit Employee dialog on the Schedule tab." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Optional per the Phase 4 plan (row 9) - same Monthly badge
                                 as AddToPayrollGroupDialog's tree, same reasoning. -->
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4,1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsMonthly, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Monthly"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedForegroundBrush}" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </syncfusion:SfTreeView.Resources>
                <syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                    <syncfusion:HierarchyPropertyDescriptor TargetType="{x:Type vm:DepartmentGroupViewModel}"
                                                            ChildPropertyName="VisibleEmployees"
                                                            IsExpandedPropertyName="IsExpanded" />
                </syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                <syncfusion:SfTreeView.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" Focusable="False" VerticalAlignment="Center" />
                    </DataTemplate>
                </syncfusion:SfTreeView.ItemTemplate>
            </syncfusion:SfTreeView>
        </Border>

        <StackPanel Grid.Row="4"
                    Margin="0,8,0,0">
            <TextBlock x:Name="ScopeText"
                       FontSize="11"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <syncfusion:ButtonAdv x:Name="SelectAllButton"
                                      Label="Select All"
                                      IconTemplate="{StaticResource SelectAllIconTemplate}"
                                      Margin="0,0,6,0" />
                <syncfusion:ButtonAdv x:Name="ClearButton"
                                      Label="Clear"
                                      IconTemplate="{StaticResource ClearSelectionIconTemplate}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <syncfusion:ButtonAdv x:Name="ConfirmButton"
                                  IconTemplate="{StaticResource ApplyIconTemplate}"
                                  MinWidth="90"
                                  Margin="0,0,8,0"
                                  IsDefault="True" />
            <syncfusion:ButtonAdv Label="Cancel"
                                  IconTemplate="{StaticResource CancelIconTemplate}"
                                  MinWidth="80"
                                  IsCancel="True" />
        </StackPanel>
    </Grid>
</Grid>
</controls:ReactiveAppWindow>
