<UserControl x:Class="ScheduleApp.Desktop.Views.ManualEntriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ScheduleApp.Desktop.Converters">
    <!-- One of three views the "Attendance" drawer item's submenu navigates between - see
         AttendanceSummaryView.xaml's own doc comment for the shared AttendanceViewModel/
         page-navigation story all three follow. This one used to be the "Manual Entries"
         TabItem inside a single AttendanceView/AttendancePage; its own content - scoped by
         date range, reading ManualAttendanceLogs rather than AttendanceLogs - is unchanged
         by the split (see ManualEntriesViewModel's own doc comment for why it was always
         kept separate from Punch Records, even before this page split). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="10"
          RowDefinitions="Auto,Auto,*">
        <DockPanel Grid.Row="0"
                   LastChildFill="False"
                   Margin="0,0,0,10">
            <!-- Cancel pinned to the right of the toolbar row, shown only while something's
                 running (Load/Import/Export/Fetch, or a manual entry save-delete - any of
                 which may have been started from another Attendance page; see
                 PunchRecordsView.xaml's own copy of this strip for the "one Cancel per page"
                 reasoning). Inline here, not in its own card, so it appearing doesn't push
                 the whole grid down - and docked right of the left-docked toolbar so it
                 doesn't nudge the period picker or buttons either. -->
            <Button DockPanel.Dock="Right"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Padding="8,3"
                    Visibility="{Binding IsVisiblyRunning, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="Stop whatever's currently running (Load, Import, an Import/Fetch started from Punch Records, or a manual entry save/delete)." />
            <StackPanel DockPanel.Dock="Left"
                        Orientation="Horizontal">
            <TextBlock Text="Start"
                       Width="40"
                       VerticalAlignment="Center" />
            <!-- Steps ManualEntriesStart/ManualEntriesEnd to the adjacent
                 cut-off period and reloads immediately; see
                 ManualEntriesViewModel.PreviousPeriodAsync. -->
            <Button Content="◀"
                    Command="{Binding PreviousManualEntriesPeriodCommand}"
                    Padding="8,3"
                    Margin="0,0,6,0"
                    ToolTip="Previous cut-off period." />
            <DatePicker SelectedDate="{Binding ManualEntriesStart}"
                        Width="190"
                        Margin="0,0,24,0">
                <DatePicker.Resources>
                    <Style TargetType="DatePickerTextBox">
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DatePickerTextBox">
                                    <!-- Overriding the text binding to apply the custom string format -->
                                    <TextBox Text="{Binding Path=SelectedDate,
                                            RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, StringFormat='{}{0:MMMM d, yyyy}'}"
                                             TextAlignment="Center" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DatePicker.Resources>
            </DatePicker>
            <TextBlock Text="End"
                       Width="32"
                       VerticalAlignment="Center" />
            <DatePicker SelectedDate="{Binding ManualEntriesEnd}"
                        Width="190"
                        Margin="0,0,6,0">
                <DatePicker.Resources>
                    <Style TargetType="DatePickerTextBox">
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DatePickerTextBox">
                                    <!-- Overriding the text binding to apply the custom string format -->
                                    <TextBox Text="{Binding Path=SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, StringFormat='{}{0:MMMM d, yyyy}'}"
                                             TextAlignment="Center" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DatePicker.Resources>
            </DatePicker>
            <!-- See PreviousManualEntriesPeriodCommand's own comment above;
                 NextManualEntriesPeriodCommand is the same step in the other
                 direction. -->
            <Button Content="▶"
                    Command="{Binding NextManualEntriesPeriodCommand}"
                    Padding="8,3"
                    Margin="0,0,18,0"
                    ToolTip="Next cut-off period." />
            <Button Content="↻ Refresh"
                    Command="{Binding LoadManualEntriesCommand}"
                    Padding="8,3"
                    Margin="0,0,6,0" />
            <Button Content="Add Manual Entry…"
                    Command="{Binding AddManualEntryCommand}"
                    Padding="8,3"
                    ToolTip="Log a punch by hand for an employee who forgot to clock in/out -- stored separately from device
                             punches and only used to fill in a clock-in/out the device has nothing for. Shows up only in
                             this Manual Entries grid, not in Punch Records -- but is still included when generating an
                             attendance summary." />
            <Button Content="Export…"
                    Command="{Binding ExportManualEntriesCommand}"
                    Padding="8,3"
                    Margin="12,0,0,0"
                    ToolTip="Choose where to save the manual entries in range as an Excel file, including Reason and Entered By -- the two columns Punch Records no longer shows." />
            <Button Content="Open"
                    Command="{Binding OpenManualEntriesExportCommand}"
                    Padding="8,3"
                    Margin="6,0,0,0" />
            <Button Content="Import…"
                    Command="{Binding ImportManualEntriesCommand}"
                    Padding="8,3"
                    Margin="12,0,0,0"
                    ToolTip="Choose an Excel workbook and bulk-add every row in it as a manual entry -- for a whole batch of forgotten punches at once instead of Add Manual Entry one at a time. Expects the same columns Export… writes (Id, Date, Time, Punch Type, Reason, Entered By), so exporting first and reusing that file as a template is the easiest way to build one. The whole file is validated before anything is added -- if any row has a problem, none of them are." />
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1"
                   Margin="0,0,0,6"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding HasLoadedManualEntries, Converter={StaticResource BoolToVisibility}}">
            <Run Text="{Binding ManualEntriesCount, Mode=OneWay}"
                 FontWeight="Bold" />
            <Run Text="manual entry(ies) found in range." />
        </TextBlock>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding ManualEntries}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PIN"
                                    Binding="{Binding EmployeeId}"
                                    Width="90" />
                <DataGridTextColumn Header="Employee Name"
                                    Binding="{Binding EmployeeName}"
                                    Width="200" />
                <DataGridTextColumn Header="Department"
                                    Binding="{Binding DepartmentName}"
                                    Width="140" />
                <DataGridTextColumn Header="Date"
                                    Binding="{Binding Timestamp, StringFormat={}{0:MM/dd/yyyy}}"
                                    Width="100" />
                <DataGridTextColumn Header="Time"
                                    Binding="{Binding Timestamp, StringFormat={}{0:hh:mm tt}}"
                                    Width="90" />
                <DataGridTextColumn Header="Type"
                                    Binding="{Binding PunchTypeText}"
                                    Width="90" />
                <DataGridTextColumn Header="Reason"
                                    Binding="{Binding Reason}"
                                    Width="200" />
                <DataGridTextColumn Header="Imported"
                                    Binding="{Binding ImportedAt, StringFormat={}{0:MM/dd/yyyy h:mm tt}}"
                                    Width="*" />
                <DataGridTemplateColumn Header=""
                                        Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Every row here is a manual entry by construction (this
                                 grid never shows device punches), so unlike Punch
                                 Records' template, no IsManual-gated Visibility is
                                 needed - both buttons are always shown. -->
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Edit"
                                        Padding="6,2"
                                        FontSize="11"
                                        Margin="0,0,4,0"
                                        Command="{Binding DataContext.EditManualEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Delete"
                                        Padding="6,2"
                                        FontSize="11"
                                        Command="{Binding DataContext.DeleteManualEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Text="No manual entries in range -- use Add Manual Entry… above, or on Punch Records' Punches toolbar, or widen the date range."
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding HasLoadedManualEntries, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>
