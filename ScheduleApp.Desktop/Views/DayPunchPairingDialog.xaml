<controls:ReactiveAppWindow x:Class="ScheduleApp.Desktop.Views.DayPunchPairingDialog" ShowMinimizeButton="False"
        x:TypeArguments="attendance:DayPunchPairingEditorViewModel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
        xmlns:attendance="clr-namespace:ScheduleApp.Desktop.ViewModels.Attendance"
        Width="450" Height="510"
        MinWidth="410" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

    <Grid Grid.Row="1" RowDefinitions="*,Auto">
        <controls:DayPunchPairingEditor x:Name="Editor" Grid.Row="0" />

        <Border Grid.Row="1" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <!-- Only offered for a day that actually has a saved pairing to clear.
                     See DayPunchPairingEditorViewModel.HasSavedOverride. -->
                <syncfusion:ButtonAdv x:Name="ResetButton"
                                      Grid.Column="0"
                                      Label="Reset to Automatic"
                                      IconTemplate="{StaticResource RefreshIconTemplate}" />

                <!-- Save is collapsed on a day whose pairing the calculation never
                     reads back. See DayPunchPairingEditorViewModel.ShowsSave. -->
                <syncfusion:ButtonAdv x:Name="SaveButton"
                                      Grid.Column="2" Label="Save" Width="90" IsDefault="True"
                                      IconTemplate="{StaticResource SaveIconTemplate}"
                                      Margin="0,0,8,0" />
                <syncfusion:ButtonAdv x:Name="CancelButton"
                                      Grid.Column="3" Label="Cancel" Width="90" IsCancel="True"
                                      IconTemplate="{StaticResource CancelIconTemplate}" />
            </Grid>
        </Border>
    </Grid>
</Grid>
</controls:ReactiveAppWindow>
