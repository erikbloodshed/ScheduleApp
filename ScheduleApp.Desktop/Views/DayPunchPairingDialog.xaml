<controls:AppWindow x:Class="ScheduleApp.Desktop.Views.DayPunchPairingDialog" ShowMinimizeButton="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
        Title="Edit Punch Pairing"
        Width="450" Height="510"
        MinWidth="410" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
>
    <!-- Ctrl+Z on the window, not the editor UserControl, so the gesture works
         wherever focus sits. DataContext here is the editor view model (set in the
         dialog's constructor), so UndoCommand resolves; no free-text box in the grid
         claims the key first. -->
    <controls:AppWindow.InputBindings>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}" />
    </controls:AppWindow.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

    <Grid Grid.Row="1" RowDefinitions="*,Auto">
        <controls:DayPunchPairingEditor Grid.Row="0" DataContext="{Binding}" />

        <Border Grid.Row="1" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <!-- Only offered for a day that actually has a saved pairing to clear.
                     See DayPunchPairingEditorViewModel.HasSavedOverride. -->
                <Button x:Name="ResetButton"
                        Grid.Column="0"
                        Content="Reset to Automatic"
                        Padding="12,5"
                        Click="ResetButton_Click" />

                <!-- Save is collapsed on a day whose pairing the calculation never
                     reads back. See the constructor. -->
                <Button x:Name="SaveButton"
                        Grid.Column="2" Content="Save" Width="90" IsDefault="True"
                        Margin="0,0,8,0" Click="SaveButton_Click" />
                <Button x:Name="CancelButton"
                        Grid.Column="3" Content="Cancel" Width="90" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Grid>
</controls:AppWindow>
