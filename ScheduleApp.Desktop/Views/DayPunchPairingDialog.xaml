<Window x:Class="ScheduleApp.Desktop.Views.DayPunchPairingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
        Title="Edit Punch Pairing"
        Width="450" Height="510"
        MinWidth="410" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid RowDefinitions="*,Auto">
        <controls:DayPunchPairingEditor Grid.Row="0" DataContext="{Binding}" />

        <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <!-- Only offered for a day that actually has a saved pairing to clear.
                     See DayPunchPairingEditorViewModel.HasSavedOverride. -->
                <Button x:Name="ResetButton"
                        Grid.Column="0"
                        Content="Reset to Automatic"
                        Padding="12,5"
                        Click="ResetButton_Click" />

                <Button Grid.Column="2" Content="Save" Width="90" IsDefault="True"
                        Margin="0,0,8,0" Click="SaveButton_Click" />
                <Button Grid.Column="3" Content="Cancel" Width="90" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
