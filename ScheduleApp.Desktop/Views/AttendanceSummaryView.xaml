<rxui:ReactiveUserControl x:Class="ScheduleApp.Desktop.Views.AttendanceSummaryView"
             x:TypeArguments="vm:AttendanceViewModel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rxui="http://reactiveui.net"
             xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels"
             xmlns:coreAttendance="clr-namespace:ScheduleApp.Core.Attendance;assembly=ScheduleApp.Core"
             xmlns:converters="clr-namespace:ScheduleApp.Desktop.Converters">
    <!-- One of three views the "Attendance" drawer item's sub-items navigate between (see
         MainWindow.xaml's Summary/Punch Records/Manual Entries items, and
         AttendanceSummaryPage.xaml.cs). All three share one AttendanceViewModel (DI-Scoped to
         the app's one lifetime scope - see App.xaml.cs's own comment on that registration), so
         switching between them keeps whatever was already loaded rather than re-querying the
         database; see AttendanceViewModel.EnsureInitializedAsync/ActivateSummaryTab for how a
         page navigation drives what a tab selection used to. -->
    <UserControl.Resources>
        <converters:PunchStatusToRowBackgroundBrushConverter x:Key="StatusToRowBackground" />
        <converters:PunchStatusToTextConverter x:Key="StatusToText" />

        <!-- Strips all Button chrome down to just its content, so a status tile in the counts
             strip below still looks like the plain label+count pair it is; only the hand
             cursor hints that it's clickable. Deliberately a plain WPF Button: it's a tile,
             not a button to look at. -->
        <Style x:Key="StatusCountButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A PunchStatus tile in the counts strip: the status's name and count, in its
             colour (StatusToBrush). Its CommandParameter is the status and its Content the
             count; everything else follows from those. Clicking it narrows the Summary grid
             below (SummaryRowsView) to that status in place - see ReportViewModel.
             ShowStatusDetail/SelectedStatusFilter - and a second click (or Clear Filter) shows
             every status again. The tile lights up while its status is the active filter
             (bound in code-behind). -->
        <Style x:Key="StatusTileButton" TargetType="Button" BasedOn="{StaticResource StatusCountButton}">
            <Setter Property="Foreground"
                    Value="{Binding CommandParameter, RelativeSource={RelativeSource Self}, Converter={StaticResource StatusToBrush}}" />
            <Setter Property="ToolTip">
                <Setter.Value>
                    <Binding Path="CommandParameter"
                             RelativeSource="{RelativeSource Self}"
                             Converter="{StaticResource StatusToText}"
                             ConverterParameter="Filter to {0} only -- click again to show everyone." />
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" Padding="6,3" Background="{TemplateBinding Background}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CommandParameter, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StatusToText}}" />
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontWeight="Bold" Margin="4,0,0,0" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <!-- No separate "something's running" Cancel bar above this Grid (see
             AttendanceBusyState): the icon-only Refresh button in the Period row below (see
             RefreshOrCancelSummaryCommand) doubles as the Cancel button in place, so nothing
             above it ever moves. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="275" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Report scope tree - same Department/Employee shape as the Schedule tab's tree
             (see EmployeeTreeBuilder), but checkboxes are always on here, since scoping a
             report is this tree's only job. Every employee starts checked = whole company;
             un-checking a department un-checks every employee in it; un-checking individuals
             narrows further. See ReportScopeViewModel.SelectionScopeText and GetSelectedPins.
             Checking/un-checking a box here also re-runs the report itself, same as editing a
             Period date below; see ReportViewModel.TryAutoRun. -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top"
                       Text="Report Scope"
                       FontWeight="Bold"
                       FontSize="13"
                       Margin="2,0,0,8" />

            <!-- Live filter for the tree below, same comma-separated Employee ID/last
                 name/first name/department matching as the Punch Records tab's search box
                 (see ReportScopeViewModel.SearchText) - narrows which nodes are visible, not
                 which are checked, so typing here never changes what a report would actually
                 include. -->
            <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                <TextBlock Text="Search" Style="{StaticResource GroupLabelStyle}" Margin="0,0,0,4" />
                <syncfusion:SfTextBoxExt x:Name="ScopeSearchBox"
                                         Watermark="ID, name or department"
                                         ToolTip="Comma-separated ID, name, or department terms (e.g. &quot;342, Cruz, Kitchen&quot;) -- narrows what's shown, not what's checked." />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="2,8,0,0">
                <TextBlock x:Name="ScopeText"
                           Style="{StaticResource CaptionTextStyle}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <syncfusion:ButtonAdv x:Name="SelectAllButton"
                                          Label="Select All"
                                          IconTemplate="{StaticResource SelectAllIconTemplate}"
                                          Margin="0,0,6,0"
                                          ToolTip="Check every employee -- the whole-company default." />
                    <syncfusion:ButtonAdv x:Name="ClearSelectionButton"
                                          Label="Clear"
                                          IconTemplate="{StaticResource ClearSelectionIconTemplate}"
                                          Margin="0,0,6,0"
                                          ToolTip="Uncheck everyone, so you can hand-pick specific employees or departments." />
                    <syncfusion:ButtonAdv x:Name="ReloadTreeButton"
                                          Label="Refresh"
                                          IconTemplate="{StaticResource RefreshIconTemplate}"
                                          ToolTip="Reload the employee list -- resets checkboxes back to everyone checked." />
                </StackPanel>
            </StackPanel>

            <!-- Bound to VisibleDepartments and each department's VisibleEmployees, which the
                 search box above keeps filtered (EmployeeTreeSearchFilter) - SfTreeView can't
                 hide a row itself. -->
            <Border BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="4">
                <syncfusion:SfTreeView x:Name="ScopeTree"
                                       SelectionMode="None"
                                       ExpandActionTrigger="Node"
                                       FocusVisualStyle="{x:Null}">
                    <syncfusion:SfTreeView.Resources>
                        <DataTemplate DataType="{x:Type vm:DepartmentGroupViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          IsThreeState="False"
                                          VerticalAlignment="Center"
                                          ToolTip="Include/exclude every employee in this department"
                                          Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:EmployeeNodeViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Employee.DisplayName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:SfTreeView.Resources>
                    <syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                        <syncfusion:HierarchyPropertyDescriptor TargetType="{x:Type vm:DepartmentGroupViewModel}"
                                                                ChildPropertyName="VisibleEmployees"
                                                                IsExpandedPropertyName="IsExpanded" />
                    </syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                    <syncfusion:SfTreeView.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" Focusable="False" VerticalAlignment="Center" />
                        </DataTemplate>
                    </syncfusion:SfTreeView.ItemTemplate>
                </syncfusion:SfTreeView>
            </Border>
        </DockPanel>

        <!-- Right: period, results status strip, and the summary grid. There's no "Generate
             Reports" button - changing either Period date below, or a checkbox in the Report
             Scope tree at left, re-runs the report by itself (see ReportViewModel.TryAutoRun). -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="Period" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <!-- Steps PeriodStart/PeriodEnd to the adjacent cut-off (1st-15th /
                         16th-end of month) either side of whatever's currently set; see
                         ReportViewModel.PreviousPeriod. Setting both properties still routes
                         through TryAutoRun same as editing either date. -->
                    <syncfusion:ButtonAdv x:Name="PreviousPeriodButton"
                                          SizeMode="Small"
                                          Tag="&#xE76B;"
                                          IconTemplate="{StaticResource TagGlyphIconTemplate}"
                                          Margin="0,0,6,0"
                                          ToolTip="Previous cut-off period." />
                    <syncfusion:DateTimeEdit x:Name="PeriodStartPicker" Width="190" Margin="0,0,6,0" />
                    <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <syncfusion:DateTimeEdit x:Name="PeriodEndPicker" Width="190" Margin="0,0,6,0" />
                    <syncfusion:ButtonAdv x:Name="NextPeriodButton"
                                          SizeMode="Small"
                                          Tag="&#xE76C;"
                                          IconTemplate="{StaticResource TagGlyphIconTemplate}"
                                          Margin="0,0,8,0"
                                          ToolTip="Next cut-off period." />
                    <!-- Disabled rather than hidden while there's no result to export, the
                         same CanExecute-driven greying every other command button on this
                         page uses. -->
                    <syncfusion:ButtonAdv x:Name="ExportSummaryButton"
                                          Label="Export Summary…"
                                          IconTemplate="{StaticResource ExportIconTemplate}"
                                          ToolTip="Save the attendance summary to Excel -- opens automatically." />
                </StackPanel>

                <!-- Manual fallback for the auto-refresh every Period/tree edit already
                     triggers (see ReportViewModel.RefreshSummaryAsync's own doc comment for the
                     exact gap this closes), pinned to the row's right edge. Doubles as the
                     page's Cancel button while anything is running (see
                     ReportViewModel.RefreshOrCancelSummaryCommand). -->
                <syncfusion:ButtonAdv x:Name="RefreshOrCancelButton"
                                      DockPanel.Dock="Right"
                                      SizeMode="Small"
                                      IconTemplate="{StaticResource TagGlyphIconTemplate}" />
            </DockPanel>

            <!-- Status counts + Clear Filter, one slim strip. -->
            <Border x:Name="CountsCard"
                    Grid.Row="1"
                    Style="{StaticResource CardBorderStyle}">
                <DockPanel>
                    <!-- Only shows once a status tile has narrowed the grid - same effect as
                         clicking that same tile a second time. Docked before the tiles so it
                         always gets its width; the tiles wrap in what's left. -->
                    <syncfusion:ButtonAdv x:Name="ClearFilterButton"
                                          DockPanel.Dock="Right"
                                          Label="Clear Filter"
                                          IconTemplate="{StaticResource CancelIconTemplate}"
                                          VerticalAlignment="Top"
                                          ToolTip="Show every status in the summary grid again." />
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Total punches" Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBlock x:Name="TotalLogsText" FontWeight="Bold" Margin="4,0,20,0" />

                        <Button x:Name="CompleteTile" Style="{StaticResource StatusTileButton}" CommandParameter="{x:Static coreAttendance:PunchStatus.Complete}" />
                        <Button x:Name="PartialTile" Style="{StaticResource StatusTileButton}" CommandParameter="{x:Static coreAttendance:PunchStatus.Partial}" />
                        <Button x:Name="AbsentTile" Style="{StaticResource StatusTileButton}" CommandParameter="{x:Static coreAttendance:PunchStatus.Absent}" />
                        <Button x:Name="LeaveTile" Style="{StaticResource StatusTileButton}" CommandParameter="{x:Static coreAttendance:PunchStatus.Leave}" />
                        <Button x:Name="OfficialBusinessTile" Style="{StaticResource StatusTileButton}" CommandParameter="{x:Static coreAttendance:PunchStatus.OfficialBusiness}" />
                        <Button x:Name="RestDayTile" Style="{StaticResource StatusTileButton}" CommandParameter="{x:Static coreAttendance:PunchStatus.RestDay}" />

                        <!-- Unlike the six StatusTileButtons above, these two aren't
                             PunchStatus-based: they're raw punches with no matched shift to
                             summarize, so there's no SummaryRowsView row for them to filter to. They open a small
                             read-only dialog instead (PunchListDetailDialog). -->
                        <Button x:Name="OrphanedTile"
                                Style="{StaticResource StatusCountButton}"
                                Margin="0,0,14,0"
                                ToolTip="Click to see every Orphaned punch for this period.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Orphaned" Foreground="#7C3AED" />
                                <TextBlock x:Name="OrphanedCountText" FontWeight="Bold" Foreground="#7C3AED" Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="UnscheduledTile"
                                Style="{StaticResource StatusCountButton}"
                                Margin="0,0,14,0"
                                ToolTip="Click to see every Unscheduled punch for this period.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Unscheduled" Foreground="#0891B2" />
                                <TextBlock x:Name="UnscheduledCountText" FontWeight="Bold" Foreground="#0891B2" Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <!-- Read-only. Each row is tinted by its status (the row style is based on the
                     theme's, so the selection highlight is still drawn over it). Right-click a
                     row for its manual-entry/punch menu (SummaryGrid_PreviewMouseRightButtonDown
                     in the code-behind). -->
                <syncfusion:SfDataGrid x:Name="SummaryGrid"
                                       Margin="4"
                                       AutoGenerateColumns="False"
                                       AllowEditing="False"
                                       AllowDraggingColumns="False"
                                       ColumnSizer="Auto"
                                       controls:GridAutoFit.IsEnabled="True"
                                       FrozenColumnCount="2"
                                       GridLinesVisibility="Both"
                                       NavigationMode="Row"
                                       SelectionMode="Single"
                                       PreviewMouseRightButtonDown="SummaryGrid_PreviewMouseRightButtonDown">
                    <syncfusion:SfDataGrid.RowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusToRowBackground}}" />
                        </Style>
                    </syncfusion:SfDataGrid.RowStyle>
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="EmployeeId" HeaderText="PIN" />
                        <syncfusion:GridTextColumn MappingName="EmployeeName" HeaderText="Name" />
                        <syncfusion:GridTextColumn MappingName="Department" HeaderText="Department" />
                        <syncfusion:GridTextColumn MappingName="TypeText" HeaderText="Type" />
                        <syncfusion:GridTextColumn MappingName="ShiftDate" HeaderText="Date"
                                                   DisplayBinding="{Binding ShiftDate, StringFormat={}{0:MM/dd/yy ddd}}" />
                        <syncfusion:GridTextColumn MappingName="CheckInText" HeaderText="Check In" />
                        <syncfusion:GridTextColumn MappingName="CheckOutText" HeaderText="Check Out" />
                        <syncfusion:GridTextColumn MappingName="ClockInText" HeaderText="Clock In">
                            <syncfusion:GridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Clock In" ToolTip="A trailing * means this time came from a manual entry, not a device punch." />
                                </DataTemplate>
                            </syncfusion:GridTextColumn.HeaderTemplate>
                        </syncfusion:GridTextColumn>
                        <syncfusion:GridTextColumn MappingName="ClockOutText" HeaderText="Clock Out">
                            <syncfusion:GridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Clock Out" ToolTip="A trailing * means this time came from a manual entry, not a device punch." />
                                </DataTemplate>
                            </syncfusion:GridTextColumn.HeaderTemplate>
                        </syncfusion:GridTextColumn>
                        <syncfusion:GridTextColumn MappingName="WorkDayText" HeaderText="Work Day" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                        <syncfusion:GridTextColumn MappingName="LateInText" HeaderText="Late In" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                        <syncfusion:GridTextColumn MappingName="EarlyOutText" HeaderText="Early Out" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                        <syncfusion:GridTextColumn MappingName="RemainText" HeaderText="Remain" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                        <syncfusion:GridTextColumn MappingName="RemainHoursText" HeaderText="Remain (h)" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                        <syncfusion:GridTextColumn MappingName="OvertimeText" HeaderText="Overtime" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                        <syncfusion:GridTextColumn MappingName="OvertimeHoursText" HeaderText="Overtime (h)" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                        <syncfusion:GridTextColumn MappingName="NightDiffText" HeaderText="Night Diff" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                        <syncfusion:GridTextColumn MappingName="NightDiffHoursText" HeaderText="Night Diff (h)" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                        <syncfusion:GridTextColumn MappingName="StatusText" HeaderText="Status">
                            <syncfusion:GridTextColumn.CellStyle>
                                <Style TargetType="syncfusion:GridCell">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                </Style>
                            </syncfusion:GridTextColumn.CellStyle>
                        </syncfusion:GridTextColumn>
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>

                <TextBlock x:Name="EmptyText"
                           Text="Generate a report to see attendance summary results here."
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</rxui:ReactiveUserControl>
