<UserControl x:Class="ScheduleApp.Desktop.Views.AttendanceSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels"
             xmlns:coreAttendance="clr-namespace:ScheduleApp.Core.Attendance;assembly=ScheduleApp.Core"
             xmlns:converters="clr-namespace:ScheduleApp.Desktop.Converters">
    <!-- One of three views the "Attendance" drawer item's sub-items navigate between (see
         MainWindow.xaml's Summary/Punch Records/Manual Entries items, and
         AttendanceSummaryPage.xaml.cs). All three share one AttendanceViewModel (DI-Scoped to
         the app's one lifetime scope - see App.xaml.cs's own comment on that registration), so
         switching between them keeps whatever was already loaded rather than re-querying the
         database; see AttendanceViewModel.EnsureInitializedAsync/ActivateSummaryTab for how a
         page navigation drives what a tab selection used to. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:PunchStatusToBrushConverter x:Key="StatusToBrush" />
        <converters:PunchStatusToRowBackgroundBrushConverter x:Key="StatusToRowBackground" />
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <converters:StatusFilterHighlightConverter x:Key="StatusFilterHighlight" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <!-- Shared "card" look for the status strip, so it reads as one consistent surface. -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Strips all Button chrome down to just its content, so a status tile in the counts
             strip below still looks like the plain label+count pair it is; only the hand
             cursor hints that it's clickable. Deliberately a plain WPF Button: it's a tile,
             not a button to look at. -->
        <Style x:Key="StatusCountButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A Period date: "October 1, 2026", typed or picked from the drop-down calendar. -->
        <Style x:Key="PeriodDate" TargetType="syncfusion:DateTimeEdit">
            <Setter Property="Pattern" Value="CustomPattern" />
            <Setter Property="CustomPattern" Value="MMMM d, yyyy" />
            <Setter Property="IsEmptyDateEnabled" Value="True" />
            <Setter Property="NullValue" Value="{x:Null}" />
            <Setter Property="ShowMaskOnNullValue" Value="False" />
            <Setter Property="Width" Value="190" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!-- The Summary grid's right-aligned time/duration/hours columns, so the digits line up
             column to column the way they would in a spreadsheet. -->
        <Style x:Key="RightAlignedHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <!-- No separate "something's running" Cancel bar above this Grid (see
             AttendanceBusyState): the icon-only Refresh button in the Period row below (see
             RefreshOrCancelSummaryCommand) doubles as the Cancel button in place, so nothing
             above it ever moves. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="275" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Report scope tree - same Department/Employee shape as the Schedule tab's tree
             (see EmployeeTreeBuilder), but checkboxes are always on here, since scoping a
             report is this tree's only job. Every employee starts checked = whole company;
             un-checking a department un-checks every employee in it; un-checking individuals
             narrows further. See AttendanceViewModel.SelectionScopeText and GetSelectedPins.
             Checking/un-checking a box here also re-runs the report itself, same as editing a
             Period date below; see ReportViewModel.TryAutoRun. -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top"
                       Text="Report Scope"
                       FontWeight="Bold"
                       FontSize="13"
                       Margin="2,0,0,8" />

            <!-- Live filter for the tree below, same comma-separated Employee ID/last
                 name/first name/department matching as the Punch Records tab's search box
                 (see ReportScopeViewModel.SearchText) - narrows which nodes are visible, not
                 which are checked, so typing here never changes what a report would actually
                 include. -->
            <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                <TextBlock Text="Search" Style="{StaticResource GroupLabel}" Margin="0,0,0,4" />
                <syncfusion:SfTextBoxExt Text="{Binding ReportScopeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="ID, name or department"
                                         ToolTip="Comma-separated ID, name, or department terms (e.g. &quot;342, Cruz, Kitchen&quot;) -- narrows what's shown, not what's checked." />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="2,8,0,0">
                <TextBlock Text="{Binding SelectionScopeText}"
                           Style="{StaticResource CaptionTextStyle}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <syncfusion:ButtonAdv Label="Select All"
                                          IconTemplate="{StaticResource SelectAllIconTemplate}"
                                          SizeMode="Normal"
                                          Command="{Binding SelectAllTreeCommand}"
                                          Margin="0,0,6,0"
                                          ToolTip="Check every employee -- the whole-company default." />
                    <syncfusion:ButtonAdv Label="Clear"
                                          IconTemplate="{StaticResource ClearSelectionIconTemplate}"
                                          SizeMode="Normal"
                                          Command="{Binding ClearTreeSelectionCommand}"
                                          Margin="0,0,6,0"
                                          ToolTip="Uncheck everyone, so you can hand-pick specific employees or departments." />
                    <syncfusion:ButtonAdv Label="Refresh"
                                          IconTemplate="{StaticResource RefreshIconTemplate}"
                                          SizeMode="Normal"
                                          Command="{Binding LoadEmployeeTreeCommand}"
                                          ToolTip="Reload the employee list -- resets checkboxes back to everyone checked." />
                </StackPanel>
            </StackPanel>

            <!-- Bound to VisibleDepartments and each department's VisibleEmployees, which the
                 search box above keeps filtered (EmployeeTreeSearchFilter) - SfTreeView can't
                 hide a row itself. -->
            <Border BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="4">
                <syncfusion:SfTreeView ItemsSource="{Binding VisibleDepartments}"
                                       SelectionMode="None"
                                       ExpandActionTrigger="Node"
                                       FocusVisualStyle="{x:Null}">
                    <syncfusion:SfTreeView.Resources>
                        <DataTemplate DataType="{x:Type vm:DepartmentGroupViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          IsThreeState="False"
                                          VerticalAlignment="Center"
                                          ToolTip="Include/exclude every employee in this department"
                                          Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:EmployeeNodeViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Employee.DisplayName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:SfTreeView.Resources>
                    <syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                        <syncfusion:HierarchyPropertyDescriptor TargetType="{x:Type vm:DepartmentGroupViewModel}"
                                                                ChildPropertyName="VisibleEmployees"
                                                                IsExpandedPropertyName="IsExpanded" />
                    </syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                    <syncfusion:SfTreeView.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" Focusable="False" VerticalAlignment="Center" />
                        </DataTemplate>
                    </syncfusion:SfTreeView.ItemTemplate>
                </syncfusion:SfTreeView>
            </Border>
        </DockPanel>

        <!-- Right: period, results status strip, and the summary grid. There's no "Generate
             Reports" button - changing either Period date below, or a checkbox in the Report
             Scope tree at left, re-runs the report by itself (see ReportViewModel.TryAutoRun). -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="Period" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <!-- Steps PeriodStart/PeriodEnd to the adjacent cut-off (1st-15th /
                         16th-end of month) either side of whatever's currently set; see
                         ReportViewModel.PreviousPeriod. Setting both properties still routes
                         through TryAutoRun same as editing either date. -->
                    <syncfusion:ButtonAdv SizeMode="Small"
                                          Tag="&#xE76B;"
                                          IconTemplate="{StaticResource TagGlyphIconTemplate}"
                                          Command="{Binding PreviousPeriodCommand}"
                                          Margin="0,0,6,0"
                                          ToolTip="Previous cut-off period." />
                    <syncfusion:DateTimeEdit Style="{StaticResource PeriodDate}"
                                             DateTime="{Binding PeriodStart, Mode=TwoWay}" />
                    <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <syncfusion:DateTimeEdit Style="{StaticResource PeriodDate}"
                                             DateTime="{Binding PeriodEnd, Mode=TwoWay}" />
                    <syncfusion:ButtonAdv SizeMode="Small"
                                          Tag="&#xE76C;"
                                          IconTemplate="{StaticResource TagGlyphIconTemplate}"
                                          Command="{Binding NextPeriodCommand}"
                                          Margin="0,0,8,0"
                                          ToolTip="Next cut-off period." />
                    <!-- Disabled rather than hidden while there's no result to export
                         (CanExportSummary), the same CanExecute-driven greying every other
                         command button on this page uses. -->
                    <syncfusion:ButtonAdv Label="Export Summary…"
                                          IconTemplate="{StaticResource ExportIconTemplate}"
                                          SizeMode="Normal"
                                          Command="{Binding ExportSummaryCommand}"
                                          ToolTip="Save the attendance summary to Excel -- opens automatically." />
                </StackPanel>

                <!-- Manual fallback for the auto-refresh every Period/tree edit already
                     triggers (see ReportViewModel.RefreshSummaryAsync's own doc comment for the
                     exact gap this closes), pinned to the row's right edge. Doubles as the
                     page's Cancel button while anything is running (see
                     RefreshOrCancelSummaryCommand/RefreshOrCancelGlyph/RefreshOrCancelToolTip). -->
                <syncfusion:ButtonAdv DockPanel.Dock="Right"
                                      SizeMode="Small"
                                      Tag="{Binding SummaryRefreshOrCancelGlyph}"
                                      IconTemplate="{StaticResource TagGlyphIconTemplate}"
                                      Command="{Binding RefreshOrCancelSummaryCommand}"
                                      ToolTip="{Binding SummaryRefreshOrCancelToolTip}" />
            </DockPanel>

            <!-- Status counts + Clear Filter, one slim strip. -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardBorder}"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <!-- Only shows once a status tile has narrowed the grid - same effect as
                         clicking that same tile a second time. Docked before the tiles so it
                         always gets its width; the tiles wrap in what's left. -->
                    <syncfusion:ButtonAdv DockPanel.Dock="Right"
                                          Label="Clear Filter"
                                          IconTemplate="{StaticResource CancelIconTemplate}"
                                          SizeMode="Normal"
                                          Command="{Binding ClearStatusFilterCommand}"
                                          Visibility="{Binding SelectedStatusFilter, Converter={StaticResource NotNullToVisibility}}"
                                          VerticalAlignment="Top"
                                          ToolTip="Show every status in the summary grid again." />
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Total punches" Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBlock Text="{Binding TotalLogs}" FontWeight="Bold" Margin="4,0,20,0" />

                        <!-- Each tile below is a borderless Button (see StatusCountButton)
                             wrapped in a Border, so clicking it narrows the Summary grid below
                             (SummaryRowsView) down to just that status in place - see
                             ReportViewModel.ShowStatusDetail/SelectedStatusFilter. A second
                             click of the same tile (or Clear Filter) goes back to showing every
                             status. The wrapping Border lights up via
                             StatusFilterHighlightConverter while that tile's status is the
                             active filter. -->
                        <Border CornerRadius="4" Padding="6,3" Margin="0,0,10,0"
                                Background="{Binding SelectedStatusFilter, Converter={StaticResource StatusFilterHighlight}, ConverterParameter={x:Static coreAttendance:PunchStatus.Complete}}">
                            <Button Style="{StaticResource StatusCountButton}"
                                    Command="{Binding ShowStatusDetailCommand}"
                                    CommandParameter="{x:Static coreAttendance:PunchStatus.Complete}"
                                    ToolTip="Filter to Complete only -- click again to show everyone.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Complete" Foreground="#16A34A" />
                                    <TextBlock Text="{Binding CompleteCount}" FontWeight="Bold" Foreground="#16A34A" Margin="4,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Border>
                        <Border CornerRadius="4" Padding="6,3" Margin="0,0,10,0"
                                Background="{Binding SelectedStatusFilter, Converter={StaticResource StatusFilterHighlight}, ConverterParameter={x:Static coreAttendance:PunchStatus.Partial}}">
                            <Button Style="{StaticResource StatusCountButton}"
                                    Command="{Binding ShowStatusDetailCommand}"
                                    CommandParameter="{x:Static coreAttendance:PunchStatus.Partial}"
                                    ToolTip="Filter to Partial only -- click again to show everyone.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Partial" Foreground="#D97706" />
                                    <TextBlock Text="{Binding PartialCount}" FontWeight="Bold" Foreground="#D97706" Margin="4,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Border>
                        <Border CornerRadius="4" Padding="6,3" Margin="0,0,10,0"
                                Background="{Binding SelectedStatusFilter, Converter={StaticResource StatusFilterHighlight}, ConverterParameter={x:Static coreAttendance:PunchStatus.Absent}}">
                            <Button Style="{StaticResource StatusCountButton}"
                                    Command="{Binding ShowStatusDetailCommand}"
                                    CommandParameter="{x:Static coreAttendance:PunchStatus.Absent}"
                                    ToolTip="Filter to Absent only -- click again to show everyone.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Absent" Foreground="#DC2626" />
                                    <TextBlock Text="{Binding AbsentCount}" FontWeight="Bold" Foreground="#DC2626" Margin="4,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Border>
                        <Border CornerRadius="4" Padding="6,3" Margin="0,0,10,0"
                                Background="{Binding SelectedStatusFilter, Converter={StaticResource StatusFilterHighlight}, ConverterParameter={x:Static coreAttendance:PunchStatus.Leave}}">
                            <Button Style="{StaticResource StatusCountButton}"
                                    Command="{Binding ShowStatusDetailCommand}"
                                    CommandParameter="{x:Static coreAttendance:PunchStatus.Leave}"
                                    ToolTip="Filter to Leave only -- click again to show everyone.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Leave" Foreground="#475569" />
                                    <TextBlock Text="{Binding LeaveCount}" FontWeight="Bold" Foreground="#475569" Margin="4,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Border>
                        <Border CornerRadius="4" Padding="6,3" Margin="0,0,10,0"
                                Background="{Binding SelectedStatusFilter, Converter={StaticResource StatusFilterHighlight}, ConverterParameter={x:Static coreAttendance:PunchStatus.OfficialBusiness}}">
                            <Button Style="{StaticResource StatusCountButton}"
                                    Command="{Binding ShowStatusDetailCommand}"
                                    CommandParameter="{x:Static coreAttendance:PunchStatus.OfficialBusiness}"
                                    ToolTip="Filter to Official Business only -- click again to show everyone.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Official Business" Foreground="#7C3AED" />
                                    <TextBlock Text="{Binding OfficialBusinessCount}" FontWeight="Bold" Foreground="#7C3AED" Margin="4,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Border>
                        <Border CornerRadius="4" Padding="6,3" Margin="0,0,10,0"
                                Background="{Binding SelectedStatusFilter, Converter={StaticResource StatusFilterHighlight}, ConverterParameter={x:Static coreAttendance:PunchStatus.RestDay}}">
                            <Button Style="{StaticResource StatusCountButton}"
                                    Command="{Binding ShowStatusDetailCommand}"
                                    CommandParameter="{x:Static coreAttendance:PunchStatus.RestDay}"
                                    ToolTip="Filter to Rest Day only -- click again to show everyone.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Rest Day" Foreground="#0D9488" />
                                    <TextBlock Text="{Binding RestDayCount}" FontWeight="Bold" Foreground="#0D9488" Margin="4,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Unlike the six tiles above, these two aren't PunchStatus-based:
                             they're raw punches with no matched shift to summarize, so there's
                             no SummaryRowsView row for them to filter to. They open a small
                             read-only dialog instead (PunchListDetailDialog). -->
                        <Button Style="{StaticResource StatusCountButton}"
                                Command="{Binding ShowOrphanedDetailCommand}"
                                Margin="0,0,14,0"
                                ToolTip="Click to see every Orphaned punch for this period.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Orphaned" Foreground="#7C3AED" />
                                <TextBlock Text="{Binding OrphanedCount}" FontWeight="Bold" Foreground="#7C3AED" Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource StatusCountButton}"
                                Command="{Binding ShowUnscheduledDetailCommand}"
                                Margin="0,0,14,0"
                                ToolTip="Click to see every Unscheduled punch for this period.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Unscheduled" Foreground="#0891B2" />
                                <TextBlock Text="{Binding UnscheduledCount}" FontWeight="Bold" Foreground="#0891B2" Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <!-- Read-only. Each row is tinted by its status (the row style is based on the
                     theme's, so the selection highlight is still drawn over it). Right-click a
                     row for its manual-entry/punch menu (SummaryGrid_PreviewMouseRightButtonDown
                     in the code-behind). -->
                <syncfusion:SfDataGrid x:Name="SummaryGrid"
                                       Margin="4"
                                       ItemsSource="{Binding SummaryRowsView}"
                                       AutoGenerateColumns="False"
                                       AllowEditing="False"
                                       AllowDraggingColumns="False"
                                       ColumnSizer="Auto"
                                       RowHeight="25"
                                       FrozenColumnCount="2"
                                       GridLinesVisibility="Both"
                                       NavigationMode="Row"
                                       SelectionMode="Single"
                                       PreviewMouseRightButtonDown="SummaryGrid_PreviewMouseRightButtonDown"
                                       Visibility="{Binding HasSummaryRows, Converter={StaticResource BoolToVisibility}}">
                    <syncfusion:SfDataGrid.RowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl" BasedOn="{StaticResource GridRowStyle}">
                            <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusToRowBackground}}" />
                        </Style>
                    </syncfusion:SfDataGrid.RowStyle>
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="EmployeeId" HeaderText="PIN" />
                        <syncfusion:GridTextColumn MappingName="EmployeeName" HeaderText="Name" />
                        <syncfusion:GridTextColumn MappingName="Department" HeaderText="Department" />
                        <syncfusion:GridTextColumn MappingName="TypeText" HeaderText="Type" />
                        <syncfusion:GridTextColumn MappingName="ShiftDate" HeaderText="Date"
                                                   DisplayBinding="{Binding ShiftDate, StringFormat={}{0:MM/dd/yy ddd}}" />
                        <syncfusion:GridTextColumn MappingName="CheckInText" HeaderText="Check In" />
                        <syncfusion:GridTextColumn MappingName="CheckOutText" HeaderText="Check Out" />
                        <syncfusion:GridTextColumn MappingName="ClockInText" HeaderText="Clock In">
                            <syncfusion:GridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Clock In" ToolTip="A trailing * means this time came from a manual entry, not a device punch." />
                                </DataTemplate>
                            </syncfusion:GridTextColumn.HeaderTemplate>
                        </syncfusion:GridTextColumn>
                        <syncfusion:GridTextColumn MappingName="ClockOutText" HeaderText="Clock Out">
                            <syncfusion:GridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Clock Out" ToolTip="A trailing * means this time came from a manual entry, not a device punch." />
                                </DataTemplate>
                            </syncfusion:GridTextColumn.HeaderTemplate>
                        </syncfusion:GridTextColumn>
                        <syncfusion:GridTextColumn MappingName="WorkDayText" HeaderText="Work Day" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                        <syncfusion:GridTextColumn MappingName="LateInText" HeaderText="Late In" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                        <syncfusion:GridTextColumn MappingName="EarlyOutText" HeaderText="Early Out" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                        <syncfusion:GridTextColumn MappingName="RemainText" HeaderText="Remain" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                        <syncfusion:GridTextColumn MappingName="RemainHoursText" HeaderText="Remain (h)" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                        <syncfusion:GridTextColumn MappingName="OvertimeText" HeaderText="Overtime" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                        <syncfusion:GridTextColumn MappingName="OvertimeHoursText" HeaderText="Overtime (h)" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                        <syncfusion:GridTextColumn MappingName="NightDiffText" HeaderText="Night Diff" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                        <syncfusion:GridTextColumn MappingName="NightDiffHoursText" HeaderText="Night Diff (h)" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                        <syncfusion:GridTextColumn MappingName="StatusText" HeaderText="Status">
                            <syncfusion:GridTextColumn.CellStyle>
                                <Style TargetType="syncfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                </Style>
                            </syncfusion:GridTextColumn.CellStyle>
                        </syncfusion:GridTextColumn>
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>

                <TextBlock Text="Generate a report to see attendance summary results here."
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasSummaryRows, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
