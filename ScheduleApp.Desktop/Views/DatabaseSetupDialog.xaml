<controls:ReactiveAppWindow x:Class="ScheduleApp.Desktop.Views.DatabaseSetupDialog" ShowMinimizeButton="False" ShowMaximizeButton="False"
        x:TypeArguments="vm:DatabaseSetupViewModel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
        xmlns:utilities="clr-namespace:ScheduleApp.Desktop.Utilities"
        Width="460" Height="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        utilities:WindowSizing.ConstrainToWorkArea="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

    <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <Grid Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <!-- Rows 5-6: the admin connection and the new login, shown only when
                         creating a dedicated SQL login. -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="IntroText" Grid.Row="0" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,16" />

                <TextBlock Grid.Row="1" Text="Server" Margin="0,0,0,4" />

                <!-- Editable rather than a locked dropdown - SqlServerDiscovery's own
                     doc comment explains why neither of its two sources is exhaustive
                     (a remote server with SQL Server Browser disabled, for one, never
                     shows up), so typing an instance name discovery didn't find has to
                     keep working exactly as it always did on the plain TextBox this
                     replaces. -->
                <syncfusion:ComboBoxAdv x:Name="ServerBox" Grid.Row="2" Margin="0,0,0,12"
                          IsEditable="True" IsTextSearchEnabled="True"
                          ToolTip="SQL Server instance name (e.g. .\SQLEXPRESS) -- pick a discovered server or type your own." />

                <TextBlock Grid.Row="3" Text="Database name" Margin="0,0,0,4" />
                <syncfusion:SfTextBoxExt x:Name="DatabaseNameBox" Grid.Row="4" Margin="0,0,0,16"
                         ToolTip="Created if it doesn't already exist. Letters, digits, and underscores only." />

                <!-- A Windows-Authenticated setup runs no SQL Server statement itself, so
                     there's nothing for admin credentials to authorize. -->
                <StackPanel x:Name="AdminConnectionPanel" Grid.Row="5">
                    <TextBlock Text="Admin connection" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,8"
                               Text="Used once, to create the database and login below -- never saved anywhere. Needs rights to create databases and logins on this server (a sysadmin account, most commonly)." />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="AdminWindowsAuthRadio" GroupName="AdminAuth" Content="Windows (integrated)"
                                     Margin="0,0,16,0" />
                        <RadioButton x:Name="AdminSqlAuthRadio" GroupName="AdminAuth" Content="SQL Server login" />
                    </StackPanel>
                    <StackPanel x:Name="AdminCredentialsPanel" Margin="0,0,0,16">
                        <TextBlock Text="Admin username" Margin="0,0,0,4" />
                        <syncfusion:SfTextBoxExt x:Name="AdminUsernameBox" Margin="0,0,0,8" />
                        <TextBlock Text="Admin password" Margin="0,0,0,4" />
                        <PasswordBox x:Name="AdminPasswordBox" />
                    </StackPanel>
                </StackPanel>

                <!-- Likewise only for a dedicated SQL login: a Windows-Authenticated setup
                     creates no login at all. -->
                <StackPanel x:Name="LoginProvisioningPanel" Grid.Row="6">
                    <TextBlock Text="New login" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="Username" Margin="0,0,0,4" />
                    <syncfusion:SfTextBoxExt x:Name="NewLoginUsernameBox" Margin="0,0,0,8"
                             ToolTip="Letters, digits, and underscores only." />
                    <TextBlock Text="Password" Margin="0,0,0,4" />
                    <PasswordBox x:Name="NewLoginPasswordBox" Margin="0,0,0,8" />
                    <TextBlock Text="Confirm password" Margin="0,0,0,4" />
                    <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,16" />

                    <TextBlock Text="Access level" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <StackPanel Margin="0,0,0,8">
                        <RadioButton x:Name="FullAccessRadio" GroupName="AccessLevel" Content="Full access (db_owner)"
                                     Margin="0,0,0,4"
                                     ToolTip="Needed for Schedule Manager's own connection -- it creates/updates the schema on startup." />
                        <RadioButton x:Name="ReadWriteRadio" GroupName="AccessLevel" Content="Read &amp; write only (db_datareader + db_datawriter)"
                                     ToolTip="Enough for Push Listener (existing tables only) -- not enough for Schedule Manager, which needs to alter the schema." />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Grid.Row="7" Foreground="#DC2626" TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <StackPanel x:Name="ProgressPanel" Grid.Row="8" Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="6" Margin="0,0,10,0" />
                    <TextBlock Text="Setting up…" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <syncfusion:ButtonAdv x:Name="CreateButton"
                                  Label="Create"
                                  IconTemplate="{StaticResource ApplyIconTemplate}"
                                  MinWidth="90"
                                  Margin="0,0,8,0"
                                  IsDefault="True" />
            <syncfusion:ButtonAdv x:Name="CancelButton"
                                  IconTemplate="{StaticResource CancelIconTemplate}"
                                  MinWidth="90"
                                  IsCancel="True" />
        </StackPanel>
    </Grid>
</Grid>
</controls:ReactiveAppWindow>
