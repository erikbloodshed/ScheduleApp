<ui:FluentWindow x:Class="ScheduleApp.Desktop.Views.AttendanceStatusDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:ScheduleApp.Desktop.Converters"
        Title="Attendance Detail" Width="760" Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
>
    <Window.Resources>
        <converters:PunchStatusToBrushConverter x:Key="StatusToBrush" />

        <!-- Same right-alignment as the Summary grid's time columns, copied
             locally rather than shared from AttendanceView.xaml; this file
             already duplicates its own CardBorder/GroupLabel styles the same
             way, so this keeps the same (if slightly repetitive) convention
             rather than introducing a new shared-resource-dictionary pattern
             for just this one dialog. -->
        <Style x:Key="RightAlignedCell"
               TargetType="TextBlock">
            <Setter Property="TextAlignment"
                    Value="Right" />
            <Setter Property="Margin"
                    Value="0,0,8,0" />
        </Style>
        <Style x:Key="RightAlignedHeader"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment"
                    Value="Right" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- See MainWindow.xaml's own TitleBar comment for why every FluentWindow needs
             one of these - WPF-UI removes the native title bar entirely otherwise. -->
        <ui:TitleBar Grid.Row="0"
                Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                ShowMinimize="False"
                ShowMaximize="True"
                CanMaximize="True" />

    <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Same column set as the Summary grid, minus the duration/hours
             columns: this dialog is "here's every row of one status," not
             the full payroll breakdown, which is still the Summary grid
             itself for the same period. -->
        <DataGrid x:Name="RowsGrid"
                  Grid.Row="0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  RowHeight="25"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PIN"
                                    Binding="{Binding EmployeeId}" />
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding EmployeeName}" />
                <DataGridTextColumn Header="Department"
                                    Binding="{Binding Department}" />
                <DataGridTextColumn Header="Date"
                                    Binding="{Binding ShiftDate, StringFormat='{}{0:MMM d, yyyy}'}" />
                <DataGridTextColumn Header="Check In"
                                    Binding="{Binding CheckInText}"
                                    ElementStyle="{StaticResource RightAlignedCell}"
                                    HeaderStyle="{StaticResource RightAlignedHeader}" />
                <DataGridTextColumn Header="Check Out"
                                    Binding="{Binding CheckOutText}"
                                    ElementStyle="{StaticResource RightAlignedCell}"
                                    HeaderStyle="{StaticResource RightAlignedHeader}" />
                <DataGridTextColumn Header="Clock In"
                                    Binding="{Binding ClockInText}"
                                    ElementStyle="{StaticResource RightAlignedCell}"
                                    HeaderStyle="{StaticResource RightAlignedHeader}" />
                <DataGridTextColumn Header="Clock Out"
                                    Binding="{Binding ClockOutText}"
                                    ElementStyle="{StaticResource RightAlignedCell}"
                                    HeaderStyle="{StaticResource RightAlignedHeader}" />
                <DataGridTextColumn Header="Status"
                                    Binding="{Binding StatusText}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight"
                                    Value="SemiBold" />
                            <Setter Property="Foreground"
                                    Value="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="ExportButton"
                    Content="Export…"
                    Width="90"
                    Margin="0,0,8,0"
                    Click="ExportButton_Click" />
            <Button Content="Close"
                    Width="90"
                    IsCancel="True"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Grid>
</ui:FluentWindow>
