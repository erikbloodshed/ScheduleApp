<controls:AppWindow x:Class="ScheduleApp.Desktop.Views.AttendanceStatusDetailDialog" ShowMinimizeButton="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
        xmlns:converters="clr-namespace:ScheduleApp.Desktop.Converters"
        Title="Attendance Detail" Width="760" Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <converters:PunchStatusToBrushConverter x:Key="StatusToBrush" />

        <!-- Same right-alignment as the Summary grid's time columns. -->
        <Style x:Key="RightAlignedHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Same column set as the Summary grid, minus the duration/hours columns: this
             dialog is "here's every row of one status," not the full payroll breakdown,
             which is still the Summary grid itself for the same period. -->
        <syncfusion:SfDataGrid x:Name="RowsGrid"
                               Grid.Row="0"
                               AutoGenerateColumns="False"
                               AllowEditing="False"
                               AllowDraggingColumns="False"
                               ColumnSizer="Auto"
                               RowHeight="25"
                               GridLinesVisibility="Both"
                               NavigationMode="Row"
                               SelectionMode="Single">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="EmployeeId" HeaderText="PIN" />
                <syncfusion:GridTextColumn MappingName="EmployeeName" HeaderText="Name" />
                <syncfusion:GridTextColumn MappingName="Department" HeaderText="Department" />
                <syncfusion:GridTextColumn MappingName="ShiftDate" HeaderText="Date"
                                           DisplayBinding="{Binding ShiftDate, StringFormat='{}{0:MMM d, yyyy}'}" />
                <syncfusion:GridTextColumn MappingName="CheckInText" HeaderText="Check In" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                <syncfusion:GridTextColumn MappingName="CheckOutText" HeaderText="Check Out" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                <syncfusion:GridTextColumn MappingName="ClockInText" HeaderText="Clock In" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                <syncfusion:GridTextColumn MappingName="ClockOutText" HeaderText="Clock Out" TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                <syncfusion:GridTextColumn MappingName="StatusText" HeaderText="Status">
                    <syncfusion:GridTextColumn.CellStyle>
                        <Style TargetType="syncfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                        </Style>
                    </syncfusion:GridTextColumn.CellStyle>
                </syncfusion:GridTextColumn>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <syncfusion:ButtonAdv x:Name="ExportButton"
                                  Label="Export…"
                                  IconTemplate="{StaticResource ExportIconTemplate}"
                                  SizeMode="Normal"
                                  MinWidth="90"
                                  Margin="0,0,8,0"
                                  Click="ExportButton_Click" />
            <syncfusion:ButtonAdv Label="Close"
                                  IconTemplate="{StaticResource CancelIconTemplate}"
                                  SizeMode="Normal"
                                  MinWidth="90"
                                  IsCancel="True"
                                  IsDefault="True" />
        </StackPanel>
    </Grid>
</controls:AppWindow>
