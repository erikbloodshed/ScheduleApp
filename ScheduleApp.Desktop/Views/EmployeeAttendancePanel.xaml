<rxui:ReactiveUserControl x:Class="ScheduleApp.Desktop.Views.EmployeeAttendancePanel"
             x:TypeArguments="payrollVm:PayrollSummaryViewModel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rxui="http://reactiveui.net"
             xmlns:payrollVm="clr-namespace:ScheduleApp.Desktop.ViewModels.Payroll"
             xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="Attendance for the period"
                   Style="{StaticResource GroupLabelStyle}"
                   Margin="0,0,0,4" />

        <!-- Empty-state placeholder and the grid occupy the same Grid cell, same
             mutually-exclusive-Visibility idea as PayrollSummaryView's own placeholder/
             breakdown pair (see that file's doc comment on its own Grid for why a Grid
             rather than separate DockPanel children). AttendanceEmptyStateMessage falls
             through to PayrollSummaryViewModel.EmptyStateMessage first (no employee, no Pin, bad
             period) and only adds its own "no records" reason once those are all fine but
             this employee simply has nothing for the period. -->
        <Grid>
            <Border x:Name="EmptyStatePanel"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="0">
                <TextBlock x:Name="EmptyStateText"
                           Foreground="{DynamicResource TertiaryForegroundBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <!-- Slim on purpose - see this control's own doc comment (code-behind) for why
                 this isn't the full AttendanceView grid: just the columns that actually feed
                 PayrollCalculator's Basic Pay/Overtime/Night Diff/Undertime lines above, plus
                 enough identifying context (Date/Type/Status/Clock In/Clock Out) to make
                 sense of them, not the full Attendance tab's PIN/Name/Department/Check In/
                 Check Out/Late In/Early Out set - those either don't apply (this grid is
                 already scoped to one employee) or don't bear on payroll math. -->
            <syncfusion:SfDataGrid x:Name="AttendanceGrid"
                                   AutoGenerateColumns="False"
                                   AllowEditing="False"
                                   AllowDraggingColumns="False"
                                   ColumnSizer="Auto"
                                   controls:GridAutoFit.IsEnabled="True"
                                   GridLinesVisibility="Both"
                                   NavigationMode="Row"
                                   SelectionMode="Single">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn MappingName="ShiftDate" HeaderText="Date"
                                               DisplayBinding="{Binding ShiftDate, StringFormat={}{0:MM/dd/yy ddd}}" />
                    <syncfusion:GridTextColumn MappingName="TypeText" HeaderText="Type" />
                    <syncfusion:GridTextColumn MappingName="StatusText" HeaderText="Status">
                        <syncfusion:GridTextColumn.CellStyle>
                            <Style TargetType="syncfusion:GridCell">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                            </Style>
                        </syncfusion:GridTextColumn.CellStyle>
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridTextColumn MappingName="ClockInText" HeaderText="Clock In" />
                    <syncfusion:GridTextColumn MappingName="ClockOutText" HeaderText="Clock Out" />
                    <syncfusion:GridTextColumn MappingName="WorkDayText" HeaderText="Work Day"
                                               TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                    <syncfusion:GridTextColumn MappingName="OvertimeHoursText" HeaderText="Overtime (h)"
                                               TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                    <syncfusion:GridTextColumn MappingName="NightDiffHoursText" HeaderText="Night Diff (h)"
                                               TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                    <syncfusion:GridTextColumn MappingName="RemainHoursText" HeaderText="Undertime (h)"
                                               TextAlignment="Right" HeaderStyle="{StaticResource RightAlignedHeader}" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
        </Grid>
    </DockPanel>
</rxui:ReactiveUserControl>
