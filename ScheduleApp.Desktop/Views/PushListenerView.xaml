<UserControl x:Class="ScheduleApp.Desktop.Views.PushListenerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels"
             xmlns:converters="clr-namespace:ScheduleApp.Desktop.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PushListenerViewModel}">
    <UserControl.Resources>
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />

        <!-- Same "card" look AttendanceView.xaml uses for its toolbar strip, so this tab
             reads as part of the same app rather than a bolted-on utility. -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10" RowDefinitions="Auto, *">
        <!-- Connection bar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Push Listener URL:" Style="{StaticResource GroupLabel}" />
                <syncfusion:SfTextBoxExt Width="220" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                <syncfusion:ButtonAdv Label="Test Connection" Margin="10,0,0,0" SizeMode="Normal"
                                      Tag="&#xE703;" IconTemplate="{StaticResource TagGlyphIconTemplate}"
                                      Command="{Binding TestConnectionCommand}" />
                <TextBlock Text="{Binding ConnectionStatusText}" Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />

                <!-- Health summary: only shown once a refresh has actually returned something,
                     so this stays blank rather than misleadingly showing stale/default values
                     before the first successful poll. -->
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0"
                            Visibility="{Binding Health, Converter={StaticResource NotNullToVisibility}}">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#F59E0B" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Health.Status}" Value="Healthy">
                                        <Setter Property="Fill" Value="#22C55E" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Health.Status}" Value="Degraded">
                                        <Setter Property="Fill" Value="#EF4444" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Health.Status}" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding UptimeDisplay, StringFormat='uptime {0}'}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="DB reachable" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Health.DbReachable}" Value="False">
                                        <Setter Property="Text" Value="DB unreachable" />
                                        <Setter Property="Foreground" Value="#EF4444" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <syncfusion:TabControlExt Grid.Row="1"
                                  AllowDragDrop="False"
                                  EnableLabelEdit="False"
                                  CloseButtonType="Hide"
                                  ShowTabItemContextMenu="False"
                                  ShowTabListContextMenu="False">
            <syncfusion:TabItemExt Header="Devices">
                <Grid Margin="8" RowDefinitions="Auto, *, Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <syncfusion:ButtonAdv Label="Refresh Now" SizeMode="Normal"
                                              IconTemplate="{StaticResource RefreshIconTemplate}"
                                              Command="{Binding RefreshDevicesCommand}" />
                        <CheckBox Content="Auto-refresh every 10s" IsChecked="{Binding AutoRefresh}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <syncfusion:SfDataGrid Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                           AutoGenerateColumns="False" AllowEditing="False" AllowDraggingColumns="False"
                                           SelectionMode="Single" NavigationMode="Row" GridLinesVisibility="Horizontal">
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn MappingName="SerialNumber" HeaderText="Serial Number" Width="160" />
                            <syncfusion:GridTextColumn MappingName="LastSeenUtc" HeaderText="Last Seen (UTC)" Width="190" />
                            <syncfusion:GridTextColumn MappingName="AttLogStamp" HeaderText="ATTLOG Stamp" Width="110" />
                            <syncfusion:GridTextColumn MappingName="OperLogStamp" HeaderText="OPERLOG Stamp" Width="110" />
                            <syncfusion:GridTextColumn MappingName="PendingCommandCount" HeaderText="Pending Commands" Width="130" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <syncfusion:ButtonAdv Label="Resync Attendance for Selected Device" SizeMode="Normal"
                                              Tag="&#xE895;" IconTemplate="{StaticResource TagGlyphIconTemplate}"
                                              Command="{Binding ResyncSelectedDeviceCommand}" />
                        <syncfusion:ButtonAdv Label="Force Recheck Selected Device" SizeMode="Normal" Margin="8,0,0,0"
                                              Tag="&#xE777;" IconTemplate="{StaticResource TagGlyphIconTemplate}"
                                              Command="{Binding ForceRecheckSelectedDeviceCommand}" />
                    </StackPanel>
                </Grid>
            </syncfusion:TabItemExt>

            <syncfusion:TabItemExt Header="Attendance">
                <Grid Margin="8" RowDefinitions="Auto, *">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="SN:" Style="{StaticResource GroupLabel}" />
                        <syncfusion:SfTextBoxExt Width="100" Margin="0,0,12,0" Text="{Binding FilterSn, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="PIN (Employee ID):" Style="{StaticResource GroupLabel}" />
                        <syncfusion:SfTextBoxExt Width="80" Margin="0,0,12,0" Text="{Binding FilterPin, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Start (yyyy-MM-dd HH:mm:ss):" Style="{StaticResource GroupLabel}" />
                        <syncfusion:SfTextBoxExt Width="150" Margin="0,0,12,0" Text="{Binding FilterStartTime, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="End:" Style="{StaticResource GroupLabel}" />
                        <syncfusion:SfTextBoxExt Width="150" Margin="0,0,12,0" Text="{Binding FilterEndTime, UpdateSourceTrigger=PropertyChanged}" />
                        <syncfusion:ButtonAdv Label="Search" SizeMode="Normal"
                                              IconTemplate="{StaticResource SearchIconTemplate}"
                                              Command="{Binding SearchAttendanceCommand}" />
                    </StackPanel>

                    <syncfusion:SfDataGrid Grid.Row="1" ItemsSource="{Binding AttendanceRows}"
                                           AutoGenerateColumns="False" AllowEditing="False" AllowDraggingColumns="False"
                                           SelectionMode="Single" NavigationMode="Row" GridLinesVisibility="Horizontal">
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn MappingName="DeviceSerialNumber" HeaderText="Device" Width="120" />
                            <syncfusion:GridTextColumn MappingName="EmployeeId" HeaderText="Employee ID" Width="90" />
                            <syncfusion:GridTextColumn MappingName="Timestamp" HeaderText="Punch Time (PH)" Width="160" />
                            <syncfusion:GridTextColumn MappingName="PunchTypeText" HeaderText="Punch Type" Width="100" />
                            <syncfusion:GridTextColumn MappingName="Source" HeaderText="Source" Width="80" />
                            <syncfusion:GridTextColumn MappingName="ImportedAt" HeaderText="Imported (UTC)" Width="160" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>
                </Grid>
            </syncfusion:TabItemExt>

            <syncfusion:TabItemExt Header="Logs">
                <Grid Margin="8" RowDefinitions="Auto, *">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Min level:" Style="{StaticResource GroupLabel}" />
                        <syncfusion:ComboBoxAdv Width="110" Margin="0,0,12,0" ItemsSource="{Binding LogLevelOptions}" SelectedItem="{Binding LogLevelFilter, Mode=TwoWay}" />
                        <TextBlock Text="SN contains:" Style="{StaticResource GroupLabel}" />
                        <syncfusion:SfTextBoxExt Width="120" Margin="0,0,12,0" Text="{Binding LogSnFilter, UpdateSourceTrigger=PropertyChanged}" />
                        <syncfusion:ButtonAdv Label="Refresh Now" SizeMode="Normal"
                                              IconTemplate="{StaticResource RefreshIconTemplate}"
                                              Command="{Binding RefreshLogsCommand}" />
                        <!-- Deliberately opt-in, unlike the Devices tab's auto-refresh (defaults on):
                             tailing the log file every 10s is wasted work when no one's looking at this tab. -->
                        <CheckBox Content="Auto-refresh every 10s" IsChecked="{Binding LogAutoRefresh}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <syncfusion:SfDataGrid Grid.Row="1" ItemsSource="{Binding LogEntries}"
                                           AutoGenerateColumns="False" AllowEditing="False" AllowDraggingColumns="False"
                                           SelectionMode="Single" NavigationMode="Row" GridLinesVisibility="Horizontal">
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn MappingName="TimestampUtc" HeaderText="Time (UTC)" Width="160" />
                            <syncfusion:GridTextColumn MappingName="Level" HeaderText="Level" Width="90" />
                            <syncfusion:GridTextColumn MappingName="Message" HeaderText="Message" Width="320" />
                            <syncfusion:GridTextColumn MappingName="Details" HeaderText="Details" Width="260" />
                            <syncfusion:GridTextColumn MappingName="Exception" HeaderText="Exception" ColumnSizer="Star" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>
                </Grid>
            </syncfusion:TabItemExt>
        </syncfusion:TabControlExt>
    </Grid>
</UserControl>
