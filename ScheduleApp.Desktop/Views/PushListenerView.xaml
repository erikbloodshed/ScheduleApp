<rxui:ReactiveUserControl x:Class="ScheduleApp.Desktop.Views.PushListenerView"
             x:TypeArguments="vm:PushListenerViewModel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:rxui="http://reactiveui.net"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="10" RowDefinitions="Auto, *">
        <!-- Connection bar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Push Listener URL:" Style="{StaticResource GroupLabelStyle}" />
                <syncfusion:SfTextBoxExt x:Name="ServerUrlBox" Width="220" VerticalAlignment="Center" />
                <syncfusion:ButtonAdv x:Name="TestConnectionButton" Label="Test Connection" Margin="10,0,0,0"
                                      Tag="&#xE703;" IconTemplate="{StaticResource TagGlyphIconTemplate}" />
                <TextBlock x:Name="ConnectionStatusText" Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />

                <!-- Health summary: only shown once a refresh has actually returned something,
                     so this stays blank rather than misleadingly showing stale/default values
                     before the first successful poll. The dot's colour and the DB line's
                     wording/emphasis follow the health reading (see PushListenerView.xaml.cs). -->
                <StackPanel x:Name="HealthPanel" Orientation="Horizontal" Margin="20,0,0,0">
                    <Ellipse x:Name="HealthDot" Width="10" Height="10" VerticalAlignment="Center" />
                    <TextBlock x:Name="HealthStatusText" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock x:Name="UptimeText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" />
                    <TextBlock x:Name="DbStatusText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <syncfusion:TabControlExt Grid.Row="1"
                                  AllowDragDrop="False"
                                  EnableLabelEdit="False"
                                  CloseButtonType="Hide"
                                  ShowTabItemContextMenu="False"
                                  ShowTabListContextMenu="False">
            <syncfusion:TabItemExt Header="Devices">
                <Grid Margin="8" RowDefinitions="Auto, *, Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <syncfusion:ButtonAdv x:Name="RefreshDevicesButton" Label="Refresh Now"
                                              IconTemplate="{StaticResource RefreshIconTemplate}" />
                        <CheckBox x:Name="AutoRefreshBox" Content="Auto-refresh every 10s" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <syncfusion:SfDataGrid x:Name="DevicesGrid" Grid.Row="1"
                                           AutoGenerateColumns="False" AllowEditing="False" AllowDraggingColumns="False"
                                           SelectionMode="Single" NavigationMode="Row" GridLinesVisibility="Horizontal">
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn MappingName="SerialNumber" HeaderText="Serial Number" Width="160" />
                            <syncfusion:GridTextColumn MappingName="LastSeenUtc" HeaderText="Last Seen (UTC)" Width="190" />
                            <syncfusion:GridTextColumn MappingName="AttLogStamp" HeaderText="ATTLOG Stamp" Width="110" />
                            <syncfusion:GridTextColumn MappingName="OperLogStamp" HeaderText="OPERLOG Stamp" Width="110" />
                            <syncfusion:GridTextColumn MappingName="PendingCommandCount" HeaderText="Pending Commands" Width="130" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <syncfusion:ButtonAdv x:Name="ResyncButton" Label="Resync Attendance for Selected Device"
                                              Tag="&#xE895;" IconTemplate="{StaticResource TagGlyphIconTemplate}" />
                        <syncfusion:ButtonAdv x:Name="ForceRecheckButton" Label="Force Recheck Selected Device" Margin="8,0,0,0"
                                              Tag="&#xE777;" IconTemplate="{StaticResource TagGlyphIconTemplate}" />
                    </StackPanel>
                </Grid>
            </syncfusion:TabItemExt>

            <syncfusion:TabItemExt Header="Attendance">
                <Grid Margin="8" RowDefinitions="Auto, *">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="SN:" Style="{StaticResource GroupLabelStyle}" />
                        <syncfusion:SfTextBoxExt x:Name="FilterSnBox" Width="100" Margin="0,0,12,0" />
                        <TextBlock Text="PIN (Employee ID):" Style="{StaticResource GroupLabelStyle}" />
                        <syncfusion:SfTextBoxExt x:Name="FilterPinBox" Width="80" Margin="0,0,12,0" />
                        <TextBlock Text="Start (yyyy-MM-dd HH:mm:ss):" Style="{StaticResource GroupLabelStyle}" />
                        <syncfusion:SfTextBoxExt x:Name="FilterStartBox" Width="150" Margin="0,0,12,0" />
                        <TextBlock Text="End:" Style="{StaticResource GroupLabelStyle}" />
                        <syncfusion:SfTextBoxExt x:Name="FilterEndBox" Width="150" Margin="0,0,12,0" />
                        <syncfusion:ButtonAdv x:Name="SearchButton" Label="Search"
                                              IconTemplate="{StaticResource SearchIconTemplate}" />
                    </StackPanel>

                    <syncfusion:SfDataGrid x:Name="AttendanceGrid" Grid.Row="1"
                                           AutoGenerateColumns="False" AllowEditing="False" AllowDraggingColumns="False"
                                           SelectionMode="Single" NavigationMode="Row" GridLinesVisibility="Horizontal">
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn MappingName="DeviceSerialNumber" HeaderText="Device" Width="120" />
                            <syncfusion:GridTextColumn MappingName="EmployeeId" HeaderText="Employee ID" Width="90" />
                            <syncfusion:GridTextColumn MappingName="Timestamp" HeaderText="Punch Time (PH)" Width="160" />
                            <syncfusion:GridTextColumn MappingName="PunchTypeText" HeaderText="Punch Type" Width="100" />
                            <syncfusion:GridTextColumn MappingName="Source" HeaderText="Source" Width="80" />
                            <syncfusion:GridTextColumn MappingName="ImportedAt" HeaderText="Imported (UTC)" Width="160" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>
                </Grid>
            </syncfusion:TabItemExt>

            <syncfusion:TabItemExt Header="Logs">
                <Grid Margin="8" RowDefinitions="Auto, *">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Min level:" Style="{StaticResource GroupLabelStyle}" />
                        <syncfusion:ComboBoxAdv x:Name="LogLevelBox" Width="110" Margin="0,0,12,0" />
                        <TextBlock Text="SN contains:" Style="{StaticResource GroupLabelStyle}" />
                        <syncfusion:SfTextBoxExt x:Name="LogSnBox" Width="120" Margin="0,0,12,0" />
                        <syncfusion:ButtonAdv x:Name="RefreshLogsButton" Label="Refresh Now"
                                              IconTemplate="{StaticResource RefreshIconTemplate}" />
                        <!-- Deliberately opt-in, unlike the Devices tab's auto-refresh (defaults on):
                             tailing the log file every 10s is wasted work when no one's looking at this tab. -->
                        <CheckBox x:Name="LogAutoRefreshBox" Content="Auto-refresh every 10s" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <syncfusion:SfDataGrid x:Name="LogsGrid" Grid.Row="1"
                                           AutoGenerateColumns="False" AllowEditing="False" AllowDraggingColumns="False"
                                           SelectionMode="Single" NavigationMode="Row" GridLinesVisibility="Horizontal">
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn MappingName="TimestampUtc" HeaderText="Time (UTC)" Width="160" />
                            <syncfusion:GridTextColumn MappingName="Level" HeaderText="Level" Width="90" />
                            <syncfusion:GridTextColumn MappingName="Message" HeaderText="Message" Width="320" />
                            <syncfusion:GridTextColumn MappingName="Details" HeaderText="Details" Width="260" />
                            <syncfusion:GridTextColumn MappingName="Exception" HeaderText="Exception" ColumnSizer="Star" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>
                </Grid>
            </syncfusion:TabItemExt>
        </syncfusion:TabControlExt>
    </Grid>
</rxui:ReactiveUserControl>
