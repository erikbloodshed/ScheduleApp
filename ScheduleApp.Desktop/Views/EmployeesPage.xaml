<Page x:Class="ScheduleApp.Desktop.Views.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
      xmlns:converters="clr-namespace:ScheduleApp.Desktop.Converters"
      ScrollViewer.CanContentScroll="False"
      Title="Employees">
    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />

        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ToolbarButton" TargetType="syncfusion:ButtonAdv">
            <Setter Property="SizeMode" Value="Normal" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Page.Resources>

    <Grid Margin="8">
        <!-- The Add/Delete Department and Add/Edit/Delete/Blacklist/Import Employee buttons sit
             in the tree's and grid's own header rows. They act on
             MainViewModel.SelectedDepartment/SelectedEmployee, which the tree and grid drive
             directly (see DepartmentTree_SelectionChanged/EmployeesGrid_SelectionChanged in the
             code-behind), so there's no hopping to the Schedule tab to pick something first. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: one row per department (+ a trailing "(Unassigned)" bucket). Only one level:
             a department's employees show in the grid on the right instead of as nested rows,
             so the tree has no ChildPropertyName.

             Departments is the same ObservableCollection of DepartmentGroupViewModel the
             Schedule tab's tree reads (MainViewModel is Scoped and shared, see this page's
             code-behind), so a lingering search filter typed into that tab's search box
             (EmployeeTreeSearchFilter) could leave some of these with IsVisible=false. That's
             deliberately not honoured here: management shouldn't silently hide a department
             because of a filter left over from a different tab. The search box below is a
             page-local find-and-jump instead (see SearchEmployee in the code-behind). -->
        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Departments" Style="{StaticResource GroupLabel}" />
                <syncfusion:ButtonAdv Label="Add"
                                      IconTemplate="{StaticResource AddIconTemplate}"
                                      Style="{StaticResource ToolbarButton}"
                                      Command="{Binding AddDepartmentCommand}" />
                <syncfusion:ButtonAdv Label="Delete"
                                      IconTemplate="{StaticResource DeleteIconTemplate}"
                                      Style="{StaticResource ToolbarButton}"
                                      Command="{Binding DeleteDepartmentCommand}" />
            </StackPanel>

            <!-- Find-and-jump-to search, not a live filter: a match selects (and scrolls to)
                 the employee's department here and their row in the grid on the right;
                 nothing is ever hidden, so a stale term left in the box can't make anything
                 look missing. The suggestions are every employee as "LastName, FirstName
                 (PIN)", matched by PIN, first or last name (EmployeeSuggestionFilter); picking
                 one jumps straight to that person, and Enter or Search jumps to the first
                 match for whatever's typed. -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <syncfusion:ButtonAdv DockPanel.Dock="Right"
                                      Label="Search"
                                      IconTemplate="{StaticResource SearchIconTemplate}"
                                      SizeMode="Normal"
                                      Margin="6,0,0,0"
                                      Click="SearchEmployeeButton_Click" />
                <syncfusion:SfTextBoxExt x:Name="EmployeeSearchBox"
                                         Watermark="PIN, name or department"
                                         AutoCompleteMode="Suggest"
                                         SuggestionMode="Custom"
                                         SearchItemPath="Display"
                                         MaximumSuggestionsCount="8"
                                         SelectedItemChanged="EmployeeSearchBox_SelectedItemChanged"
                                         KeyDown="EmployeeSearchBox_KeyDown"
                                         ToolTip="A PIN, name, or department -- Enter or Search jumps to it; or pick a name from the list." />
            </DockPanel>

            <syncfusion:SfTreeView x:Name="DepartmentTree"
                                   ItemsSource="{Binding Departments}"
                                   SelectionMode="Single"
                                   FullRowSelect="True"
                                   FocusVisualStyle="{x:Null}"
                                   SelectionChanged="DepartmentTree_SelectionChanged">
                <syncfusion:SfTreeView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Employees.Count, StringFormat=' ({0})'}"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </syncfusion:SfTreeView.ItemTemplate>
            </syncfusion:SfTreeView>
        </DockPanel>

        <!-- Right: employees of whichever department is selected on the left. EmployeesGrid's
             ItemsSource reads straight off DepartmentTree's own SelectedItem;
             EmployeesGrid_SelectionChanged (code-behind) is what pushes a row selection back
             into MainViewModel.SelectedEmployee/SelectedDepartment, the same way
             DepartmentTree_SelectionChanged does for the tree. -->
        <DockPanel Grid.Column="1">
            <!-- Employee action buttons pinned to the right of this row; the status text sits at
                 the left - the "select a department" prompt while nothing's picked, the
                 department name + employee count once one is. Blacklist and Unblacklist are both
                 shown rather than swapped - their CanExecute keeps only the one that applies to
                 the current selection enabled, so the disabled one still hints the action
                 exists. -->
            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <syncfusion:ButtonAdv Label="Add"
                                          IconTemplate="{StaticResource AddIconTemplate}"
                                          Style="{StaticResource ToolbarButton}"
                                          Command="{Binding AddEmployeeCommand}" />
                    <syncfusion:ButtonAdv Label="Edit"
                                          IconTemplate="{StaticResource EditIconTemplate}"
                                          Style="{StaticResource ToolbarButton}"
                                          Command="{Binding EditEmployeeCommand}" />
                    <syncfusion:ButtonAdv Label="Delete"
                                          IconTemplate="{StaticResource DeleteIconTemplate}"
                                          Style="{StaticResource ToolbarButton}"
                                          Command="{Binding DeleteEmployeeCommand}" />
                    <syncfusion:ButtonAdv Label="Blacklist"
                                          IconTemplate="{StaticResource BlacklistIconTemplate}"
                                          Style="{StaticResource ToolbarButton}"
                                          Command="{Binding BlacklistEmployeeCommand}" />
                    <syncfusion:ButtonAdv Label="Unblacklist"
                                          IconTemplate="{StaticResource UnblacklistIconTemplate}"
                                          Style="{StaticResource ToolbarButton}"
                                          Command="{Binding UnblacklistEmployeeCommand}" />
                    <syncfusion:ButtonAdv Label="Import"
                                          IconTemplate="{StaticResource ImportIconTemplate}"
                                          Style="{StaticResource ToolbarButton}"
                                          Command="{Binding ImportEmployeesCommand}" />
                    <syncfusion:ButtonAdv Label="Export"
                                          IconTemplate="{StaticResource ExportIconTemplate}"
                                          SizeMode="Normal"
                                          Command="{Binding ExportEmployeesCommand}" />
                </StackPanel>

                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Text="Select a department on the left to view its employees."
                           Visibility="{Binding SelectedItem, ElementName=DepartmentTree, Converter={StaticResource NullToVisibility}}" />

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding SelectedItem, ElementName=DepartmentTree, Converter={StaticResource NotNullToVisibility}}">
                    <TextBlock FontWeight="SemiBold" Text="{Binding SelectedItem.Name, ElementName=DepartmentTree}" />
                    <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Margin="6,0,0,0">
                        <Run Text="{Binding SelectedItem.Employees.Count, ElementName=DepartmentTree, Mode=OneWay}" />
                        <Run Text=" employee(s)" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- Read-only. A blacklisted employee's row is greyed out rather than hidden:
                 unlike the Schedule/Attendance trees (EmployeeTreeSearchFilter), this grid is the
                 one place a blacklisted employee should still be visible, so they can be found
                 and unblacklisted later (see Employee.IsBlacklisted's own doc comment). The row
                 style is based on the theme's (Themes/SyncfusionBases.xaml), so the selection
                 highlight stays. Double-clicking a row is Edit. -->
            <syncfusion:SfDataGrid x:Name="EmployeesGrid"
                                   ItemsSource="{Binding SelectedItem.Employees, ElementName=DepartmentTree}"
                                   AutoGenerateColumns="False"
                                   AllowEditing="False"
                                   AllowResizingColumns="False"
                                   AllowDraggingColumns="False"
                                   SelectionMode="Single"
                                   NavigationMode="Row"
                                   GridLinesVisibility="Horizontal"
                                   SelectionChanged="EmployeesGrid_SelectionChanged"
                                   CellDoubleTapped="EmployeesGrid_CellDoubleTapped">
                <syncfusion:SfDataGrid.RowStyle>
                    <Style TargetType="syncfusion:VirtualizingCellsControl" BasedOn="{StaticResource GridRowStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Employee.IsBlacklisted}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
                                <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </syncfusion:SfDataGrid.RowStyle>
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn MappingName="Employee.Pin" HeaderText="PIN" Width="150" />
                    <syncfusion:GridTextColumn MappingName="Employee.LastName" HeaderText="Last Name" Width="220" />
                    <syncfusion:GridTextColumn MappingName="Employee.FirstName" HeaderText="First Name" Width="220" />

                    <!-- Department itself is deliberately not a column here: this grid is always
                         scoped to whichever department is selected on the left (or the
                         Unassigned bucket), so a per-row Department value would just repeat what
                         the header above the grid already says. -->

                    <syncfusion:GridNumericColumn MappingName="Employee.DailyRate" HeaderText="Daily Rate" Width="120"
                                                  NumberDecimalDigits="2" />
                    <syncfusion:GridCheckBoxColumn MappingName="Employee.QualifiesForOvertime" HeaderText="Overtime" Width="150" />
                    <syncfusion:GridCheckBoxColumn MappingName="Employee.ApplyOvertimeRatePercentageByDefault" HeaderText="OT Premium" Width="150" />
                    <syncfusion:GridCheckBoxColumn MappingName="Employee.QualifiesForNightDiff" HeaderText="Night Diff" Width="150" />
                    <syncfusion:GridNumericColumn MappingName="Employee.DefaultSss" HeaderText="SSS" Width="110"
                                                  NumberDecimalDigits="2" />
                    <syncfusion:GridNumericColumn MappingName="Employee.DefaultPhilHealth" HeaderText="PhilHealth" Width="110"
                                                  NumberDecimalDigits="2" />
                    <syncfusion:GridNumericColumn MappingName="Employee.DefaultPagIbig" HeaderText="Pag-IBIG" Width="110"
                                                  NumberDecimalDigits="2" />
                    <syncfusion:GridCheckBoxColumn MappingName="Employee.DefaultLeaveIsPaid" HeaderText="Leave w/ Pay" Width="150" />
                    <!-- Its own column, on top of the row style greying the whole row, so a
                         blacklisted employee reads as blacklisted even wherever the grid gets
                         scrolled horizontally. -->
                    <syncfusion:GridCheckBoxColumn MappingName="Employee.IsBlacklisted" HeaderText="Blacklisted" Width="150" />
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
        </DockPanel>
    </Grid>
</Page>
