<rxui:ReactiveUserControl x:Class="ScheduleApp.Desktop.Views.SignInPanel"
             x:TypeArguments="accounts:SignInViewModel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:rxui="http://reactiveui.net"
             xmlns:accounts="clr-namespace:ScheduleApp.Desktop.ViewModels.Accounts"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             Width="380">
    <Grid Margin="0,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Company logo, centered, with the sign-in fields below it - replaces the
             old plain-text "Schedule Manager" title now that the logo itself carries
             that branding. Source is the "/Assets/..." pack URI the Resource item in
             the .csproj makes available (see its own comment). -->
        <Image x:Name="LogoImage" Grid.Row="0" Source="/Assets/Tinapayan_Logo.png" Height="180" Stretch="Uniform"
               HorizontalAlignment="Center" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" Text="Sign in to continue" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,24" />

        <TextBlock Grid.Row="2" Text="Account name" Margin="0,0,0,4" />
        <syncfusion:SfTextBoxExt x:Name="UsernameBox" Grid.Row="3" Margin="0,0,0,12" />

        <TextBlock Grid.Row="4" Text="Password" Margin="0,0,0,4" />
        <PasswordBox x:Name="PasswordBoxControl" Grid.Row="5" Margin="0,0,0,4" />

        <CheckBox x:Name="RememberMeCheckBox" Grid.Row="6" Content="Remember me" Margin="0,8,0,0" />

        <TextBlock x:Name="ErrorText" Grid.Row="7" Foreground="{DynamicResource ErrorForegroundBrush}" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,8,0,0" VerticalAlignment="Top" />

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <syncfusion:ButtonAdv x:Name="SignInButton"
                                  Label="Sign In"
                                  IconTemplate="{StaticResource ApplyIconTemplate}"
                                  MinWidth="90"
                                  Margin="0,0,8,0"
                                  IsDefault="True" />
            <syncfusion:ButtonAdv x:Name="ExitButton"
                                  Label="Exit"
                                  IconTemplate="{StaticResource CancelIconTemplate}"
                                  MinWidth="90" />
        </StackPanel>
    </Grid>
</rxui:ReactiveUserControl>
