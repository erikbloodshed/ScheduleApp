<ui:FluentWindow x:Class="ScheduleApp.Desktop.Views.PayslipPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:utilities="clr-namespace:ScheduleApp.Desktop.Utilities"
        Title="Payslip Preview" Width="520" Height="600"
        MinWidth="420" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        utilities:WindowSizing.ConstrainToWorkArea="True"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- See MainWindow.xaml's own TitleBar comment for why every FluentWindow needs
             one of these - WPF-UI removes the native title bar entirely otherwise. -->
        <ui:TitleBar Grid.Row="0"
                Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                ShowMinimize="False"
                ShowMaximize="True"
                CanMaximize="True" />

    <Grid Grid.Row="1" Margin="16" RowDefinitions="Auto,*,Auto,Auto,Auto">

        <TextBlock Grid.Row="0"
                   Text="Preview -- 4 payslips per Letter page, cut apart along the quarter-page lines. Nothing is printed or saved until you choose Save or Print below."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,12" />

        <!-- Page display - either the rendered page image, or a "Rendering…"
             placeholder while PayslipRenderer.RenderPreview runs on a background
             thread (see the dialog's own Loaded handler). -->
        <Border Grid.Row="1"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Image x:Name="PageImage"
                       Stretch="Uniform"
                       Margin="4" />
                <StackPanel x:Name="BusyPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True"
                                 Width="140"
                                 Height="6"
                                 Margin="0,0,0,8" />
                    <TextBlock Text="Rendering…"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Prev/Next paging - see Print_Feature.md's own Preview section:
             "a simple Prev/Next image viewer". -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">
            <Button x:Name="PrevPageButton"
                    Content="‹ Prev"
                    Width="70"
                    Margin="0,0,8,0"
                    Click="PrevPageButton_Click" />
            <TextBlock x:Name="PageLabel"
                       Text="Page 1 of 1"
                       VerticalAlignment="Center"
                       Width="100"
                       TextAlignment="Center" />
            <Button x:Name="NextPageButton"
                    Content="Next ›"
                    Width="70"
                    Margin="8,0,0,0"
                    Click="NextPageButton_Click" />
        </StackPanel>

        <!-- Overflow escape-hatch notice - see Print_Feature.md's Layout section:
             "flagged in the export result". Collapsed when nothing overflowed. -->
        <TextBlock x:Name="OverflowNoticeText"
                   Grid.Row="3"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                   Padding="8"
                   Margin="0,10,0,0"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="SaveButton"
                    Content="Save…"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click"
                    ToolTip="Save the full PDF (every page shown here) to a location you choose." />
            <Button x:Name="OpenButton"
                    Content="Open"
                    Width="80"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="OpenButton_Click"
                    ToolTip="Open the saved PDF in your default viewer -- print from there for full control." />
            <Button x:Name="PrintButton"
                    Content="Print"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="PrintButton_Click"
                    ToolTip="Send straight to your default PDF handler without opening it first." />
            <Button Content="Close"
                    Width="80"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Grid>
</ui:FluentWindow>
