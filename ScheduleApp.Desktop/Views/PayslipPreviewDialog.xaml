<Window x:Class="ScheduleApp.Desktop.Views.PayslipPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utilities="clr-namespace:ScheduleApp.Desktop.Utilities"
        Title="Payslip Preview" Width="520" Height="600"
        MinWidth="420" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        utilities:WindowSizing.ConstrainToWorkArea="True">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto,Auto">

        <TextBlock Grid.Row="0"
                   Text="Preview -- 4 payslips per Letter page, cut apart along the quarter-page lines. Nothing is printed or saved until you choose Save or Print below."
                   TextWrapping="Wrap"
                   Foreground="#475569"
                   Margin="0,0,0,12" />

        <!-- Page display - either the rendered page image, or a "Rendering…"
             placeholder while PayslipRenderer.RenderPreview runs on a background
             thread (see the dialog's own Loaded handler). -->
        <Border Grid.Row="1"
                BorderThickness="1"
                BorderBrush="#D9D9D9"
                Background="#F1F5F9">
            <Grid>
                <Image x:Name="PageImage"
                       Stretch="Uniform"
                       Margin="4" />
                <StackPanel x:Name="BusyPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True"
                                 Width="140"
                                 Height="6"
                                 Margin="0,0,0,8" />
                    <TextBlock Text="Rendering…"
                               HorizontalAlignment="Center"
                               Foreground="#475569" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Prev/Next paging - see Print_Feature.md's own Preview section:
             "a simple Prev/Next image viewer". -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">
            <Button x:Name="PrevPageButton"
                    Content="‹ Prev"
                    Width="70"
                    Margin="0,0,8,0"
                    Click="PrevPageButton_Click" />
            <TextBlock x:Name="PageLabel"
                       Text="Page 1 of 1"
                       VerticalAlignment="Center"
                       Width="100"
                       TextAlignment="Center" />
            <Button x:Name="NextPageButton"
                    Content="Next ›"
                    Width="70"
                    Margin="8,0,0,0"
                    Click="NextPageButton_Click" />
        </StackPanel>

        <!-- Overflow escape-hatch notice - see Print_Feature.md's Layout section:
             "flagged in the export result". Collapsed when nothing overflowed. -->
        <TextBlock x:Name="OverflowNoticeText"
                   Grid.Row="3"
                   TextWrapping="Wrap"
                   Foreground="#B45309"
                   Background="#FEF3C7"
                   Padding="8"
                   Margin="0,10,0,0"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="SaveButton"
                    Content="Save…"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click"
                    ToolTip="Save the full PDF (every page shown here) to a location you choose." />
            <Button x:Name="OpenButton"
                    Content="Open"
                    Width="80"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="OpenButton_Click"
                    ToolTip="Open the saved PDF in your default PDF viewer -- print from there for full control over the printer/copies/etc." />
            <Button x:Name="PrintButton"
                    Content="Print"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="PrintButton_Click"
                    ToolTip="Send straight to your default printer's PDF handler (e.g. the browser or PDF reader set as your default) without opening it first." />
            <Button Content="Close"
                    Width="80"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
