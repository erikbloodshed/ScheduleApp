<controls:ReactiveAppWindow x:Class="ScheduleApp.Desktop.Views.AddUserDialog" ShowMinimizeButton="False" ShowMaximizeButton="False"
        x:TypeArguments="accounts:AddUserViewModel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:accounts="clr-namespace:ScheduleApp.Desktop.ViewModels.Accounts"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
        Title="Add User" Width="340" Height="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

    <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Account name" Margin="0,0,0,4" />
        <syncfusion:SfTextBoxExt x:Name="UsernameBox" Grid.Row="1" Margin="0,0,0,12" />

        <TextBlock Grid.Row="2" Text="Password (at least 8 characters)" Margin="0,0,0,4" />
        <PasswordBox x:Name="PasswordBoxControl" Grid.Row="3" Margin="0,0,0,12" />

        <TextBlock Grid.Row="4" Text="Confirm password" Margin="0,0,0,4" />
        <PasswordBox x:Name="ConfirmPasswordBoxControl" Grid.Row="5" Margin="0,0,0,4" />

        <TextBlock x:Name="ErrorText" Grid.Row="6" Foreground="{DynamicResource ErrorForegroundBrush}" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,8,0,0" VerticalAlignment="Top" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <syncfusion:ButtonAdv x:Name="OkButton"
                                  Label="Add"
                                  IconTemplate="{StaticResource AddIconTemplate}"
                                  MinWidth="80"
                                  Margin="0,0,8,0"
                                  IsDefault="True" />
            <syncfusion:ButtonAdv Label="Cancel"
                                  IconTemplate="{StaticResource CancelIconTemplate}"
                                  MinWidth="80"
                                  IsCancel="True" />
        </StackPanel>
    </Grid>
</Grid>
</controls:ReactiveAppWindow>
