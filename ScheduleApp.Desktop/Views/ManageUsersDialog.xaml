<controls:AppWindow x:Class="ScheduleApp.Desktop.Views.ManageUsersDialog" ShowMinimizeButton="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
        Title="Manage Users" Width="520" Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

    <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Accounts that can sign in to Schedule Manager. Every account can do everything the app already lets anyone do -- there are no separate roles."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   Margin="0,0,0,12" />

        <syncfusion:SfDataGrid x:Name="UsersGrid"
                               Grid.Row="1"
                               AutoGenerateColumns="False"
                               AllowEditing="False"
                               AllowDraggingColumns="False"
                               SelectionMode="Single"
                               NavigationMode="Row"
                               GridLinesVisibility="Horizontal"
                               SelectionChanged="UsersGrid_SelectionChanged">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="Username" HeaderText="Account name" ColumnSizer="Star" />
                <syncfusion:GridTextColumn MappingName="CreatedDisplay" HeaderText="Created" Width="140" />
                <syncfusion:GridTextColumn MappingName="StatusDisplay" HeaderText="Status" Width="90" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#DC2626" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,8,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <syncfusion:ButtonAdv x:Name="AddButton"
                                  Label="Add User…"
                                  SizeMode="Normal"
                                  IconTemplate="{StaticResource AddIconTemplate}"
                                  Margin="0,0,8,0"
                                  Click="AddButton_Click" />
            <syncfusion:ButtonAdv x:Name="ResetPasswordButton"
                                  Label="Reset Password…"
                                  SizeMode="Normal"
                                  Tag="&#xE8D7;"
                                  IconTemplate="{StaticResource TagGlyphIconTemplate}"
                                  Margin="0,0,8,0"
                                  IsEnabled="False"
                                  Click="ResetPasswordButton_Click" />
            <syncfusion:ButtonAdv x:Name="ToggleActiveButton"
                                  Label="Deactivate"
                                  SizeMode="Normal"
                                  Tag="&#xE72E;"
                                  IconTemplate="{StaticResource TagGlyphIconTemplate}"
                                  Margin="0,0,8,0"
                                  IsEnabled="False"
                                  Click="ToggleActiveButton_Click" />
            <syncfusion:ButtonAdv x:Name="DeleteButton"
                                  Label="Delete"
                                  SizeMode="Normal"
                                  IconTemplate="{StaticResource DeleteIconTemplate}"
                                  Margin="0,0,8,0"
                                  IsEnabled="False"
                                  Click="DeleteButton_Click" />
            <syncfusion:ButtonAdv Label="Close"
                                  SizeMode="Normal"
                                  IconTemplate="{StaticResource CancelIconTemplate}"
                                  IsDefault="True"
                                  IsCancel="True" />
        </StackPanel>
    </Grid>
</Grid>
</controls:AppWindow>
