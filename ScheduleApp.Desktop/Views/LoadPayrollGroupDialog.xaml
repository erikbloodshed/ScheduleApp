<ui:FluentWindow x:Class="ScheduleApp.Desktop.Views.LoadPayrollGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels"
        Title="Load Payroll Group"
        Width="460" Height="520"
        MinWidth="380" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- See MainWindow.xaml's own TitleBar comment for why every FluentWindow needs
             one of these - WPF-UI removes the native title bar entirely otherwise. -->
        <ui:TitleBar Grid.Row="0"
                Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                ShowMinimize="False"
                ShowMaximize="True"
                CanMaximize="True" />

    <Grid Grid.Row="1" Margin="16"
          RowDefinitions="Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0"
                   Text="Reopen a payroll run saved via &quot;New Payroll Run…&quot; -- picking one sets this tab's period and employee checklist back to what was saved, the same as when it was first confirmed."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,12" />

        <!-- Same IsIndeterminate ProgressBar-while-running idea as PayrollPage's own
             global indicator (see that file), just scoped to this dialog's own
             IsLoading rather than a shared busy state - a single ListAsync round trip
             has nothing else running alongside it to share state with. -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,8"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar IsIndeterminate="True"
                         Width="120"
                         Height="4"
                         VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="2">
            <!-- Shown once loading has finished and there's genuinely nothing saved yet
                 - see LoadPayrollGroupViewModel.HasNoRuns's own doc comment for why this
                 is distinct from the loading state above rather than folded into one
                 "list is empty" check. -->
            <TextBlock Text="No saved payroll runs yet -- use &quot;New Payroll Run…&quot; to create one."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasNoRuns, Converter={StaticResource BoolToVisibility}}" />

            <ListBox x:Name="RunsListBox"
                     ItemsSource="{Binding Runs}"
                     SelectedItem="{Binding SelectedRun}"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseDoubleClick="RunsListBox_OnMouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LoadPayrollGroupRunItem}">
                        <StackPanel>
                            <TextBlock Text="{Binding Run.Label}"
                                       FontWeight="SemiBold" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0">
                                <Run Text="{Binding Run.PeriodStart, StringFormat='{}{0:MMM d, yyyy}', Mode=OneWay}" />
                                <Run Text="–" />
                                <Run Text="{Binding Run.PeriodEnd, StringFormat='{}{0:MMM d, yyyy}', Mode=OneWay}" />
                                <Run Text="{Binding EmployeeCountText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0">
                                <Run Text="Saved" />
                                <Run Text="{Binding Run.CreatedAt, StringFormat='{}{0:MMM d, yyyy h:mm tt}', Mode=OneWay}" />
                                <Run Text="by" />
                                <Run Text="{Binding Run.CreatedBy, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Row="3"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left-aligned and visually separated from Load/Cancel on the right -
                 same "destructive action gets its own corner" placement
                 ManageUsersDialog's own Delete button uses, so it can't be
                 mis-clicked in place of Load. Disabled state (nothing selected, or a
                 load/delete already in flight) comes from
                 LoadPayrollGroupViewModel.CanDeleteRun, not anything in this file. -->
            <Button Grid.Column="0"
                    Content="Delete…"
                    Command="{Binding DeletePayrollRunCommand}"
                    HorizontalAlignment="Left"
                    Width="90"
                    ToolTip="Permanently deletes this saved payroll run -- doesn't affect the employees' own payroll figures for that period." />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button x:Name="LoadButton"
                        Content="Load"
                        Width="90"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="LoadButton_Click" />
                <Button Content="Cancel"
                        Width="80"
                        IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Grid>
</ui:FluentWindow>
