<controls:ReactiveAppWindow x:Class="ScheduleApp.Desktop.Views.LoadPayrollGroupDialog" ShowMinimizeButton="False"
        x:TypeArguments="vm:LoadPayrollGroupViewModel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
        xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels"
        Title="Load Payroll Group"
        Width="460" Height="520"
        MinWidth="380" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

    <Grid Grid.Row="1" Margin="16"
          RowDefinitions="Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0"
                   Text="Reopen a payroll run saved via &quot;New Payroll Run…&quot; -- picking one sets this tab's period and employee checklist back to what was saved, the same as when it was first confirmed."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   Margin="0,0,0,12" />

        <!-- Same IsIndeterminate ProgressBar-while-running idea as PayrollPage's own
             global indicator (see that file), just scoped to this dialog's own
             IsLoading rather than a shared busy state - a single ListAsync round trip
             has nothing else running alongside it to share state with. -->
        <StackPanel x:Name="LoadingIndicator"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">
            <ProgressBar IsIndeterminate="True"
                         Width="120"
                         Height="4"
                         VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="2">
            <!-- Shown once loading has finished and there's genuinely nothing saved yet
                 - see LoadPayrollGroupViewModel.HasNoRuns's own doc comment for why this
                 is distinct from the loading state above rather than folded into one
                 "list is empty" check. -->
            <TextBlock x:Name="NoRunsText"
                       Text="No saved payroll runs yet -- use &quot;New Payroll Run…&quot; to create one."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <ListBox x:Name="RunsListBox"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource CardBorderBrush}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LoadPayrollGroupRunItem}">
                        <StackPanel>
                            <TextBlock Text="{Binding Run.Label}"
                                       FontWeight="SemiBold" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,2,0,0">
                                <Run Text="{Binding Run.PeriodStart, StringFormat='{}{0:MMM d, yyyy}', Mode=OneWay}" />
                                <Run Text="–" />
                                <Run Text="{Binding Run.PeriodEnd, StringFormat='{}{0:MMM d, yyyy}', Mode=OneWay}" />
                                <Run Text="{Binding EmployeeCountText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,2,0,0">
                                <Run Text="Saved" />
                                <Run Text="{Binding Run.CreatedAt, StringFormat='{}{0:MMM d, yyyy h:mm tt}', Mode=OneWay}" />
                                <Run Text="by" />
                                <Run Text="{Binding Run.CreatedBy, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Row="3"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left-aligned and visually separated from Load/Cancel on the right -
                 same "destructive action gets its own corner" placement
                 ManageUsersDialog's own Delete button uses, so it can't be
                 mis-clicked in place of Load. Disabled state (nothing selected, or a
                 load/delete already in flight) comes from
                 LoadPayrollGroupViewModel.DeletePayrollRunCommand's own CanExecute. -->
            <syncfusion:ButtonAdv x:Name="DeleteButton"
                                  Grid.Column="0"
                                  Label="Delete…"
                                  IconTemplate="{StaticResource DeleteIconTemplate}"
                                  HorizontalAlignment="Left"
                                  MinWidth="90"
                                  ToolTip="Permanently deletes this saved payroll run -- doesn't affect the employees' own payroll figures for that period." />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <syncfusion:ButtonAdv x:Name="LoadButton"
                                      Label="Load"
                                      IconTemplate="{StaticResource FolderIconTemplate}"
                                      MinWidth="90"
                                      Margin="0,0,8,0"
                                      IsDefault="True" />
                <syncfusion:ButtonAdv Label="Cancel"
                                      IconTemplate="{StaticResource CancelIconTemplate}"
                                      MinWidth="80"
                                      IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Grid>
</controls:ReactiveAppWindow>
