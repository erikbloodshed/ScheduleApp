<ui:FluentWindow x:Class="ScheduleApp.Desktop.Views.ApplyScheduleDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:converters="clr-namespace:ScheduleApp.Desktop.Converters"
                 xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
                 xmlns:utilities="clr-namespace:ScheduleApp.Desktop.Utilities"
                 Title="Set Schedule for Selected Days"
                 Width="560"
                 Height="600"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 utilities:WindowSizing.ConstrainToWorkArea="True"
                 ExtendsContentIntoTitleBar="True">
  <Window.Resources>
    <converters:ScheduleTypeToDisplayTextConverter x:Key="ScheduleTypeToDisplayText" />
  </Window.Resources>
  <!-- DockPanel instead of a bare Grid so OK/Cancel (docked Bottom) stay
         visible and reachable no matter how tall the form above them gets.
         A fixed Height on the Window (above) keeps the window itself at a
         size that fits comfortably even on a 768px-tall laptop screen, and
         the ScrollViewer below picks up whatever doesn't fit, e.g. Split Shift
         with several windows plus the Overtime/Night Diff panel both showing
         at once. Previously the root was a single Grid with no scroll
         fallback and no window size cap, so that combination could in
         principle push the OK button below the visible screen area with
         nothing to scroll it back into view. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- See MainWindow.xaml's own TitleBar comment for why every FluentWindow needs
             one of these - WPF-UI removes the native title bar entirely otherwise. -->
    <ui:TitleBar Grid.Row="0"
                 Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                 ShowMinimize="False"
                 ShowMaximize="False"
                 CanMaximize="False" />

    <DockPanel Grid.Row="1"
               Margin="16">
      <StackPanel DockPanel.Dock="Bottom"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,16,0,0">
        <Button Content="OK"
                Width="80"
                Margin="0,0,8,0"
                IsDefault="True"
                Click="OkButton_Click" />
        <Button Content="Cancel"
                Width="80"
                IsCancel="True" />
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,4,0"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnDefinitions="*,*">

          <TextBlock x:Name="EmployeeHeader"
                     Grid.Row="0"
                     Grid.Column="0"
                     Grid.ColumnSpan="2"
                     FontWeight="Bold"
                     TextWrapping="Wrap"
                     Margin="0,0,0,8" />

          <TextBlock Text="Selected days"
                     Grid.Row="1"
                     Grid.Column="0"
                     Grid.ColumnSpan="2"
                     Margin="0,0,0,4" />
          <Border Grid.Row="2"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  Padding="8"
                  Margin="0,0,0,12"
                  MaxHeight="100">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="SummaryText"
                         TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>

          <TextBlock x:Name="MixedScheduleNote"
                     Grid.Row="3"
                     Grid.Column="0"
                     Grid.ColumnSpan="2"
                     Margin="0,0,0,12"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource SystemFillColorCautionBrush}"
                     FontStyle="Italic"
                     Visibility="Collapsed"
                     Text="Selected days don't all have the same schedule, so the fields below start blank rather than guessing. Anything you set here will be applied to every selected day." />

          <TextBlock Text="Type"
                     Grid.Row="4"
                     Grid.Column="0"
                     Grid.ColumnSpan="2"
                     Margin="0,0,0,4" />
          <ComboBox x:Name="TypeCombo"
                    Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,12"
                    SelectionChanged="TypeCombo_SelectionChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource ScheduleTypeToDisplayText}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- RestDay-only. Governs the two fields below directly, replacing the old
             "leave Work time and Time in both blank via the text/picker controls
             themselves" convention (see isRestDay's doc comment on
             UpdateFieldAvailability for the two calculation modes this chooses
             between). That convention worked for WorkTimeBox - a plain TextBox
             can just be cleared - but the three-dropdown TimePicker this dialog
             used at the time offered no blank option once a value had been
             picked, so there was no way to get back to the unscheduled mode
             through the UI at all short of re-opening the dialog. TimeInput,
             which replaced it, can be blanked again, but this checkbox stays:
             saying "this rest day has no schedule" out loud beats inferring it
             from two fields someone happened to leave empty.
             Checked/unchecked drives Work time/Time in's own
             visibility below instead of the person having to blank them by hand,
             and OkButton_Click reads this instead of the two fields' blankness
             (see isUnscheduledRestDay there). Unchecked is the default for a
             brand-new RestDay entry - see the constructor - and means a plain
             day off: no Rest Day Duty pay is possible for it no matter what's
             punched (see RestDayShiftCalculationStrategy.CalculateUnscheduledDay).
             Only checking this box and giving the day a fixed window can earn
             the premium. -->
          <CheckBox x:Name="RestDayDutyCheckBox"
                    Content="Scheduled duty (set a fixed work time / time in for this rest day)"
                    Grid.Row="6"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,10"
                    Visibility="Collapsed"
                    Checked="RestDayDutyCheckBox_CheckedChanged"
                    Unchecked="RestDayDutyCheckBox_CheckedChanged"
                    ToolTip="Unchecked (default): plain rest day, punches never honored. Checked: matches punches like a Normal shift within a fixed Work time/Time in window to earn Rest Day Duty pay." />

          <TextBlock x:Name="WorkTimeLabel"
                     Text="Work time (hours)"
                     Grid.Row="7"
                     Grid.Column="0"
                     Margin="0,0,8,4" />
          <TextBlock x:Name="TimeInLabel"
                     Text="Time in"
                     Grid.Row="7"
                     Grid.Column="1"
                     Margin="8,0,0,4" />
          <TextBox x:Name="WorkTimeBox"
                   Grid.Row="8"
                   Grid.Column="0"
                   Width="90"
                   HorizontalAlignment="Left"
                   Margin="0,0,8,12"
                   ToolTip="Shift length for Normal; required total hours for Flexible/Split Shift; scheduled length to match for Rest Day duty." />
          <controls:TimeInput x:Name="TimeInPicker"
                              Grid.Row="8"
                              Grid.Column="1"
                              Density="Compact"
                              HorizontalAlignment="Left"
                              Margin="8,0,0,12" />

          <!-- Leave-only - shares rows 7-8, column 0, with Work time above (mutually
             exclusive by type, same swap pattern as the Restricted-window/
             Split-Shift-segments vs. Normal-buffer rows below), since Leave needs
             neither Work time nor Time in but does need this instead. Payroll's
             Basic Pay for the day reads this straight off ScheduleEntry.IsPaidLeave
             - see that property's own doc comment for what Paid/Unpaid means
             there. -->
          <TextBlock x:Name="LeavePayLabel"
                     Text="Leave pay"
                     Grid.Row="7"
                     Grid.Column="0"
                     Margin="0,0,8,4"
                     Visibility="Collapsed" />
          <StackPanel x:Name="LeavePayPanel"
                      Grid.Row="8"
                      Grid.Column="0"
                      Orientation="Horizontal"
                      Margin="0,0,8,12"
                      VerticalAlignment="Center"
                      Visibility="Collapsed">
            <RadioButton x:Name="PaidLeaveRadio"
                         GroupName="LeavePay"
                         Content="Paid"
                         IsChecked="True"
                         Margin="0,0,16,0" />
            <RadioButton x:Name="UnpaidLeaveRadio"
                         GroupName="LeavePay"
                         Content="Unpaid" />
          </StackPanel>

          <!-- Flexible-only: the day's single required punching window
             (RestrictedTimeIn/RestrictedTimeOut) - shares rows 9-10 with the
             Split Shift segments UI below and the Normal/Official Business
             buffer overrides further down, since exactly one of Normal/
             Official Business, Split Shift, Flexible is ever visible at a
             time (same sharing pattern NormalBufferLabel's own comment
             describes). Both fields required as of the "make Flexible
             restricted" change - see OkButton_Click and RestrictedTimeIn's
             own doc comment in the code-behind for why the old "leave both
             blank" fallback was dropped from this dialog (the underlying
             ScheduleEntry fields stay nullable for other callers, e.g. the
             Excel importer). -->
          <TextBlock x:Name="RestrictedTimeLabel"
                     Text="Punching window (required -- punches outside this range won't count)"
                     Grid.Row="9"
                     Grid.Column="0"
                     Grid.ColumnSpan="2"
                     Margin="0,12,0,4"
                     TextWrapping="Wrap"
                     Visibility="Collapsed" />

          <Border x:Name="RestrictedTimeBorder"
                  Grid.Row="10"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  Padding="8"
                  Margin="0,0,0,6"
                  Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0"
                         Grid.Column="0"
                         Text="Time in"
                         FontSize="11"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Margin="0,0,4,2" />
              <TextBlock Grid.Row="0"
                         Grid.Column="1"
                         Text="Time out"
                         FontSize="11"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Margin="4,0,0,2" />
              <controls:TimeInput x:Name="RestrictedTimeInPicker"
                                  Grid.Row="1"
                                  Grid.Column="0"
                                  Density="Compact"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,4,0"
                                  ToolTip="Caps how early a punch counts toward WorkedHours -- still shows in ClockIn, just clamped for the hours math." />
              <controls:TimeInput x:Name="RestrictedTimeOutPicker"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Density="Compact"
                                  HorizontalAlignment="Left"
                                  Margin="4,0,0,0"
                                  ToolTip="Excludes punches after this time from the day's search entirely -- a boundary, not a cap." />
            </Grid>
          </Border>

          <TextBlock x:Name="SegmentsLabel"
                     Text="Split shift punching windows -- add each window this day allows punches (leave empty for none)"
                     Grid.Row="9"
                     Grid.Column="0"
                     Grid.ColumnSpan="2"
                     Margin="0,12,0,4"
                     TextWrapping="Wrap"
                     Visibility="Collapsed" />

          <Border x:Name="SegmentsBorder"
                  Grid.Row="10"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  Padding="6"
                  Margin="0,0,0,6"
                  MaxHeight="240"
                  Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="SegmentsPanel"
                          HorizontalAlignment="Left" />
            </ScrollViewer>
          </Border>

          <Button x:Name="AddSegmentButton"
                  Grid.Row="11"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Content="+ Add window"
                  HorizontalAlignment="Left"
                  Padding="8,3"
                  Margin="0,0,0,4"
                  Visibility="Collapsed"
                  Click="AddSegmentButton_Click" />

          <!-- Buffer overrides for the two types that actually match punches
             against a single scheduled window via SingleWindowShiftCalculationStrategy
             - Normal, and RestDay when its Work time/Time in are both filled in
             (the windowed sub-case; see RestDayShiftCalculationStrategy and
             isRestDay's doc comment in the code-behind's UpdateFieldAvailability).
             Equivalent of the Split Shift segment buffer overrides above - shares
             rows 9-10 with the Restricted punching window UI and the Split Shift
             segments UI above, since exactly one of Normal/RestDay, Flexible,
             Split Shift (Official Business shows none of the three) is ever
             visible at a time, so this never actually competes with either for
             space. Grayed-out policy-default placeholder behavior is handled the
             same way, via InitializeBufferBox (see code-behind). -->
          <TextBlock x:Name="NormalBufferLabel"
                     Text="Clock-in / clock-out buffer overrides (optional -- overrides the employee's own default, or the policy default, just for this day)"
                     Grid.Row="9"
                     Grid.Column="0"
                     Grid.ColumnSpan="2"
                     Margin="0,12,0,4"
                     TextWrapping="Wrap"
                     Visibility="Collapsed" />

          <Border x:Name="NormalBufferBorder"
                  Grid.Row="10"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  Padding="8"
                  Margin="0,0,0,6"
                  Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0"
                         Grid.Column="0"
                         Text="Clock-in buffer, before (h)"
                         FontSize="11"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Margin="0,0,4,2" />
              <TextBlock Grid.Row="0"
                         Grid.Column="1"
                         Text="Clock-in buffer, after (h)"
                         FontSize="11"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Margin="4,0,0,2" />
              <TextBox x:Name="ClockInBufferBeforeBox"
                       Grid.Row="1"
                       Grid.Column="0"
                       Width="70"
                       HorizontalAlignment="Left"
                       Margin="0,0,4,10"
                       ToolTip="How many hours before the scheduled time in a punch still counts as clock-in. Grayed-out tracks the employee/policy default live; type over it to lock in just this day." />
              <TextBox x:Name="ClockInBufferAfterBox"
                       Grid.Row="1"
                       Grid.Column="1"
                       Width="70"
                       HorizontalAlignment="Left"
                       Margin="4,0,0,10"
                       ToolTip="How many hours after the scheduled time in a punch still counts as clock-in. Grayed-out tracks the employee/policy default live; type over it to lock in just this day." />

              <TextBlock Grid.Row="2"
                         Grid.Column="0"
                         Text="Clock-out buffer, before (h)"
                         FontSize="11"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Margin="0,0,4,2" />
              <TextBlock Grid.Row="2"
                         Grid.Column="1"
                         Text="Clock-out buffer, after (h)"
                         FontSize="11"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Margin="4,0,0,2" />
              <TextBox x:Name="ClockOutBufferBeforeBox"
                       Grid.Row="3"
                       Grid.Column="0"
                       Width="70"
                       HorizontalAlignment="Left"
                       Margin="0,0,4,0"
                       ToolTip="How many hours before the scheduled time out a punch still counts as clock-out. Grayed-out tracks the employee/policy default live; type over it to lock in just this day." />
              <TextBox x:Name="ClockOutBufferAfterBox"
                       Grid.Row="3"
                       Grid.Column="1"
                       Width="70"
                       HorizontalAlignment="Left"
                       Margin="4,0,0,0"
                       ToolTip="How many hours after the scheduled time out a punch still counts as clock-out. Grayed-out tracks the employee/policy default live; type over it to lock in just this day." />
            </Grid>
          </Border>

          <!-- Overtime/Night Diff per-day overrides, added by the Attendance & Payroll
             Calculation Refactor Plan - visible for Normal, Flexible, SplitShift
             (all three compute OvertimeHours/NightDiffHours; see
             SingleWindowShiftCalculationStrategy/FlexibleShiftCalculationStrategy/
             SplitShiftCalculationStrategy), and RestDay too - though RestDay only
             ever acts on the Night Diff half of this panel (RestDayShiftCalculationStrategy
             never populates OvertimeHours in either of its modes, so the Overtime
             controls are inert but harmless for it; a separate, pre-existing gap,
             not addressed here). Hidden for Leave and Official Business (neither
             ever has overtime or night diff hours - see
             OfficialBusinessShiftCalculationStrategy's own doc comment on why it
             deliberately never sets NightDiffHours). Rows 12-13, below the
             type-specific rows above rather than sharing with any of them, since -
             unlike Normal-buffers-vs-Split-Shift-segments-vs-Restricted-window -
             this section is shown for four of the five types at once, not exactly
             one. -->
          <TextBlock x:Name="OvertimeNightDiffLabel"
                     Grid.Row="12"
                     Grid.Column="0"
                     Grid.ColumnSpan="2"
                     Margin="0,12,0,4"
                     TextWrapping="Wrap"
                     Text="Overtime / Night differential overrides (optional -- applies to every selected day)" />

          <Border x:Name="OvertimeNightDiffBorder"
                  Grid.Row="13"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  Padding="8"
                  Margin="0,0,0,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0"
                         Grid.Column="0"
                         Text="Overtime eligible"
                         FontSize="11"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Margin="0,0,4,2" />
              <TextBlock Grid.Row="0"
                         Grid.Column="1"
                         Text="Night diff eligible"
                         FontSize="11"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Margin="4,0,0,2" />
              <ComboBox x:Name="OvertimeEligibleCombo"
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,4,10"
                        HorizontalAlignment="Stretch"
                        ToolTip="Per-day override of overtime eligibility -- 'Use employee default' inherits it; 'Eligible'/'Not eligible' overrides just this day, without changing the employee's own setting." />
              <ComboBox x:Name="NightDiffEligibleCombo"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="4,0,0,10"
                        HorizontalAlignment="Stretch"
                        ToolTip="Per-day override of night differential eligibility -- 'Use employee default' inherits it; 'Eligible'/'Not eligible' overrides just this day." />

              <TextBlock Grid.Row="2"
                         Grid.Column="0"
                         Text="Overtime premium applies"
                         FontSize="11"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Margin="0,0,4,2" />
              <ComboBox x:Name="ApplyOvertimeRatePercentageCombo"
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,0,4,10"
                        HorizontalAlignment="Stretch"
                        ToolTip="Per-day override of the overtime premium (separate from eligibility above) -- 'Apply premium' pays rate x (1 + overtime %); 'Straight time only' pays plain hourly rate. No Night Diff equivalent; its rate always applies once eligible." />

              <TextBlock Grid.Row="4"
                         Grid.Column="0"
                         Text="Overtime rate % override"
                         FontSize="11"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Margin="0,0,4,2" />
              <TextBlock Grid.Row="4"
                         Grid.Column="1"
                         Text="Night diff rate % override"
                         FontSize="11"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Margin="4,0,0,2" />
              <TextBox x:Name="OvertimeRatePercentageBox"
                       Grid.Row="5"
                       Grid.Column="0"
                       Width="70"
                       HorizontalAlignment="Left"
                       Margin="0,0,4,0"
                       ToolTip="Overrides the overtime rate % for just this day. Grayed-out tracks the policy default live; type over it to lock in. Only applies when eligible and the premium is on." />
              <TextBox x:Name="NightDiffRatePercentageBox"
                       Grid.Row="5"
                       Grid.Column="1"
                       Width="70"
                       HorizontalAlignment="Left"
                       Margin="4,0,0,0"
                       ToolTip="Overrides the night differential rate % for just this day. Grayed-out tracks the policy default live; type over it to lock in. Only applies when eligible." />
            </Grid>
          </Border>

        </Grid>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</ui:FluentWindow>
