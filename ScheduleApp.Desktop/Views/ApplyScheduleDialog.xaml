<controls:ReactiveAppWindow x:Class="ScheduleApp.Desktop.Views.ApplyScheduleDialog" ShowMinimizeButton="False" ShowMaximizeButton="False"
                 x:TypeArguments="schedule:ApplyScheduleViewModel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                 xmlns:converters="clr-namespace:ScheduleApp.Desktop.Converters"
                 xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
                 xmlns:utilities="clr-namespace:ScheduleApp.Desktop.Utilities"
                 xmlns:schedule="clr-namespace:ScheduleApp.Desktop.ViewModels.Schedule"
                 xmlns:views="clr-namespace:ScheduleApp.Desktop.Views"
                 Width="560"
                 Height="600"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 utilities:WindowSizing.ConstrainToWorkArea="True">
  <Window.Resources>
    <converters:ScheduleTypeToDisplayTextConverter x:Key="ScheduleTypeToDisplayText" />

    <Style x:Key="FieldCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
    </Style>

    <!-- One Split Shift punching window: its times, a remove button, and its optional buffer
         overrides on their own row (the dialog isn't wide enough for both on one). -->
    <DataTemplate x:Key="SegmentTemplate" DataType="{x:Type schedule:ScheduleSegmentViewModel}">
      <Grid Margin="0,0,0,8" ColumnDefinitions="*,Auto,*,Auto" RowDefinitions="Auto,Auto">
        <controls:TimeInput Grid.Column="0" Margin="0,0,4,0" SelectedTime="{Binding TimeIn}" />
        <TextBlock Grid.Column="1" Text="-" VerticalAlignment="Center" Margin="0,0,4,0" />
        <controls:TimeInput Grid.Column="2" Margin="0,0,4,0" SelectedTime="{Binding TimeOut}" />
        <syncfusion:ButtonAdv Grid.Column="3"
                              SizeMode="Small"
                              IconTemplate="{StaticResource CancelIconTemplate}"
                              ToolTip="Remove this window"
                              Command="{Binding ViewModel.RemoveSegmentCommand, RelativeSource={RelativeSource AncestorType=views:ApplyScheduleDialog}}"
                              CommandParameter="{Binding}" />
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,2,0,0">
          <TextBlock Text="In buffer (h):" Style="{StaticResource FieldCaption}" VerticalAlignment="Center" Margin="0,0,4,0" />
          <syncfusion:SfTextBoxExt Width="40"
                                   Margin="0,0,4,0"
                                   utilities:DefaultTextBox.Source="{Binding ClockInBuffer}"
                                   ToolTip="Clock-in search window override, in hours either side of the start time above. Shown grayed-out at the current policy default -- type over it to set an override just for this segment, or leave it as-is to keep tracking the policy default even if it changes later." />
          <TextBlock Text="Out buffer (h):" Style="{StaticResource FieldCaption}" VerticalAlignment="Center" Margin="0,0,4,0" />
          <syncfusion:SfTextBoxExt Width="40"
                                   Margin="0,0,4,0"
                                   utilities:DefaultTextBox.Source="{Binding ClockOutBuffer}"
                                   ToolTip="Clock-out search window override, in hours either side of the end time above. Shown grayed-out at the current policy default -- type over it to set an override just for this segment, or leave it as-is to keep tracking the policy default even if it changes later." />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <!-- OK/Cancel are docked to the bottom and the form scrolls, so the buttons stay reachable at
       any height (Split Shift with several windows plus the Overtime panel, on a short screen). -->
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <syncfusion:ButtonAdv x:Name="OkButton"
                            Label="OK"
                            IconTemplate="{StaticResource ApplyIconTemplate}"
                            Width="80"
                            Margin="0,0,8,0"
                            IsDefault="True" />
      <syncfusion:ButtonAdv Label="Cancel"
                            IconTemplate="{StaticResource CancelIconTemplate}"
                            Width="80"
                            IsCancel="True" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <!-- Rows 7-8 are shared by Work time/Time in and Leave pay, and rows 9-10 by the Flexible
           window, the Split Shift windows and the Normal buffers; each type shows exactly one
           of them. -->
      <Grid Margin="0,0,4,0"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
            ColumnDefinitions="*,*">

        <TextBlock x:Name="EmployeeHeader"
                   Grid.Row="0"
                   Grid.ColumnSpan="2"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <TextBlock Text="Selected days" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,4" />
        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,0,12"
                MaxHeight="100">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>

        <TextBlock x:Name="MixedScheduleNote"
                   Grid.Row="3"
                   Grid.ColumnSpan="2"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource WarningForegroundBrush}"
                   FontStyle="Italic"
                   Text="Selected days don't all have the same schedule, so the fields below start blank rather than guessing. Anything you set here will be applied to every selected day." />

        <TextBlock Text="Type" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,4" />
        <syncfusion:ComboBoxAdv x:Name="TypeCombo"
                                Grid.Row="5"
                                Grid.ColumnSpan="2"
                                Margin="0,0,0,12">
          <syncfusion:ComboBoxAdv.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource ScheduleTypeToDisplayText}}" />
            </DataTemplate>
          </syncfusion:ComboBoxAdv.ItemTemplate>
        </syncfusion:ComboBoxAdv>

        <!-- Rest Day only: says out loud that this rest day has a fixed window (and so can earn
             Rest Day Duty pay), rather than inferring it from two fields left blank. -->
        <CheckBox x:Name="RestDayDutyCheckBox"
                  Content="Scheduled duty (set a fixed work time / time in for this rest day)"
                  Grid.Row="6"
                  Grid.ColumnSpan="2"
                  Margin="0,0,0,10"
                  ToolTipService.ShowOnDisabled="True" />

        <TextBlock x:Name="WorkTimeLabel" Text="Work time (hours)" Grid.Row="7" Grid.Column="0" Margin="0,0,8,4" />
        <TextBlock x:Name="TimeInLabel" Text="Time in" Grid.Row="7" Grid.Column="1" Margin="8,0,0,4" />
        <syncfusion:SfTextBoxExt x:Name="WorkTimeBox"
                                 Grid.Row="8"
                                 Grid.Column="0"
                                 Width="90"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,8,12"
                                 ToolTip="Shift length for Normal. For Flexible/Split Shift, this is the day's required total hours instead -- there's no single shift to measure a length from. For a Rest Day duty, this is the scheduled length punches are matched against." />
        <controls:TimeInput x:Name="TimeInPicker"
                            Grid.Row="8"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            Margin="8,0,0,12" />

        <!-- Leave only: Payroll's Basic Pay for the day reads this (ScheduleEntry.IsPaidLeave). -->
        <TextBlock x:Name="LeavePayLabel" Text="Leave pay" Grid.Row="7" Grid.Column="0" Margin="0,0,8,4" />
        <StackPanel x:Name="LeavePayPanel"
                    Grid.Row="8"
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Margin="0,0,8,12"
                    VerticalAlignment="Center">
          <RadioButton x:Name="PaidLeaveRadio" GroupName="LeavePay" Content="Paid" Margin="0,0,16,0" />
          <RadioButton x:Name="UnpaidLeaveRadio" GroupName="LeavePay" Content="Unpaid" />
        </StackPanel>

        <!-- Flexible only: the day's required punching window. -->
        <TextBlock x:Name="RestrictedTimeLabel"
                   Text="Punching window (required -- punches outside this range won't count)"
                   Grid.Row="9"
                   Grid.ColumnSpan="2"
                   Margin="0,12,0,4"
                   TextWrapping="Wrap" />
        <Border x:Name="RestrictedTimeBorder"
                Grid.Row="10"
                Grid.ColumnSpan="2"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,0,6">
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
            <TextBlock Text="Time in" Style="{StaticResource FieldCaption}" Margin="0,0,4,2" />
            <TextBlock Grid.Column="1" Text="Time out" Style="{StaticResource FieldCaption}" Margin="4,0,0,2" />
            <controls:TimeInput x:Name="RestrictedTimeInPicker"
                                Grid.Row="1"
                                HorizontalAlignment="Left"
                                Margin="0,0,4,0"
                                ToolTip="Caps how early a punch counts toward WorkedHours -- still shows in ClockIn, just clamped for the hours math." />
            <controls:TimeInput x:Name="RestrictedTimeOutPicker"
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                Margin="4,0,0,0"
                                ToolTip="Excludes punches after this time from the day's search entirely -- a boundary, not a cap." />
          </Grid>
        </Border>

        <!-- Split Shift only: its punching windows. -->
        <TextBlock x:Name="SegmentsLabel"
                   Text="Split shift punching windows -- add each window this day allows punches (leave empty for none)"
                   Grid.Row="9"
                   Grid.ColumnSpan="2"
                   Margin="0,12,0,4"
                   TextWrapping="Wrap" />
        <Border x:Name="SegmentsBorder"
                Grid.Row="10"
                Grid.ColumnSpan="2"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                Padding="6"
                Margin="0,0,0,6"
                MaxHeight="240">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SegmentsList"
                          HorizontalAlignment="Left"
                          ItemTemplate="{StaticResource SegmentTemplate}" />
          </ScrollViewer>
        </Border>
        <syncfusion:ButtonAdv x:Name="AddSegmentButton"
                              Grid.Row="11"
                              Grid.ColumnSpan="2"
                              Label="Add window"
                              IconTemplate="{StaticResource AddIconTemplate}"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,4" />

        <!-- Normal and a Rest Day duty: the types whose punches are matched against a single
             window (SingleWindowShiftCalculationStrategy). -->
        <TextBlock x:Name="NormalBufferLabel"
                   Text="Clock-in / clock-out buffer overrides (optional -- overrides the employee's own default, or the policy default, just for this day)"
                   Grid.Row="9"
                   Grid.ColumnSpan="2"
                   Margin="0,12,0,4"
                   TextWrapping="Wrap" />
        <Border x:Name="NormalBufferBorder"
                Grid.Row="10"
                Grid.ColumnSpan="2"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,0,6">
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Text="Clock-in buffer, before (h)" Style="{StaticResource FieldCaption}" Margin="0,0,4,2" />
            <TextBlock Grid.Column="1" Text="Clock-in buffer, after (h)" Style="{StaticResource FieldCaption}" Margin="4,0,0,2" />
            <syncfusion:SfTextBoxExt x:Name="ClockInBufferBeforeBox"
                                     Grid.Row="1"
                                     Width="70"
                                     HorizontalAlignment="Left"
                                     Margin="0,0,4,10"
                                     ToolTip="How many hours before the scheduled time in a punch still counts as clock-in. Grayed-out tracks the employee/policy default live; type over it to lock in just this day." />
            <syncfusion:SfTextBoxExt x:Name="ClockInBufferAfterBox"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Width="70"
                                     HorizontalAlignment="Left"
                                     Margin="4,0,0,10"
                                     ToolTip="How many hours after the scheduled time in a punch still counts as clock-in. Grayed-out tracks the employee/policy default live; type over it to lock in just this day." />
            <TextBlock Grid.Row="2" Text="Clock-out buffer, before (h)" Style="{StaticResource FieldCaption}" Margin="0,0,4,2" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Clock-out buffer, after (h)" Style="{StaticResource FieldCaption}" Margin="4,0,0,2" />
            <syncfusion:SfTextBoxExt x:Name="ClockOutBufferBeforeBox"
                                     Grid.Row="3"
                                     Width="70"
                                     HorizontalAlignment="Left"
                                     Margin="0,0,4,0"
                                     ToolTip="How many hours before the scheduled time out a punch still counts as clock-out. Grayed-out tracks the employee/policy default live; type over it to lock in just this day." />
            <syncfusion:SfTextBoxExt x:Name="ClockOutBufferAfterBox"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     Width="70"
                                     HorizontalAlignment="Left"
                                     Margin="4,0,0,0"
                                     ToolTip="How many hours after the scheduled time out a punch still counts as clock-out. Grayed-out tracks the employee/policy default live; type over it to lock in just this day." />
          </Grid>
        </Border>

        <!-- Overtime / Night Diff overrides: every type that computes those hours (not Leave or
             Official Business). A Rest Day only ever acts on the Night Diff half. -->
        <TextBlock x:Name="OvertimeNightDiffLabel"
                   Grid.Row="12"
                   Grid.ColumnSpan="2"
                   Margin="0,12,0,4"
                   TextWrapping="Wrap"
                   Text="Overtime / Night differential overrides (optional -- applies to every selected day)" />
        <Border x:Name="OvertimeNightDiffBorder"
                Grid.Row="13"
                Grid.ColumnSpan="2"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,0,6">
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Text="Overtime eligible" Style="{StaticResource FieldCaption}" Margin="0,0,4,2" />
            <TextBlock Grid.Column="1" Text="Night diff eligible" Style="{StaticResource FieldCaption}" Margin="4,0,0,2" />
            <syncfusion:ComboBoxAdv x:Name="OvertimeEligibleCombo"
                                    Grid.Row="1"
                                    Margin="0,0,4,10"
                                    HorizontalAlignment="Stretch"
                                    ToolTip="Per-day override of overtime eligibility -- 'Use employee default' inherits it; 'Eligible'/'Not eligible' overrides just this day, without changing the employee's own setting." />
            <syncfusion:ComboBoxAdv x:Name="NightDiffEligibleCombo"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="4,0,0,10"
                                    HorizontalAlignment="Stretch"
                                    ToolTip="Per-day override of night differential eligibility -- 'Use employee default' inherits it; 'Eligible'/'Not eligible' overrides just this day." />
            <TextBlock Grid.Row="2" Text="Overtime premium applies" Style="{StaticResource FieldCaption}" Margin="0,0,4,2" />
            <syncfusion:ComboBoxAdv x:Name="ApplyOvertimeRatePercentageCombo"
                                    Grid.Row="3"
                                    Margin="0,0,4,10"
                                    HorizontalAlignment="Stretch"
                                    ToolTip="Per-day override of the overtime premium (separate from eligibility above) -- 'Apply premium' pays rate x (1 + overtime %); 'Straight time only' pays plain hourly rate. No Night Diff equivalent; its rate always applies once eligible." />
            <TextBlock Grid.Row="4" Text="Overtime rate % override" Style="{StaticResource FieldCaption}" Margin="0,0,4,2" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="Night diff rate % override" Style="{StaticResource FieldCaption}" Margin="4,0,0,2" />
            <syncfusion:SfTextBoxExt x:Name="OvertimeRatePercentageBox"
                                     Grid.Row="5"
                                     Width="70"
                                     HorizontalAlignment="Left"
                                     Margin="0,0,4,0"
                                     ToolTip="Overrides the overtime rate % for just this day. Grayed-out tracks the policy default live; type over it to lock in. Only applies when eligible and the premium is on." />
            <syncfusion:SfTextBoxExt x:Name="NightDiffRatePercentageBox"
                                     Grid.Row="5"
                                     Grid.Column="1"
                                     Width="70"
                                     HorizontalAlignment="Left"
                                     Margin="4,0,0,0"
                                     ToolTip="Overrides the night differential rate % for just this day. Grayed-out tracks the policy default live; type over it to lock in. Only applies when eligible." />
          </Grid>
        </Border>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</controls:ReactiveAppWindow>
