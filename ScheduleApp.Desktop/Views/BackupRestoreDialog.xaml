<ui:FluentWindow x:Class="ScheduleApp.Desktop.Views.BackupRestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Backup / Restore Database" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- See MainWindow.xaml's own TitleBar comment for why every FluentWindow needs
             one of these - WPF-UI removes the native title bar entirely otherwise. -->
        <ui:TitleBar Grid.Row="0"
                Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                ShowMinimize="False"
                ShowMaximize="False"
                CanMaximize="False" />

    <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Back up" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"
                   Text="Creates a single .bak file with the whole database in it -- employees, schedules, attendance history, all of it. Copy that file to another computer's SQL Server Express instance (USB, network share, whatever) and use Restore there to bring everything in." />
        <Button x:Name="BackupButton" Grid.Row="2" Content="Back Up Now…" HorizontalAlignment="Left"
                Padding="12,6" Margin="0,0,0,20" Click="BackupButton_Click" />

        <TextBlock Grid.Row="3" Text="Restore" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="4" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"
                   Text="Replaces everything currently in this database with what's in a .bak file. If Schedule Manager already created an empty database here (its normal first-run behavior), Restore overwrites it -- there's no undo, so make sure this is the computer you meant to restore onto." />
        <Button x:Name="RestoreButton" Grid.Row="5" Content="Restore From Backup…" HorizontalAlignment="Left"
                Padding="12,6" Margin="0,0,0,8" Click="RestoreButton_Click" />

        <StackPanel x:Name="ProgressPanel" Grid.Row="6" Orientation="Horizontal"
                    Margin="0,8,0,8" Visibility="Collapsed">
            <ProgressBar IsIndeterminate="True" Width="200" Height="6" Margin="0,0,10,0" />
            <TextBlock x:Name="ProgressText" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Button x:Name="CloseButton" Grid.Row="7" Content="Close" HorizontalAlignment="Right"
                Padding="16,6" Margin="0,8,0,0" IsCancel="True" Click="CloseButton_Click" />
    </Grid>
</Grid>
</ui:FluentWindow>
