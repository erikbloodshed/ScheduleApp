<controls:ReactiveAppWindow x:Class="ScheduleApp.Desktop.Views.PunchListDetailDialog" ShowMinimizeButton="False"
        x:TypeArguments="attendance:PunchListDetailViewModel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
        xmlns:attendance="clr-namespace:ScheduleApp.Desktop.ViewModels.Attendance"
        Width="860" Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Same column set as the Punch Records tab's grid, since both are built from
             StoredPunchLogRow via the same factory. -->
        <syncfusion:SfDataGrid x:Name="RowsGrid"
                               Grid.Row="0"
                               AutoGenerateColumns="False"
                               AllowEditing="False"
                               AllowDraggingColumns="False"
                               GridLinesVisibility="Horizontal"
                               NavigationMode="Row"
                               SelectionMode="Single">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="EmployeeId" HeaderText="PIN" Width="90" />
                <syncfusion:GridTextColumn MappingName="EmployeeName" HeaderText="Employee Name" Width="200" />
                <syncfusion:GridTextColumn MappingName="DepartmentName" HeaderText="Department" Width="140" />
                <syncfusion:GridTextColumn MappingName="Date" HeaderText="Date" Width="100"
                                           DisplayBinding="{Binding Timestamp, StringFormat={}{0:MM/dd/yyyy}}" />
                <syncfusion:GridTextColumn MappingName="Time" HeaderText="Time" Width="90"
                                           DisplayBinding="{Binding Timestamp, StringFormat={}{0:hh:mm tt}}" />
                <syncfusion:GridTextColumn MappingName="PunchTypeText" HeaderText="Type" Width="90" />
                <syncfusion:GridTextColumn MappingName="Source" HeaderText="Source" ColumnSizer="Star" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <syncfusion:ButtonAdv x:Name="ExportButton"
                                  Label="Export…"
                                  IconTemplate="{StaticResource ExportIconTemplate}"
                                  MinWidth="90"
                                  Margin="0,0,8,0" />
            <syncfusion:ButtonAdv Label="Close"
                                  IconTemplate="{StaticResource CancelIconTemplate}"
                                  MinWidth="90"
                                  IsCancel="True"
                                  IsDefault="True" />
        </StackPanel>
    </Grid>
</controls:ReactiveAppWindow>
