<Page x:Class="ScheduleApp.Desktop.Views.SchedulePage"
      x:Name="RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels"
      xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Title="Schedule">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="{x:Type ui:Button}">
            <Setter Property="Margin"
                    Value="0,0,6,0" />
            <Setter Property="Appearance"
                    Value="Secondary" />
        </Style>

        <Style x:Key="GroupLabel"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="0,0,8,0" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
        </Style>

        <!-- Employee tree visibility, driven by MainViewModel.EmployeeTreeSearchText
             (see EmployeeTreeSearchFilter). Two separate styles because TreeView.
             ItemContainerStyle only reaches the root level (DepartmentGroupViewModel);
             the nested EmployeeNodeViewModel level is styled via the
             HierarchicalDataTemplate's own ItemContainerStyle instead - see EmployeeTree
             below. Same pattern as AttendanceView.xaml's report-scope tree. -->
        <Style x:Key="DepartmentItemStyle"
               TargetType="TreeViewItem">
            <Setter Property="Visibility"
                    Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
            <Setter Property="IsExpanded"
                    Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>

        <Style x:Key="EmployeeItemStyle"
               TargetType="TreeViewItem">
            <Setter Property="Visibility"
                    Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
        </Style>

        <!-- Icon-only header action button - currently just the calendar's own Refresh
             button at the right edge of the Import/Export Schedule row below. Same
             style, same font-fallback reasoning, and same role as PayrollSummaryView's
             own IconHeaderActionButton (see that file's copy of this style for the
             fuller doc comment) - duplicated here rather than shared via a merged
             resource dictionary, same "each page keeps its own copy of a small style
             resource" convention this app already follows. -->
        <Style x:Key="IconHeaderActionButton"
               TargetType="Button">
            <Setter Property="FontFamily"
                    Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Width"
                    Value="28" />
            <Setter Property="Height"
                    Value="28" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource ControlFillColorDefaultBrush}"
                                        TargetName="Bg" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.4"
                                        TargetName="Bg" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="8">
        <!-- The page-level command row (Import/Export Schedule, previously its own
             CardBorder above this Grid) now lives in the calendar's own header row
             instead (see Grid.Row="0" below, in place of CalendarHeaderText) - one
             less row height spent on chrome, freeing that space for the calendar
             itself. Department/Employee management commands live on the Employees
             page instead (see EmployeesPage.xaml), which has its own copy of a
             department/employee tree (plus an employee grid) reading the same
             MainViewModel.Departments this one does - selecting something on either
             page updates the same shared SelectedEmployee/SelectedDepartment, so the
             two stay in sync without one page depending on the other's tree. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: departments (+ Unassigned bucket) and employees. Checkboxes only
                 appear once "Assign Schedule to Multiple Employees" is clicked - the
                 tree is plain rows otherwise. While that mode is on, the calendar on
                 the right goes blank regardless of which row is highlighted, since
                 there's no single employee whose schedule it would make sense to show. -->
            <DockPanel Grid.Column="0"
                       Margin="0,0,8,0">
                <Button DockPanel.Dock="Top"
                        Command="{Binding ToggleMultiSelectModeCommand}"
                        Padding="8,4"
                        Margin="0,0,0,8">
                    <TextBlock Text="{Binding MultiSelectButtonText}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </Button>

                <!-- Live filter for the tree below, same comma-separated Employee
                     ID/last name/first name/department matching as the Attendance tab's
                     report-scope and Punch Records search boxes (see
                     MainViewModel.EmployeeTreeSearchText) - narrows which nodes are
                     visible, not which are checked, so typing here never changes what
                     multi-select mode would actually assign a schedule to. -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="0,0,0,8">
                    <TextBlock Text="Search"
                               Style="{StaticResource GroupLabel}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding EmployeeTreeSearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Comma-separated ID, name, or department terms (e.g. &quot;342, Cruz, Kitchen&quot;) -- narrows what's shown, not what's checked." />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom"
                            Margin="0,8,0,0"
                            Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SelectedEmployeeCount, StringFormat='{}{0} employee(s) checked'}"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Select days on the calendar, then use &quot;Set Schedule for Selected Days&quot; on the right."
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4" />
                    <Button Content="Clear Employee Checkboxes"
                            Command="{Binding ClearEmployeeSelectionCommand}"
                            Padding="8,2" />
                </StackPanel>

                <!-- Bordered box, same look as the Attendance tab's own Report Scope tree
                     (see AttendanceSummaryView.xaml's copy of this TreeView) - just
                     BorderThickness/BorderBrush set directly on the TreeView itself
                     (that page doesn't wrap its tree in a separate Border either), not
                     the page's CardBorder style, which this page doesn't otherwise use
                     for its tree. -->
                <TreeView x:Name="EmployeeTree"
                          ItemsSource="{Binding Departments}"
                          SelectedItemChanged="EmployeeTree_OnSelectedItemChanged"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                          ItemContainerStyle="{StaticResource DepartmentItemStyle}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:DepartmentGroupViewModel}"
                                                  ItemsSource="{Binding Employees}"
                                                  ItemContainerStyle="{StaticResource EmployeeItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          IsThreeState="False"
                                          VerticalAlignment="Center"
                                          ToolTip="Check/uncheck all employees in this department"
                                          Margin="0,0,4,0"
                                          Visibility="{Binding DataContext.IsMultiSelectMode, ElementName=RootPage, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="Bold" />
                            </StackPanel>
                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EmployeeNodeViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,0"
                                                  Visibility="{Binding DataContext.IsMultiSelectMode, ElementName=RootPage, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Employee.DisplayName}" />
                                    </StackPanel>
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <!-- Right: calendar for the selected employee - the calendar itself IS the
                 schedule view now, there's no separate list. -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Import/Export Schedule (formerly this page's own CardBorder row above
                     the tree+calendar split) plus a Refresh button pinned to the row's own
                     right edge - same DockPanel/LastChildFill="False" shape as
                     PayrollSummaryView's own employee-name header (see that file for the
                     fuller reasoning): the button pair docks Left and takes only the width
                     it needs, Refresh docks Right regardless, and the space between the two
                     just stays empty rather than either side stretching into it. No
                     Visibility toggle on the Refresh button the way PayrollSummaryView's
                     has - unlike that page, this one has no NotNullToVisibility converter
                     already in scope, and every other command-bound button on this page
                     (Set/Remove Schedule, Clear Selection, below) already relies on plain
                     CanExecute-driven disabling rather than hiding outright, so
                     RefreshOrCancelScheduleCommand's own CanExecute (see
                     ScheduleCalendarViewModel.CanRefreshOrCancelSchedule) graying the button
                     out for "no employee selected"/multi-select mode stays consistent with
                     that.

                     Doubles as a Cancel button while anything's running (see
                     RefreshOrCancelScheduleCommand/RefreshOrCancelGlyph/
                     RefreshOrCancelToolTip) - same in-place Refresh<->Cancel toggle as
                     AttendanceSummaryView's own Period-row button and PayrollSummaryView's
                     own payslip-header button, rather than just sitting disabled with no
                     way to stop a recalculation once started. -->
                <DockPanel Grid.Row="0"
                           Margin="0,0,0,8"
                           LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left"
                                Orientation="Horizontal">
                        <Button Content="Import Schedule (Excel)"
                                Command="{Binding ImportScheduleCommand}" />
                        <Button Content="Export Schedule (Excel)"
                                Command="{Binding ExportScheduleCommand}"
                                Margin="0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource IconHeaderActionButton}"
                            Content="{Binding RefreshOrCancelGlyph}"
                            Command="{Binding RefreshOrCancelScheduleCommand}"
                            ToolTip="{Binding RefreshOrCancelToolTip}" />
                </DockPanel>

                <!-- CalendarHeaderText ("Select an employee"/employee name), now sharing
                     this row with month navigation instead of its own row above - freed up
                     by moving Import/Export Schedule into that row (see Grid.Row="0" above).
                     Same DockPanel/LastChildFill="False" shape as that row: the title docks
                     Left, month navigation docks Right, and the middle just stays empty. -->
                <DockPanel Grid.Row="1"
                           Margin="0,0,0,8"
                           LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Text="{Binding CalendarHeaderText}" />
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal">
                        <Button Content="&lt;"
                                Width="32"
                                Command="{Binding PreviousMonthCommand}" />
                        <TextBlock Text="{Binding DisplayedMonthText}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="12,0"
                                   Width="140"
                                   TextAlignment="Center" />
                        <Button Content="&gt;"
                                Width="32"
                                Command="{Binding NextMonthCommand}" />
                    </StackPanel>
                </DockPanel>

                <DockPanel Grid.Row="2"
                           Margin="0,0,0,8"
                           LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="11"
                               Text="Click a day, Shift+click or drag for a range, Ctrl+click to pick several days" />
                    <Button DockPanel.Dock="Right"
                            Content="{Binding SetScheduleButtonText}"
                            Command="{Binding SetScheduleForSelectionCommand}"
                            Padding="8,2" />
                    <Button DockPanel.Dock="Right"
                            Content="Remove Schedule for Selected Days"
                            Command="{Binding ClearScheduleForSelectionCommand}"
                            Padding="8,2"
                            Margin="0,0,8,0" />
                    <Button DockPanel.Dock="Right"
                            Content="Clear Selection"
                            Command="{Binding ClearCalendarSelectionCommand}"
                            Padding="8,2"
                            Margin="0,0,8,0" />
                </DockPanel>

                <controls:MonthCalendarControl Grid.Row="3"
                                               Days="{Binding CalendarDays}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
