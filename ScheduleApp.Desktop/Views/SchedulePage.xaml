<rxui:ReactivePage x:Class="ScheduleApp.Desktop.Views.SchedulePage"
                   x:TypeArguments="vm:MainViewModel"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:rxui="http://reactiveui.net"
                   xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                   xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels"
                   xmlns:views="clr-namespace:ScheduleApp.Desktop.Views"
                   xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
                   ScrollViewer.CanContentScroll="False"
                   Title="Schedule">
    <Page.Resources>
        <Style x:Key="CommandButton" TargetType="syncfusion:ButtonAdv" BasedOn="{StaticResource {x:Type syncfusion:ButtonAdv}}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Page.Resources>

    <Grid Margin="8">
        <!-- Department/Employee management lives on the Employees page, over the same shared
             tree and selection - picking someone on either page picks them on both. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: departments (+ Unassigned) and employees. Checkboxes appear only in
             multi-select mode, where the calendar goes blank: there's no single employee whose
             schedule it could show. -->
        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <syncfusion:ButtonAdv x:Name="MultiSelectButton"
                                  DockPanel.Dock="Top"
                                  IconTemplate="{StaticResource SelectAllIconTemplate}"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,8" />

            <!-- Narrows which rows show, never which are checked - typing here never changes
                 what multi-select mode would assign a schedule to. -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="Search" Style="{StaticResource GroupLabelStyle}" Margin="0,0,0,4" />
                <syncfusion:SfTextBoxExt x:Name="TreeSearchBox"
                                         Watermark="ID, name or department"
                                         ToolTip="Comma-separated ID, name, or department terms (e.g. &quot;342, Cruz, Kitchen&quot;) -- narrows what's shown, not what's checked." />
            </StackPanel>

            <StackPanel x:Name="MultiSelectPanel" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock x:Name="CheckedCountText"
                           FontSize="11"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Margin="0,0,0,4" />
                <TextBlock Text="Select days on the calendar, then use &quot;Set Schedule for Selected Days&quot; on the right."
                           FontSize="11"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />
                <syncfusion:ButtonAdv x:Name="ClearCheckedButton"
                                      Label="Clear Employee Checkboxes"
                                      IconTemplate="{StaticResource ClearSelectionIconTemplate}"
                                      HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Shows VisibleDepartments and each one's VisibleEmployees, which the search box
                 keeps filtered (SfTreeView can't hide a row itself). Whether a department is
                 open is kept on it (DepartmentGroupViewModel.IsExpanded), so it stays as left
                 through a reload. -->
            <Border BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="4">
                <syncfusion:SfTreeView x:Name="EmployeeTree"
                                       SelectionMode="Single"
                                       FullRowSelect="True"
                                       ExpandActionTrigger="Node"
                                       FocusVisualStyle="{x:Null}">
                    <syncfusion:SfTreeView.Resources>
                        <DataTemplate DataType="{x:Type vm:DepartmentGroupViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          IsThreeState="False"
                                          VerticalAlignment="Center"
                                          ToolTip="Check/uncheck all employees in this department"
                                          Margin="0,0,4,0"
                                          Visibility="{Binding ViewModel.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType=views:SchedulePage}, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:EmployeeNodeViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,4,0"
                                          Visibility="{Binding ViewModel.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType=views:SchedulePage}, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Employee.DisplayName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:SfTreeView.Resources>
                    <syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                        <syncfusion:HierarchyPropertyDescriptor TargetType="{x:Type vm:DepartmentGroupViewModel}"
                                                                ChildPropertyName="VisibleEmployees"
                                                                IsExpandedPropertyName="IsExpanded" />
                    </syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                    <syncfusion:SfTreeView.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" Focusable="False" VerticalAlignment="Center" />
                        </DataTemplate>
                    </syncfusion:SfTreeView.ItemTemplate>
                </syncfusion:SfTreeView>
            </Border>
        </DockPanel>

        <!-- Right: the selected employee's calendar - itself the schedule view. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Month navigation and Import/Export on the left; Refresh pinned to the right
                 edge, doubling as Cancel while anything runs (the same in-place toggle as the
                 Attendance Summary and payslip headers). -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <syncfusion:ButtonAdv x:Name="PreviousMonthButton"
                                          SizeMode="Small"
                                          Tag="&#xE76B;"
                                          IconTemplate="{StaticResource TagGlyphIconTemplate}"
                                          ToolTip="Previous month" />
                    <TextBlock x:Name="DisplayedMonthText"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="12,0"
                               Width="140"
                               TextAlignment="Center" />
                    <syncfusion:ButtonAdv x:Name="NextMonthButton"
                                          SizeMode="Small"
                                          Tag="&#xE76C;"
                                          IconTemplate="{StaticResource TagGlyphIconTemplate}"
                                          ToolTip="Next month" />
                    <syncfusion:ButtonAdv x:Name="ImportScheduleButton"
                                          Label="Import Schedule (Excel)"
                                          IconTemplate="{StaticResource ImportIconTemplate}"
                                          Style="{StaticResource CommandButton}"
                                          Margin="12,0,0,0" />
                    <syncfusion:ButtonAdv x:Name="ExportScheduleButton"
                                          Label="Export Schedule (Excel)"
                                          IconTemplate="{StaticResource ExportIconTemplate}"
                                          Style="{StaticResource CommandButton}"
                                          Margin="6,0,0,0" />
                </StackPanel>
                <syncfusion:ButtonAdv x:Name="RefreshOrCancelButton"
                                      DockPanel.Dock="Right"
                                      SizeMode="Small"
                                      IconTemplate="{StaticResource TagGlyphIconTemplate}" />
            </DockPanel>

            <TextBlock x:Name="CalendarHeaderText"
                       Grid.Row="1"
                       Margin="0,0,0,8"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />

            <DockPanel Grid.Row="2" Margin="0,0,0,8">
                <syncfusion:ButtonAdv x:Name="SetScheduleButton"
                                      DockPanel.Dock="Right"
                                      IconTemplate="{StaticResource CalendarIconTemplate}" />
                <syncfusion:ButtonAdv x:Name="ClearScheduleButton"
                                      DockPanel.Dock="Right"
                                      Label="Remove Schedule for Selected Days"
                                      IconTemplate="{StaticResource DeleteIconTemplate}"
                                      Style="{StaticResource CommandButton}" />
                <syncfusion:ButtonAdv x:Name="ClearCalendarSelectionButton"
                                      DockPanel.Dock="Right"
                                      Label="Clear Selection"
                                      IconTemplate="{StaticResource ClearSelectionIconTemplate}"
                                      Style="{StaticResource CommandButton}" />
                <!-- Last, so the buttons keep their width and the hint trims instead. -->
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Text="Click a day, Shift+click or drag for a range, Ctrl+click to pick several days"
                           ToolTip="Click a day, Shift+click or drag for a range, Ctrl+click to pick several days" />
            </DockPanel>

            <controls:MonthCalendarControl x:Name="MonthCalendar" Grid.Row="3" />
        </Grid>
    </Grid>
</rxui:ReactivePage>
