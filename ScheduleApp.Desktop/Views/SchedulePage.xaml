<Page x:Class="ScheduleApp.Desktop.Views.SchedulePage"
      x:Name="RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
      xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels"
      xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
      ScrollViewer.CanContentScroll="False"
      Title="Schedule">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CommandButton" TargetType="syncfusion:ButtonAdv">
            <Setter Property="SizeMode" Value="Normal" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Page.Resources>

    <Grid Margin="8">
        <!-- Department/Employee management commands live on the Employees page instead (see
             EmployeesPage.xaml), which has its own department tree (plus an employee grid)
             reading the same MainViewModel.Departments this one does - selecting something on
             either page updates the same shared SelectedEmployee/SelectedDepartment, so the two
             stay in sync without one page depending on the other's tree. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: departments (+ Unassigned bucket) and employees. Checkboxes only appear once
             "Assign Schedule to Multiple Employees" is clicked - the tree is plain rows
             otherwise. While that mode is on, the calendar on the right goes blank regardless of
             which row is highlighted, since there's no single employee whose schedule it would
             make sense to show. -->
        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <syncfusion:ButtonAdv DockPanel.Dock="Top"
                                  Label="{Binding MultiSelectButtonText}"
                                  IconTemplate="{StaticResource SelectAllIconTemplate}"
                                  SizeMode="Normal"
                                  HorizontalAlignment="Stretch"
                                  Command="{Binding ToggleMultiSelectModeCommand}"
                                  Margin="0,0,0,8" />

            <!-- Live filter for the tree below, same comma-separated Employee ID/last
                 name/first name/department matching as the Attendance tab's report-scope and
                 Punch Records search boxes (see MainViewModel.EmployeeTreeSearchText) - narrows
                 which nodes are visible, not which are checked, so typing here never changes
                 what multi-select mode would actually assign a schedule to. -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="Search" Style="{StaticResource GroupLabel}" Margin="0,0,0,4" />
                <syncfusion:SfTextBoxExt Text="{Binding EmployeeTreeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="ID, name or department"
                                         ToolTip="Comma-separated ID, name, or department terms (e.g. &quot;342, Cruz, Kitchen&quot;) -- narrows what's shown, not what's checked." />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom"
                        Margin="0,8,0,0"
                        Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SelectedEmployeeCount, StringFormat='{}{0} employee(s) checked'}"
                           FontSize="11"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Margin="0,0,0,4" />
                <TextBlock Text="Select days on the calendar, then use &quot;Set Schedule for Selected Days&quot; on the right."
                           FontSize="11"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />
                <syncfusion:ButtonAdv Label="Clear Employee Checkboxes"
                                      IconTemplate="{StaticResource ClearSelectionIconTemplate}"
                                      SizeMode="Normal"
                                      HorizontalAlignment="Left"
                                      Command="{Binding ClearEmployeeSelectionCommand}" />
            </StackPanel>

            <!-- Bound to VisibleDepartments and each department's VisibleEmployees, which the
                 search box above keeps filtered (EmployeeTreeSearchFilter) - SfTreeView can't
                 hide a row itself. Whether a department is open is kept on it
                 (DepartmentGroupViewModel.IsExpanded), so a search can open it and it stays as
                 it was left through a reload. Each row's template is picked by its data's type
                 (the DataTemplates below). -->
            <Border BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="4">
                <syncfusion:SfTreeView x:Name="EmployeeTree"
                                       ItemsSource="{Binding VisibleDepartments}"
                                       SelectionMode="Single"
                                       FullRowSelect="True"
                                       ExpandActionTrigger="Node"
                                       FocusVisualStyle="{x:Null}"
                                       SelectionChanged="EmployeeTree_SelectionChanged">
                    <syncfusion:SfTreeView.Resources>
                        <DataTemplate DataType="{x:Type vm:DepartmentGroupViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          IsThreeState="False"
                                          VerticalAlignment="Center"
                                          ToolTip="Check/uncheck all employees in this department"
                                          Margin="0,0,4,0"
                                          Visibility="{Binding DataContext.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:EmployeeNodeViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,4,0"
                                          Visibility="{Binding DataContext.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Employee.DisplayName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:SfTreeView.Resources>
                    <syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                        <syncfusion:HierarchyPropertyDescriptor TargetType="{x:Type vm:DepartmentGroupViewModel}"
                                                                ChildPropertyName="VisibleEmployees"
                                                                IsExpandedPropertyName="IsExpanded" />
                    </syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                    <syncfusion:SfTreeView.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" Focusable="False" VerticalAlignment="Center" />
                        </DataTemplate>
                    </syncfusion:SfTreeView.ItemTemplate>
                </syncfusion:SfTreeView>
            </Border>
        </DockPanel>

        <!-- Right: calendar for the selected employee - the calendar itself IS the schedule
             view, there's no separate list. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Month navigation and Import/Export Schedule, plus a Refresh button pinned to
                 the row's own right edge: the button group docks Left and takes only the width
                 it needs, Refresh docks Right regardless, and the space between the two just
                 stays empty. Refresh is disabled rather than hidden with no employee selected
                 or in multi-select mode (RefreshOrCancelScheduleCommand's CanExecute), the same
                 as every other command button on this page.

                 Doubles as a Cancel button while anything's running (see
                 RefreshOrCancelScheduleCommand/RefreshOrCancelGlyph/RefreshOrCancelToolTip) -
                 the same in-place Refresh<->Cancel toggle as AttendanceSummaryView's own
                 Period-row button and PayrollSummaryView's own payslip-header button. -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <syncfusion:ButtonAdv SizeMode="Small"
                                          Tag="&#xE76B;"
                                          IconTemplate="{StaticResource TagGlyphIconTemplate}"
                                          ToolTip="Previous month"
                                          Command="{Binding PreviousMonthCommand}" />
                    <TextBlock Text="{Binding DisplayedMonthText}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="12,0"
                               Width="140"
                               TextAlignment="Center" />
                    <syncfusion:ButtonAdv SizeMode="Small"
                                          Tag="&#xE76C;"
                                          IconTemplate="{StaticResource TagGlyphIconTemplate}"
                                          ToolTip="Next month"
                                          Command="{Binding NextMonthCommand}" />
                    <syncfusion:ButtonAdv Label="Import Schedule (Excel)"
                                          IconTemplate="{StaticResource ImportIconTemplate}"
                                          Style="{StaticResource CommandButton}"
                                          Margin="12,0,0,0"
                                          Command="{Binding ImportScheduleCommand}" />
                    <syncfusion:ButtonAdv Label="Export Schedule (Excel)"
                                          IconTemplate="{StaticResource ExportIconTemplate}"
                                          Style="{StaticResource CommandButton}"
                                          Margin="6,0,0,0"
                                          Command="{Binding ExportScheduleCommand}" />
                </StackPanel>
                <syncfusion:ButtonAdv DockPanel.Dock="Right"
                                      SizeMode="Small"
                                      Tag="{Binding RefreshOrCancelGlyph}"
                                      IconTemplate="{StaticResource TagGlyphIconTemplate}"
                                      Command="{Binding RefreshOrCancelScheduleCommand}"
                                      ToolTip="{Binding RefreshOrCancelToolTip}" />
            </DockPanel>

            <TextBlock Grid.Row="1"
                       Margin="0,0,0,8"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Text="{Binding CalendarHeaderText}" />

            <DockPanel Grid.Row="2" Margin="0,0,0,8" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           FontSize="11"
                           Text="Click a day, Shift+click or drag for a range, Ctrl+click to pick several days" />
                <syncfusion:ButtonAdv DockPanel.Dock="Right"
                                      Label="{Binding SetScheduleButtonText}"
                                      IconTemplate="{StaticResource CalendarIconTemplate}"
                                      SizeMode="Normal"
                                      Command="{Binding SetScheduleForSelectionCommand}" />
                <syncfusion:ButtonAdv DockPanel.Dock="Right"
                                      Label="Remove Schedule for Selected Days"
                                      IconTemplate="{StaticResource DeleteIconTemplate}"
                                      Style="{StaticResource CommandButton}"
                                      Command="{Binding ClearScheduleForSelectionCommand}" />
                <syncfusion:ButtonAdv DockPanel.Dock="Right"
                                      Label="Clear Selection"
                                      IconTemplate="{StaticResource ClearSelectionIconTemplate}"
                                      Style="{StaticResource CommandButton}"
                                      Command="{Binding ClearCalendarSelectionCommand}" />
            </DockPanel>

            <controls:MonthCalendarControl Grid.Row="3" Days="{Binding CalendarDays}" />
        </Grid>
    </Grid>
</Page>
