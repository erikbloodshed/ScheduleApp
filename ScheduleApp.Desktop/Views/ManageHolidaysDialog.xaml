<ui:FluentWindow x:Class="ScheduleApp.Desktop.Views.ManageHolidaysDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Manage Holidays" Width="540" Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
>
    <Window.Resources>
        <!-- One row = one HolidayRow. Each of the two cells stacks a read-only
             display element and an editor in the same grid slot and shows one at a
             time: the IsEditing DataTrigger (flipped only by EnterEditMode /
             CancelInlineEdit / SaveInlineEditAsync in the code-behind) swaps them.
             Nothing else toggles it, so - unlike the DataGrid this replaced - there's
             no framework edit pipeline that can drop a row out of edit mode past
             SaveInlineEditAsync's validation.

             Plain Grid columns (Date fixed, Name star), not a GridView: GridView's
             GridViewRowPresenter won't stretch templated cell content to the column
             width, so the editors shrank to their text and the last column needed a
             SizeChanged hack to fill. The static header below uses the same 230/*
             split so its labels line up with the cells. -->
        <DataTemplate x:Key="HolidayRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="4,0">
                    <TextBlock x:Name="DateDisplay" Text="{Binding DateDisplay}" VerticalAlignment="Center" />
                    <!-- SelectedDateFormat="Long" (e.g. "Tuesday, September 15, 2026")
                         rather than the DatePickerTextBox ControlTemplate restyle
                         ManualLogEntryDialog/etc. use elsewhere for the shorter
                         "September 15, 2026": that restyle swaps in a plain TextBox
                         that isn't wired up as DatePicker's expected PART_TextBox,
                         which rendered the selected date blank until clicked into when
                         focus moved away mid-edit. SelectedDateFormat is a real
                         built-in property, so it doesn't fight the control's
                         internals - the weekday prefix is the tradeoff. -->
                    <DatePicker x:Name="DateEditor"
                                SelectedDate="{Binding EditDate, UpdateSourceTrigger=PropertyChanged}"
                                SelectedDateFormat="Long"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                VerticalAlignment="Center" BorderThickness="0"
                                Visibility="Collapsed" />
                </Grid>

                <Grid Grid.Column="1" Margin="4,0">
                    <TextBlock x:Name="NameDisplay" Text="{Binding Name}" VerticalAlignment="Center" />
                    <!-- UpdateSourceTrigger=PropertyChanged (not the WPF default
                         LostFocus) so SaveInlineEditAsync always reads whatever's
                         currently typed. IsVisibleChanged puts the caret here the
                         moment the row enters edit mode, the way the old DataGrid's
                         BeginEdit did. -->
                    <TextBox x:Name="NameEditor"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center" BorderThickness="0" Padding="2,0"
                             Visibility="Collapsed"
                             IsVisibleChanged="NameEditor_IsVisibleChanged" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="DateDisplay" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="DateEditor" Property="Visibility" Value="Visible" />
                    <Setter TargetName="NameDisplay" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="NameEditor" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- See MainWindow.xaml's own TitleBar comment for why every FluentWindow needs
             one of these - WPF-UI removes the native title bar entirely otherwise. -->
        <ui:TitleBar Grid.Row="0"
                Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                ShowMinimize="False"
                ShowMaximize="True"
                CanMaximize="True" />

    <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Dates the company treats as a holiday. Employees who work a listed date get Premium Pay for it (see the Payroll page) once there's an actual holiday to compute against."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,12" />

        <!-- Static header - the ListView is a plain list now, so the column labels
             live here. Same 230/* split as HolidayRowTemplate so they line up; the
             left edges stay aligned even when the list shows a scrollbar (that only
             eats into the trailing edge of the Name column). -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,3" Margin="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Date" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0" />
                <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0" />
            </Grid>
        </Border>

        <ListView x:Name="HolidaysList"
                  Grid.Row="2"
                  ItemTemplate="{StaticResource HolidayRowTemplate}"
                  SelectionMode="Single"
                  SelectionChanged="HolidaysList_SelectionChanged"
                  MouseDoubleClick="HolidaysList_MouseDoubleClick"
                  PreviewMouseDown="HolidaysList_PreviewMouseDown"
                  PreviewKeyDown="HolidaysList_PreviewKeyDown"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <!-- Fixed row height so a row doesn't grow when its cells swap
                         the short display TextBlock for the taller DatePicker/TextBox
                         editors. 34 (with Padding 0, so the whole 34 is usable)
                         clears the DatePicker's calendar-button glyph, which clips
                         lower than that. -->
                    <Setter Property="Height" Value="34" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <!-- Minimal stand-in for the default ListViewItem template: a
                         single Border drives the row fill and the bottom divider. The
                         IsEditing DataTrigger is last so it wins over IsSelected /
                         IsMouseOver - the row being edited (always also the selected
                         row) shows no highlight, so the blue doesn't bleed around the
                         editors. -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,8,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="AddButton" Content="Add Holiday…" Width="Auto" Margin="0,0,8,0" Click="AddButton_Click" />
            <Button x:Name="EditButton" Content="Edit…" Width="Auto" Margin="0,0,8,0"
                    IsEnabled="False" Click="EditButton_Click" />
            <Button x:Name="DeleteButton" Content="Delete" Width="Auto" Margin="0,0,8,0"
                    IsEnabled="False" Click="DeleteButton_Click" />
            <Button Content="Close" Width="Auto" IsCancel="True" IsDefault="True" />
        </StackPanel>
    </Grid>
</Grid>
</ui:FluentWindow>
