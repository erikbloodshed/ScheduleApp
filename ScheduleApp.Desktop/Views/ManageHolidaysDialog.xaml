<controls:ReactiveAppWindow x:Class="ScheduleApp.Desktop.Views.ManageHolidaysDialog" ShowMinimizeButton="False"
        x:TypeArguments="vm:ManageHolidaysViewModel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
        xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels"
        Title="Manage Holidays" Width="540" Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
>
    <Window.Resources>
        <!-- One row = one HolidayRow. Each of the two cells stacks a read-only
             display element and an editor in the same grid slot and shows one at a
             time: the IsEditing DataTrigger (flipped only by ManageHolidaysViewModel's
             EnterEditMode / CancelInlineEdit / SaveInlineEditAsync) swaps them.
             Nothing else toggles it, so - unlike the DataGrid this replaced - there's
             no framework edit pipeline that can drop a row out of edit mode past
             SaveInlineEditAsync's validation.

             Plain Grid columns (Date fixed, Name star), not a GridView: GridView's
             GridViewRowPresenter won't stretch templated cell content to the column
             width, so the editors shrank to their text and the last column needed a
             SizeChanged hack to fill. The static header below uses the same 230/*
             split so its labels line up with the cells. -->
        <DataTemplate x:Key="HolidayRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="4,0">
                    <TextBlock x:Name="DateDisplay" Text="{Binding DateDisplay}" VerticalAlignment="Center" />
                    <!-- "September 15, 2026", the same as the display text beside it. -->
                    <syncfusion:DateTimeEdit x:Name="DateEditor"
                                             DateTime="{Binding EditDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center"
                                             Visibility="Collapsed" />
                </Grid>

                <Grid Grid.Column="1" Margin="4,0">
                    <TextBlock x:Name="NameDisplay" Text="{Binding Name}" VerticalAlignment="Center" />
                    <!-- UpdateSourceTrigger=PropertyChanged (not the WPF default
                         LostFocus) so the view model's Save always reads whatever's
                         currently typed. IsVisibleChanged puts the caret here the
                         moment the row enters edit mode, the way the old DataGrid's
                         BeginEdit did. -->
                    <syncfusion:SfTextBoxExt x:Name="NameEditor"
                                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center"
                                             Visibility="Collapsed"
                                             IsVisibleChanged="NameEditor_IsVisibleChanged" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="DateDisplay" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="DateEditor" Property="Visibility" Value="Visible" />
                    <Setter TargetName="NameDisplay" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="NameEditor" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

    <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Dates the company treats as a holiday. Employees who work a listed date get Premium Pay for it (see the Payroll page) once there's an actual holiday to compute against."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   Margin="0,0,0,12" />

        <!-- Static header - the ListView is a plain list now, so the column labels
             live here. Same 230/* split as HolidayRowTemplate so they line up; the
             left edges stay aligned even when the list shows a scrollbar (that only
             eats into the trailing edge of the Name column). -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,3" Margin="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Date" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0" />
                <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0" />
            </Grid>
        </Border>

        <ListView x:Name="HolidaysList"
                  Grid.Row="2"
                  ItemTemplate="{StaticResource HolidayRowTemplate}"
                  SelectionMode="Single"
                  MouseDoubleClick="HolidaysList_MouseDoubleClick"
                  PreviewMouseDown="HolidaysList_PreviewMouseDown"
                  PreviewKeyDown="HolidaysList_PreviewKeyDown"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <!-- Fixed row height so a row doesn't grow when its cells swap
                         the short display TextBlock for the taller date/name editors.
                         34, with Padding 0, so the whole 34 is usable. -->
                    <Setter Property="Height" Value="34" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <!-- Minimal stand-in for the default ListViewItem template: a
                         single Border drives the row fill and the bottom divider. The
                         IsEditing DataTrigger is last so it wins over IsSelected /
                         IsMouseOver - the row being edited (always also the selected
                         row) shows no highlight, so the blue doesn't bleed around the
                         editors. -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="{DynamicResource ErrorForegroundBrush}" TextWrapping="Wrap"
                   Margin="0,8,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <syncfusion:ButtonAdv x:Name="AddButton" Label="Add Holiday…" Margin="0,0,8,0"
                                  IconTemplate="{StaticResource AddIconTemplate}" />
            <syncfusion:ButtonAdv x:Name="EditButton" Margin="0,0,8,0"
                                  IconTemplate="{StaticResource EditIconTemplate}" />
            <syncfusion:ButtonAdv x:Name="DeleteButton" Label="Delete" Margin="0,0,8,0"
                                  IconTemplate="{StaticResource DeleteIconTemplate}" />
            <syncfusion:ButtonAdv Label="Close" IsCancel="True" IsDefault="True"
                                  IconTemplate="{StaticResource CancelIconTemplate}" />
        </StackPanel>
    </Grid>
</Grid>
</controls:ReactiveAppWindow>
