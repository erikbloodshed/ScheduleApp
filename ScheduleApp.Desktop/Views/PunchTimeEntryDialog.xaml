<ui:FluentWindow x:Class="ScheduleApp.Desktop.Views.PunchTimeEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
        Title="Add Manual Punch"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- See MainWindow.xaml's own TitleBar comment for why every FluentWindow needs
             one of these - WPF-UI removes the native title bar entirely otherwise. -->
        <ui:TitleBar Grid.Row="0"
                Title="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                ShowMinimize="False"
                ShowMaximize="False"
                CanMaximize="False" />

    <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Context header. Employee, date and slot all come from the cell that was
             right-clicked, so none of them are editable here. -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="ContextEmployeeText" FontWeight="SemiBold" />
                <TextBlock x:Name="ContextSlotText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                           Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="Time" Margin="0,0,0,4" />
        <controls:TimeInput x:Name="TimeBox" Grid.Row="2" Density="Compact" Margin="0,0,0,12" />

        <TextBlock Grid.Row="4" Text="Reason" Margin="0,0,0,4" />
        <TextBox x:Name="ReasonBox" Grid.Row="5" Margin="0,0,0,12"
                 ToolTip="Why this punch couldn't come from the device (optional) -- grayed-out shows the default; type over it for something specific." />

        <TextBlock Grid.Row="6" Text="Entered by" Margin="0,0,0,4" />
        <TextBox x:Name="EnteredByBox" Grid.Row="7" Margin="0,0,0,4" />

        <TextBlock x:Name="ErrorText" Grid.Row="8" Foreground="#DC2626" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,8,0,0" />

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Content="Add" Width="86" Margin="0,0,8,0"
                    IsDefault="True" Click="SaveButton_Click" />
            <Button Content="Cancel" Width="86" IsCancel="True" />
        </StackPanel>
    </Grid>
</Grid>
</ui:FluentWindow>
