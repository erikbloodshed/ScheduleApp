<controls:ReactiveAppWindow x:Class="ScheduleApp.Desktop.Views.PunchTimeEntryDialog" ShowMinimizeButton="False" ShowMaximizeButton="False"
        x:TypeArguments="attendance:PunchTimeEntryViewModel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
        xmlns:attendance="clr-namespace:ScheduleApp.Desktop.ViewModels.Attendance"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

    <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Context header. Employee, date and slot all come from the cell that was
             right-clicked, so none of them are editable here. -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="ContextEmployeeText" FontWeight="SemiBold" />
                <TextBlock x:Name="ContextSlotText" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12"
                           Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="Time" Margin="0,0,0,4" />
        <controls:TimeInput x:Name="TimeBox" Grid.Row="2" Margin="0,0,0,12" />

        <TextBlock Grid.Row="4" Text="Reason" Margin="0,0,0,4" />
        <syncfusion:SfTextBoxExt x:Name="ReasonBox" Grid.Row="5" Margin="0,0,0,12"
                 ToolTip="Why this punch couldn't come from the device (optional) -- grayed-out shows the default; type over it for something specific." />

        <TextBlock Grid.Row="6" Text="Entered by" Margin="0,0,0,4" />
        <syncfusion:SfTextBoxExt x:Name="EnteredByBox" Grid.Row="7" Margin="0,0,0,4" />

        <TextBlock x:Name="ErrorText" Grid.Row="8" Foreground="#DC2626" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,8,0,0" />

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <syncfusion:ButtonAdv x:Name="SaveButton" MinWidth="86" Margin="0,0,8,0"
                                  IconTemplate="{StaticResource ApplyIconTemplate}"
                                  IsDefault="True" />
            <syncfusion:ButtonAdv Label="Cancel" MinWidth="86" IsCancel="True"
                                  IconTemplate="{StaticResource CancelIconTemplate}" />
        </StackPanel>
    </Grid>
</Grid>
</controls:ReactiveAppWindow>
