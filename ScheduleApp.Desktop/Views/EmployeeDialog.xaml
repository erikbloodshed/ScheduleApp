<controls:AppWindow x:Class="ScheduleApp.Desktop.Views.EmployeeDialog" ShowMinimizeButton="False" ShowMaximizeButton="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
        xmlns:utilities="clr-namespace:ScheduleApp.Desktop.Utilities"
        Title="New Employee"
        Width="480"
        Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        utilities:WindowSizing.ConstrainToWorkArea="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SmallFieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
        </Style>
    </Window.Resources>

    <!-- DockPanel so OK/Cancel (docked Bottom) stay visible and reachable no matter how tall
         the form above them gets. A fixed Height on the Window (above) keeps the window itself
         at a size that fits comfortably even on a 768px-tall laptop screen.

         The form itself is in tabs (Info / Attendance / Payroll) rather than one long
         scrolling column - this dialog had grown to 26 rows in a single Grid before the split,
         past the point a person could see the fields they cared about without scrolling past
         everything else. Each tab wraps its own ScrollViewer so a short screen still has a
         scroll fallback per tab instead of a hard cutoff. Every field on every tab is filled
         synchronously from the constructor's arguments before the window is ever shown, so the
         first tab's selection has no async load to race. Code-behind looks fields up by name
         and doesn't care which tab contains them; QualifiesForRestDayPayCheck/
         RestDayWorkPremiumPercentageBox stay together, as do QualifiesForPremiumPayCheck/
         HolidayPremiumPercentageBox/PremiumPayFieldPanel, since each pair's Checked/Unchecked
         handler toggles the other's Visibility.

         The money boxes are CurrencyTextBoxes with no currency symbol, the hours boxes
         DoubleTextBoxes; both refuse a letter or a negative as it's typed. The boxes whose blank
         means "inherit the company default" (UseNullOption) show that default as their
         watermark - the code-behind sets it from the current settings. -->
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <syncfusion:ButtonAdv Label="OK"
                                  IconTemplate="{StaticResource ApplyIconTemplate}"
                                  SizeMode="Normal"
                                  Width="80"
                                  Margin="0,0,8,0"
                                  IsDefault="True"
                                  Click="OkButton_Click" />
            <syncfusion:ButtonAdv Label="Cancel"
                                  IconTemplate="{StaticResource CancelIconTemplate}"
                                  SizeMode="Normal"
                                  Width="80"
                                  IsCancel="True" />
        </StackPanel>

        <syncfusion:TabControlExt x:Name="EmployeeTabs"
                                  AllowDragDrop="False"
                                  EnableLabelEdit="False"
                                  CloseButtonType="Hide"
                                  ShowTabItemContextMenu="False"
                                  ShowTabListContextMenu="False">

            <syncfusion:TabItemExt Header="Info">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,12,16,12">

                        <TextBlock Text="Employee ID" Style="{StaticResource FieldLabel}" />
                        <syncfusion:IntegerTextBox x:Name="EmployeeIdBox"
                                                   UseNullOption="True"
                                                   NullValue="{x:Null}"
                                                   MinValue="0"
                                                   MaxValue="2147483647"
                                                   GroupSeperatorEnabled="False"
                                                   Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Last name" Grid.Row="0" Grid.Column="0" Margin="0,0,8,4" />
                            <TextBlock Text="First name" Grid.Row="0" Grid.Column="1" Margin="8,0,0,4" />
                            <syncfusion:SfTextBoxExt x:Name="LastNameBox" Grid.Row="1" Grid.Column="0" Margin="0,0,8,12" />
                            <syncfusion:SfTextBoxExt x:Name="FirstNameBox" Grid.Row="1" Grid.Column="1" Margin="8,0,0,12" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Department" Grid.Row="0" Grid.Column="0" Margin="0,0,8,4" />
                            <syncfusion:ComboBoxAdv x:Name="DepartmentCombo"
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    VerticalAlignment="Top"
                                                    DisplayMemberPath="Name"
                                                    Margin="0,0,8,0" />
                            <CheckBox Grid.Row="1"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      Margin="8,0,0,0"
                                      x:Name="UnassignedCheck"
                                      Checked="UnassignedCheck_CheckedChanged"
                                      Unchecked="UnassignedCheck_CheckedChanged">
                                <TextBlock Text="Unassigned" TextWrapping="Wrap" />
                            </CheckBox>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </syncfusion:TabItemExt>

            <syncfusion:TabItemExt Header="Attendance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,12,16,12">

                        <!-- Optional per-employee starting suggestion for ApplyScheduleDialog's
                             Work Time field - unlike the buffer defaults below, this isn't a
                             genuine runtime resolution tier (ScheduleEntry.WorkTimeHours is a
                             required, concrete value once a day is saved), it just pre-fills
                             what a brand-new entry starts showing, in place of Settings' own
                             company-wide default, whenever every employee selected for that
                             entry shares this same value. See Employee.DefaultWorkTimeHours. -->
                        <TextBlock Text="Default work time (hours)"
                                   Style="{StaticResource FieldLabel}"
                                   ToolTip="Pre-fills this employee's Work Time when scheduling, instead of the company default. Blank inherits the default." />
                        <syncfusion:DoubleTextBox x:Name="DefaultWorkTimeHoursBox"
                                                  UseNullOption="True"
                                                  NullValue="{x:Null}"
                                                  WatermarkTextIsVisible="True"
                                                  MinValue="0"
                                                  NumberDecimalDigits="2"
                                                  Width="80"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,0,0,12"
                                                  ToolTip="Blank inherits the company default." />

                        <!-- Optional per-employee defaults for the same four search-window
                             buffers AttendancePolicy exposes app-wide (see Settings' own
                             Clock-in/Clock-out buffer fields), sitting between a specific
                             ScheduleEntry's own per-day override and the policy default in
                             priority (see NormalBufferResolver). Left blank (the common
                             case), this employee just keeps inheriting the policy default.
                             Set here, this becomes the starting value ApplyScheduleDialog shows,
                             grayed out and still overridable for just one day there, whenever a
                             Normal (or Rest Day duty) day is scheduled for this employee. -->
                        <TextBlock x:Name="BufferDefaultsLabel"
                                   Text="Clock-in / clock-out buffer defaults (optional)"
                                   Style="{StaticResource FieldLabel}"
                                   TextWrapping="Wrap"
                                   ToolTip="This employee's default search-window buffers (hours) for a punch to count as clocking in/out. Blank inherits the Settings default; still overridable per day when scheduling." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="In before (h)" Style="{StaticResource SmallFieldLabel}" />
                                <syncfusion:DoubleTextBox x:Name="ClockInBufferBeforeHoursBox" Width="64" HorizontalAlignment="Left"
                                                          UseNullOption="True" NullValue="{x:Null}" MinValue="0" NumberDecimalDigits="2"
                                                          ToolTip="Blank inherits the policy default." />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="In after (h)" Style="{StaticResource SmallFieldLabel}" />
                                <syncfusion:DoubleTextBox x:Name="ClockInBufferAfterHoursBox" Width="64" HorizontalAlignment="Left"
                                                          UseNullOption="True" NullValue="{x:Null}" MinValue="0" NumberDecimalDigits="2"
                                                          ToolTip="Blank inherits the policy default." />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Out before (h)" Style="{StaticResource SmallFieldLabel}" />
                                <syncfusion:DoubleTextBox x:Name="ClockOutBufferBeforeHoursBox" Width="64" HorizontalAlignment="Left"
                                                          UseNullOption="True" NullValue="{x:Null}" MinValue="0" NumberDecimalDigits="2"
                                                          ToolTip="Blank inherits the policy default." />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Out after (h)" Style="{StaticResource SmallFieldLabel}" />
                                <syncfusion:DoubleTextBox x:Name="ClockOutBufferAfterHoursBox" Width="64" HorizontalAlignment="Left"
                                                          UseNullOption="True" NullValue="{x:Null}" MinValue="0" NumberDecimalDigits="2"
                                                          ToolTip="Blank inherits the policy default." />
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </syncfusion:TabItemExt>

            <syncfusion:TabItemExt Header="Payroll">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,12,16,12">

                        <CheckBox x:Name="QualifiesForOvertimeCheck"
                                  Content="Overtime Eligibility"
                                  IsChecked="True"
                                  Margin="0,0,0,8" />

                        <CheckBox x:Name="ApplyOvertimeRatePercentageByDefaultCheck"
                                  IsChecked="True"
                                  Margin="0,0,0,8"
                                  ToolTip="On (default): overtime pays hourly rate x (1 + overtime rate%). Off: straight hourly rate, no premium. Only applies if eligible for overtime; overridable per day.">
                            <TextBlock Text="Overtime Premium" TextWrapping="Wrap" />
                        </CheckBox>

                        <CheckBox x:Name="QualifiesForNightDiffCheck"
                                  Content="Night Differential Pay Eligibility"
                                  IsChecked="True"
                                  Margin="0,0,0,8" />

                        <CheckBox x:Name="ExemptFromUndertimeDeductionCheck"
                                  Margin="0,0,0,12"
                                  ToolTip="Checked: Undertime never reduces pay, and the line is left off the Payroll Summary/payslip entirely. Overtime still applies normally. Unchecked (default): Undertime deducts as usual.">
                            <TextBlock Text="Exempt from Undertime Deduction" TextWrapping="Wrap" />
                        </CheckBox>

                        <CheckBox x:Name="QualifiesForRestDayPayCheck"
                                  Content="Rest Day Pay Eligibility"
                                  Margin="0,0,0,8"
                                  Checked="QualifiesForRestDayPayCheck_CheckedChanged"
                                  Unchecked="QualifiesForRestDayPayCheck_CheckedChanged"
                                  ToolTip="Unchecked (default): can't be scheduled Rest Day duty; no Rest Day Pay line appears. Checked: opts them into both." />

                        <CheckBox x:Name="QualifiesForPremiumPayCheck"
                                  Content="Premium Pay Eligibility"
                                  Margin="0,0,0,12"
                                  Checked="QualifiesForPremiumPayCheck_CheckedChanged"
                                  Unchecked="QualifiesForPremiumPayCheck_CheckedChanged"
                                  ToolTip="Unchecked (default): no Premium Pay is seeded or shown each period. Checked: opts them into both." />

                        <CheckBox x:Name="DefaultLeaveIsPaidCheck"
                                  Content="Leave with pay by default"
                                  Margin="0,0,0,12"
                                  ToolTip="Default Paid/Unpaid choice when scheduling Leave -- still changeable per day. Unpaid unless turned on." />

                        <TextBlock Text="Pay Type" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="PayTypeDailyRadio"
                                         GroupName="PayType"
                                         Content="Daily"
                                         Margin="0,0,16,0"
                                         Checked="PayTypeRadio_CheckedChanged"
                                         ToolTip="Paid per completed/credited day, the same way every employee is paid today." />
                            <RadioButton x:Name="PayTypeMonthlyRadio"
                                         GroupName="PayType"
                                         Content="Monthly"
                                         Checked="PayTypeRadio_CheckedChanged"
                                         ToolTip="Paid a semi-monthly share of Monthly rate each period, minus uncredited (Absent/Partial) days." />
                        </StackPanel>

                        <TextBlock x:Name="RateLabel" Text="Daily rate" Style="{StaticResource FieldLabel}" />
                        <syncfusion:CurrencyTextBox x:Name="DailyRateBox"
                                                    CurrencySymbol=""
                                                    MinValue="0"
                                                    Margin="0,0,0,12"
                                                    Width="120"
                                                    HorizontalAlignment="Left"
                                                    ToolTip="Used for Basic Pay/Overtime/Night Diff/Undertime, and paid Leave. 0.00 is fine until you're ready to set it." />
                        <syncfusion:CurrencyTextBox x:Name="MonthlyRateBox"
                                                    CurrencySymbol=""
                                                    MinValue="0"
                                                    Margin="0,0,0,12"
                                                    Width="120"
                                                    HorizontalAlignment="Left"
                                                    Visibility="Collapsed"
                                                    ToolTip="Divided by a ~15-day (minus Rest Days) divisor into a per-day rate for Basic Pay. 0.00 is fine until you're ready to set it." />

                        <TextBlock x:Name="RestDayWorkPremiumPercentageLabel"
                                   Text="Rest Day Work Premium (blank = company default)"
                                   Style="{StaticResource FieldLabel}" />
                        <syncfusion:PercentTextBox x:Name="RestDayWorkPremiumPercentageBox"
                                                   UseNullOption="True"
                                                   NullValue="{x:Null}"
                                                   WatermarkTextIsVisible="True"
                                                   MinValue="0"
                                                   MaxValue="500"
                                                   Margin="0,0,0,12"
                                                   Width="120"
                                                   HorizontalAlignment="Left"
                                                   ToolTip="Overrides the company's Rest Day premium (first 8 hours; hours beyond earn +30% more). Blank uses the default (30%) -- 0% means no premium at all." />

                        <TextBlock x:Name="HolidayPremiumPercentageLabel"
                                   Text="Holiday Premium (blank = company default)"
                                   Style="{StaticResource FieldLabel}" />
                        <syncfusion:PercentTextBox x:Name="HolidayPremiumPercentageBox"
                                                   UseNullOption="True"
                                                   NullValue="{x:Null}"
                                                   WatermarkTextIsVisible="True"
                                                   MinValue="0"
                                                   MaxValue="500"
                                                   Margin="0,0,0,12"
                                                   Width="120"
                                                   HorizontalAlignment="Left"
                                                   ToolTip="Overrides the company's Holiday premium (100% = one extra day's pay). Only applies if Premium Pay Eligibility is checked; blank uses the default (100%)." />

                        <TextBlock Text="Statutory contributions (per payroll period)"
                                   Style="{StaticResource FieldLabel}"
                                   ToolTip="Pre-fills SSS/PhilHealth/Pag-IBIG on that period's first open -- still editable per period after. 0.00 to enter by hand instead." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="SSS" Style="{StaticResource FieldLabel}" />
                                <syncfusion:CurrencyTextBox x:Name="DefaultSssBox" Width="100" HorizontalAlignment="Left"
                                                            CurrencySymbol="" MinValue="0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="PhilHealth" Style="{StaticResource FieldLabel}" />
                                <syncfusion:CurrencyTextBox x:Name="DefaultPhilHealthBox" Width="100" HorizontalAlignment="Left"
                                                            CurrencySymbol="" MinValue="0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Pag-IBIG" Style="{StaticResource FieldLabel}" />
                                <syncfusion:CurrencyTextBox x:Name="DefaultPagIbigBox" Width="100" HorizontalAlignment="Left"
                                                            CurrencySymbol="" MinValue="0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Pay adjustments (per payroll period)"
                                   Style="{StaticResource FieldLabel}"
                                   ToolTip="Pre-fills Premium Pay/Allowance/Cash Advance on that period's first open -- still editable per period after. 0.00 to enter by hand instead." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <StackPanel x:Name="PremiumPayFieldPanel" Margin="0,0,12,0">
                                <TextBlock Text="Premium Pay" Style="{StaticResource FieldLabel}" />
                                <syncfusion:CurrencyTextBox x:Name="DefaultPremiumPayBox" Width="100" HorizontalAlignment="Left"
                                                            CurrencySymbol="" MinValue="0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Allowance" Style="{StaticResource FieldLabel}" />
                                <syncfusion:CurrencyTextBox x:Name="DefaultAllowanceBox" Width="100" HorizontalAlignment="Left"
                                                            CurrencySymbol="" MinValue="0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Cash Advance" Style="{StaticResource FieldLabel}" />
                                <syncfusion:CurrencyTextBox x:Name="DefaultCashAdvanceBox" Width="100" HorizontalAlignment="Left"
                                                            CurrencySymbol="" MinValue="0" />
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </syncfusion:TabItemExt>

        </syncfusion:TabControlExt>
    </DockPanel>
</controls:AppWindow>
