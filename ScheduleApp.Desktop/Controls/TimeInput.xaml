<UserControl x:Class="ScheduleApp.Desktop.Controls.TimeInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             Focusable="False">
    <!-- A masked time field: the hour, minute and AM/PM parts are each typed into or stepped
         with Up/Down, and the clock drop-down picks one with the mouse. Blank (NullValue) is a
         real state - "not filled in yet" - so it shows nothing rather than a placeholder time,
         as every DateTimeEdit does (Themes/ControlDefaults.xaml). TimeInput.xaml.cs keeps it in
         step with SelectedTime and sets its pattern. -->
    <syncfusion:DateTimeEdit x:Name="Editor"
                             DropDownView="Clock"
                             MinWidth="120"
                             IsVisibleRepeatButton="False"
                             DateTimeChanged="Editor_DateTimeChanged" />
</UserControl>
