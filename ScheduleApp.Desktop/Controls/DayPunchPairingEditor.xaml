<UserControl x:Class="ScheduleApp.Desktop.Controls.DayPunchPairingEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ScheduleApp.Desktop.ViewModels.Attendance"
             xmlns:conv="clr-namespace:ScheduleApp.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DayPunchPairingEditorViewModel}"
             d:DesignWidth="620"
             d:DesignHeight="560">
    <UserControl.Resources>
        <conv:PunchStatusToBrushConverter x:Key="StatusBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVisible" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisible" />
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisible" />

        <!-- The "missing punch" placeholder shown in an empty slot: the visible
             shape of a Partial day. Its tooltip invites the add gesture, so it is
             dropped in a read-only "View Punches…" open where there is none. The
             DataContext here is a DayPunchPairingRowViewModel, so IsReadOnly is
             reached via the editor UserControl. -->
        <Style x:Key="MissingPunchPlaceholderStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="missing punch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Double-click or right-click to add a manual punch." />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One punch card. The whole card is the drag handle; the slot Border
             that hosts it carries the mouse/drop handlers (see code-behind), so
             there's nothing draggable to wire up here. -->
        <DataTemplate x:Key="PunchCellTemplate" DataType="{x:Type vm:DayPunchPairingCellViewModel}">
            <Border x:Name="Card"
                    CornerRadius="6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="8,4"
                    ToolTip="{Binding ReasonText}"
                    ToolTipService.IsEnabled="{Binding IsManual}">
                <!-- Time and badges on one line rather than stacked: a punch card
                     carries very little, and a two-line card made every row (and so
                     the whole grid) about twice as tall as it needed to be. The
                     badges sit right of the time and centered against it, so the
                     card's height is just the time's own line. -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding TimeText}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               VerticalAlignment="Center" />
                    <!-- Source badge: a manual entry is always called out, so a
                         hand-typed time is never mistaken for a recorded one. -->
                    <Border x:Name="SourceBadge"
                            CornerRadius="3"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            Padding="5,1"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                        <TextBlock Text="{Binding SourceText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <TextBlock x:Name="UnpairedBadge"
                               Text="unpaired"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsManual}" Value="True">
                    <Setter TargetName="SourceBadge" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUnpaired}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="1.5" />
                    <Setter TargetName="UnpairedBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBeingDragged}" Value="True">
                    <Setter TargetName="Card" Property="Opacity" Value="0.35" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One segment = two slots. Each slot is a fixed drop target (present
             whether or not it holds a punch) so an empty slot can still receive a
             drag. Tag tells the code-behind which column the drop landed in; the
             Border's DataContext is this DayPunchPairingRowViewModel. -->
        <DataTemplate x:Key="PairingRowTemplate" DataType="{x:Type vm:DayPunchPairingRowViewModel}">
            <Grid ColumnDefinitions="Auto,Auto" Margin="0,0,0,6" HorizontalAlignment="Left">
                <Border x:Name="InSlot"
                        Grid.Column="0"
                        Tag="In"
                        Width="190"
                        MinHeight="40"
                        CornerRadius="8"
                        Background="Transparent"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1.5"
                        Padding="4"
                        AllowDrop="True"
                        PreviewMouseLeftButtonDown="Slot_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="Slot_PreviewMouseMove"
                        MouseRightButtonUp="Slot_MouseRightButtonUp"
                        DragEnter="Slot_DragEnter"
                        DragOver="Slot_DragOver"
                        DragLeave="Slot_DragLeave"
                        Drop="Slot_Drop">
                    <Grid>
                        <TextBlock Style="{StaticResource MissingPunchPlaceholderStyle}"
                                   Visibility="{Binding InPunch, Converter={StaticResource NullToVisible}}" />
                        <!-- Collapsed rather than left to render an empty card: a
                             ContentControl still applies its ContentTemplate when Content
                             is null, and that template's root Border is opaque. An
                             empty slot was drawing a blank white card (badge and all)
                             directly over the placeholder behind it. -->
                        <ContentControl Content="{Binding InPunch}"
                                        ContentTemplate="{StaticResource PunchCellTemplate}"
                                        Visibility="{Binding InPunch, Converter={StaticResource NotNullToVisible}}" />
                    </Grid>
                </Border>

                <Border x:Name="OutSlot"
                        Grid.Column="1"
                        Tag="Out"
                        Width="190"
                        Margin="12,0,0,0"
                        MinHeight="40"
                        CornerRadius="8"
                        Background="Transparent"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1.5"
                        Padding="4"
                        AllowDrop="True"
                        PreviewMouseLeftButtonDown="Slot_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="Slot_PreviewMouseMove"
                        MouseRightButtonUp="Slot_MouseRightButtonUp"
                        DragEnter="Slot_DragEnter"
                        DragOver="Slot_DragOver"
                        DragLeave="Slot_DragLeave"
                        Drop="Slot_Drop">
                    <Grid>
                        <TextBlock Style="{StaticResource MissingPunchPlaceholderStyle}"
                                   Visibility="{Binding OutPunch, Converter={StaticResource NullToVisible}}" />
                        <!-- Collapsed rather than left to render an empty card: a
                             ContentControl still applies its ContentTemplate when Content
                             is null, and that template's root Border is opaque. An
                             empty slot was drawing a blank white card (badge and all)
                             directly over the placeholder behind it. -->
                        <ContentControl Content="{Binding OutPunch}"
                                        ContentTemplate="{StaticResource PunchCellTemplate}"
                                        Visibility="{Binding OutPunch, Converter={StaticResource NotNullToVisible}}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="14" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- Who / when -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding EmployeeName}" FontWeight="Bold" FontSize="16" />
            <TextBlock Text="{Binding DateText}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Column headers, on the same two fixed tracks the rows use. -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto" Margin="0,0,0,6" HorizontalAlignment="Left">
            <TextBlock Grid.Column="0" Text="Time In" Width="190" TextAlignment="Center"
                       FontWeight="Bold" FontSize="13" />
            <TextBlock Grid.Column="1" Text="Time Out" Width="190" TextAlignment="Center" Margin="12,0,0,0"
                       FontWeight="Bold" FontSize="13" />
        </Grid>

        <!-- Every button here mutates the grid, so the whole strip is gone in a
             read-only "View Punches…" open (see DayPunchPairingEditorViewModel.IsReadOnly). -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource InverseBoolToVisible}}">
            <Button Content="Add Segment" Command="{Binding AddRowCommand}" Padding="10,4" />
            <Button Content="Remove Empty" Command="{Binding RemoveEmptySegmentsCommand}" Padding="10,4" Margin="8,0,0,0" />
            <Button Content="Undo" Command="{Binding UndoCommand}" Padding="10,4" Margin="8,0,0,0" />
            <TextBlock Text="Drag onto a slot to insert · double-click to add"
                       Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="14,0,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}"
                          ItemTemplate="{StaticResource PairingRowTemplate}" />
        </ScrollViewer>

        <!-- Live footer: what the Summary grid will say once this is saved. Shown
             only on a day whose pairing the calculation actually reads back (see
             DayPunchPairingEditorViewModel.PairingAffectsResult). On any other type
             these figures would be derived with Flexible rules the day isn't
             calculated by, so they'd quietly disagree with the Summary grid; those
             days get the punch count and a line saying why there's no verdict here
             instead. -->
        <Border Grid.Row="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12,9" Margin="0,10,0,0">
          <Grid>
            <StackPanel Visibility="{Binding PairingAffectsResult, Converter={StaticResource InverseBoolToVisible}}">
                <TextBlock Text="{Binding PunchCountText}" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="{Binding PairingNote}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                  Visibility="{Binding PairingAffectsResult, Converter={StaticResource BoolToVisible}}">
                <StackPanel Grid.Column="0" Margin="0,0,22,0">
                    <TextBlock Text="Worked" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding WorkedText}" FontWeight="SemiBold" FontSize="14"
                               FontFamily="Consolas, Segoe UI" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,22,0">
                    <TextBlock Text="Required" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding RequiredText}" FontWeight="SemiBold" FontSize="14"
                               FontFamily="Consolas, Segoe UI" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding RemainderLabel}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding RemainderText}" FontWeight="SemiBold" FontSize="14"
                               FontFamily="Consolas, Segoe UI" />
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                 Fill="{Binding PreviewStatus, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding PreviewStatusText}" Margin="7,0,0,0"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="{Binding PreviewStatus, Converter={StaticResource StatusBrush}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding UnpairedCount, StringFormat={}{0} punch still unpaired}"
                               FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"
                               Visibility="{Binding HasUnpairedPunches, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>
            </Grid>
          </Grid>
        </Border>
    </Grid>
</UserControl>
