<UserControl x:Class="ScheduleApp.Desktop.Controls.StatusBarPresenter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScheduleApp.Desktop.Controls"
             Height="28">
    <!-- Thin bar spanning the bottom of MainWindow. The notification itself lives
         right-aligned inside it (icon + title + message), matching where a
         notification balloon would sit - see ShowMessage/Clear in the code-behind.
         Collapsed (MessagePanel.Visibility) whenever nothing's currently shown, so
         the bar reads as empty rather than showing a stale message.

         ProgressPanel is the mirror-image piece on the opposite (left) side of the
         same bar - shown/hidden independently of MessagePanel via
         ShowProgress/ClearProgress in the code-behind, so a payroll-group compute
         (PayrollViewModel.PayrollGroupLoadPercent/IsPayrollGroupLoading) or the
         shared "something's running" flag every other page's own busy state
         reduces to (AttendanceBusyState.IsVisiblyRunning, via ShowProgress's
         indeterminate overload) and a right-aligned notification balloon can both
         be visible at once without fighting over the same spot or timer.
         PercentProgressBar itself no longer does anything Star-width-based - see
         that control's own doc comment. -->
    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
        <Grid>
            <StackPanel x:Name="ProgressPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        Visibility="Collapsed">
                <TextBlock x:Name="ProgressLabelRun"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Margin="0,0,8,0" />
                <controls:PercentProgressBar x:Name="ProgressBarControl"
                                              Width="140"
                                              VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="MessagePanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Visibility="Collapsed">
                <ContentControl x:Name="IconHost"
                                 Focusable="False"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0" />
                <TextBlock VerticalAlignment="Center" FontSize="12">
                    <Run x:Name="TitleRun" FontWeight="Bold" />
                    <Run x:Name="MessageRun" />
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
