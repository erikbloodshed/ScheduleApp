<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ScheduleApp.Desktop.Converters">

    <!--
      Shared resources for ScheduleApp.Desktop's own views/dialogs/controls - merged into
      Application.Resources by App.xaml, after Themes/Palette.xaml (the Catppuccin Latte colour
      scale) and Themes/Tokens.xaml (the design tokens named from it), so everything below can
      use the token brushes.

      Syncfusion controls are never styled here: they get the Windows11Light theme and the
      app's accent from SfSkinManager (see App.xaml.cs), and their sizes and defaults from
      Themes/ControlDefaults.xaml.
    -->

    <!-- The converters more than one view binds through; one used by a single view stays
         in that view's resources. -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
    <converters:PunchStatusToBrushConverter x:Key="StatusToBrush" />
    <converters:NumberConverter x:Key="Number" />

    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- A Segoe Fluent Icons glyph in a TextBlock - the replacement for WPF-UI's SymbolIcon. -->
    <Style x:Key="IconGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- ButtonAdv.IconTemplate glyphs, one per verb, reused across every screen's buttons
         instead of repeating the glyph markup on each one - the same set TinapayanRMS keeps
         in its App.xaml. Every ButtonAdv gets one, OK and Cancel included: one without shows
         Syncfusion's own placeholder image instead. -->
    <DataTemplate x:Key="AddIconTemplate">
        <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyphStyle}" />
    </DataTemplate>
    <DataTemplate x:Key="EditIconTemplate">
        <TextBlock Text="&#xE70F;" Style="{StaticResource IconGlyphStyle}" />
    </DataTemplate>
    <DataTemplate x:Key="DeleteIconTemplate">
        <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyphStyle}" />
    </DataTemplate>
    <DataTemplate x:Key="SaveIconTemplate">
        <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyphStyle}" />
    </DataTemplate>
    <!-- OK / confirm: CheckMark -->
    <DataTemplate x:Key="ApplyIconTemplate">
        <TextBlock Text="&#xE73E;" Style="{StaticResource IconGlyphStyle}" />
    </DataTemplate>
    <DataTemplate x:Key="CancelIconTemplate">
        <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyphStyle}" />
    </DataTemplate>
    <DataTemplate x:Key="SearchIconTemplate">
        <TextBlock Text="&#xE721;" Style="{StaticResource IconGlyphStyle}" />
    </DataTemplate>
    <DataTemplate x:Key="RefreshIconTemplate">
        <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyphStyle}" />
    </DataTemplate>
    <!-- A workbook read in: Upload, an arrow into the tray -->
    <DataTemplate x:Key="ImportIconTemplate">
        <TextBlock Text="&#xE8B5;" Style="{StaticResource IconGlyphStyle}" />
    </DataTemplate>
    <!-- A table to an Excel workbook: Export, an arrow leaving a box -->
    <DataTemplate x:Key="ExportIconTemplate">
        <TextBlock Text="&#xEDE1;" Style="{StaticResource IconGlyphStyle}" />
    </DataTemplate>
    <DataTemplate x:Key="PrintIconTemplate">
        <TextBlock Text="&#xE749;" Style="{StaticResource IconGlyphStyle}" />
    </DataTemplate>
    <!-- Blacklist / Unblacklist an employee: BlockContact / AddFriend -->
    <DataTemplate x:Key="BlacklistIconTemplate">
        <TextBlock Text="&#xE8F8;" Style="{StaticResource IconGlyphStyle}" />
    </DataTemplate>
    <DataTemplate x:Key="UnblacklistIconTemplate">
        <TextBlock Text="&#xE8FA;" Style="{StaticResource IconGlyphStyle}" />
    </DataTemplate>
    <!-- Uncheck everything: ClearSelection -->
    <DataTemplate x:Key="ClearSelectionIconTemplate">
        <TextBlock Text="&#xE8E6;" Style="{StaticResource IconGlyphStyle}" />
    </DataTemplate>
    <!-- Check everything: SelectAll -->
    <DataTemplate x:Key="SelectAllIconTemplate">
        <TextBlock Text="&#xE8B3;" Style="{StaticResource IconGlyphStyle}" />
    </DataTemplate>
    <DataTemplate x:Key="CalendarIconTemplate">
        <TextBlock Text="&#xE787;" Style="{StaticResource IconGlyphStyle}" />
    </DataTemplate>
    <DataTemplate x:Key="FolderIconTemplate">
        <TextBlock Text="&#xE838;" Style="{StaticResource IconGlyphStyle}" />
    </DataTemplate>
    <DataTemplate x:Key="SettingsIconTemplate">
        <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyphStyle}" />
    </DataTemplate>

    <!-- A ButtonAdv whose glyph changes with state, such as a header's Refresh that turns
         into Cancel while something runs: the glyph is the button's own Tag, so one template
         serves every such button (<ButtonAdv SizeMode="Small" Tag="{Binding SomeGlyph}"
         IconTemplate="{StaticResource TagGlyphIconTemplate}" />). -->
    <DataTemplate x:Key="TagGlyphIconTemplate">
        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}"
                   Style="{StaticResource IconGlyphStyle}" />
    </DataTemplate>

    <!-- The card a page groups things on: a toolbar or command strip, a status strip, a
         totals panel. Its bottom margin spaces it from whatever follows; a card that sits
         last, or alone, sets its own Margin. -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- The muted bold label in front of a group of controls on a card ("Period", "Show"). -->
    <Style x:Key="GroupLabelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Muted/caption text - the shared replacement for a one-off
         Foreground="#64748B"/"#94A3B8" TextBlock (section labels, helper text, secondary
         column values). -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- The bold label that opens a group of related fields ("Attendance policy",
         "Payslip"). Replaces a one-off FontWeight="SemiBold" TextBlock, which after the
         caption brush above is the most-repeated inline formatting in this app's XAML -
         some 19 files carry their own copy. SettingsDialog is the first tenant; the rest
         can move onto this key whenever they're next touched, rather than in one sweep. -->
    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- The wrapped explanatory paragraph under one of those headers - CaptionTextStyle
         plus the TextWrapping and bottom margin every such paragraph was setting inline
         anyway. BasedOn rather than a copy so the size/color stay defined in exactly one
         place; note that means 12px, where the older hand-rolled versions of this used
         11px. One point isn't worth a second style. -->
    <Style x:Key="SectionCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

</ResourceDictionary>
