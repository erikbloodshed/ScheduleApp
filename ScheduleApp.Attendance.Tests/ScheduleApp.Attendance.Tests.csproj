<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ScheduleApp.Attendance.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Test project, not something anyone else references - same reason
         ScheduleApp.Payroll.Tests references only its own target project.
         This one exercises RestDayShiftCalculationStrategy through the
         public AttendanceCalculator.CalculateShift entry point (the
         strategy classes themselves are internal), so it references
         ScheduleApp.Attendance, which pulls in ScheduleApp.Core and
         ScheduleApp.Data transitively (Attendance's own .csproj already
         depends on Data; unlike ScheduleApp.Payroll.Tests this project
         can't stay EF-Core-free). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Bump these if they don't resolve against your local NuGet feed -
         same caveat ScheduleApp.Payroll.Tests' own .csproj gives. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScheduleApp.Attendance\ScheduleApp.Attendance.csproj" />
  </ItemGroup>

</Project>
